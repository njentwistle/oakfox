---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Img from '../../components/Img.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('portfolio');
  return items.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const projectUrl = `https://oakfox.co.uk/portfolio/${item.id}`;
const projectSchema: Record<string, unknown> = {
  '@type': 'CreativeWork',
  '@id': `${projectUrl}#project`,
  name: item.data.title,
  headline: item.data.title,
  description: item.data.description,
  url: projectUrl,
  image: new URL(item.data.thumbnail, 'https://oakfox.co.uk').toString(),
  datePublished: item.data.date.toISOString(),
  inLanguage: 'en-GB',
  genre: item.data.category,
  keywords: item.data.tags.join(', '),
  creator: { '@id': 'https://oakfox.co.uk/#organization' },
  publisher: { '@id': 'https://oakfox.co.uk/#organization' },
};

if (item.data.client) {
  projectSchema.sourceOrganization = { '@type': 'Organization', name: item.data.client };
}

if (item.data.testimonial) {
  projectSchema.review = {
    '@type': 'Review',
    reviewBody: item.data.testimonial.quote,
    author: {
      '@type': 'Person',
      name: item.data.testimonial.author,
      ...(item.data.testimonial.role ? { jobTitle: item.data.testimonial.role } : {}),
    },
    itemReviewed: { '@id': `${projectUrl}#project` },
  };
}

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Work', item: 'https://oakfox.co.uk/portfolio' },
    { '@type': 'ListItem', position: 3, name: item.data.title, item: projectUrl },
  ],
};
---

<BaseLayout
  title={item.data.title}
  description={item.data.description}
  image={item.data.thumbnail}
  type="article"
  schema={[projectSchema, breadcrumbs]}
>
  <article class="pt-32 pb-24">
    <div class="max-w-4xl mx-auto px-6">
      <!-- Header -->
      <a href="/portfolio" class="text-forest text-sm font-medium hover:underline underline-offset-4 mb-8 inline-block">
        &larr; Back to Portfolio
      </a>
      <span class="text-xs font-medium text-forest uppercase tracking-widest block mb-3">
        {item.data.category}
      </span>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight">{item.data.title}</h1>
      <p class="mt-4 text-lg text-gray max-w-2xl">{item.data.description}</p>

      {item.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-6">
          {item.data.tags.map((tag: string) => (
            <span class="px-3 py-1 bg-forest/5 text-forest text-xs font-medium rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}

      {item.data.outcomes.length > 0 && (
        <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-stone pt-8">
          {item.data.outcomes.map((outcome: string) => (
            <div class="text-[14px] text-ink/75 leading-relaxed">
              <span class="block w-6 h-px bg-forest mb-3"></span>
              {outcome}
            </div>
          ))}
        </div>
      )}

      <!-- Featured image -->
      <div class="bg-forest/5 rounded-2xl mt-12 overflow-hidden">
        <Img src={item.data.thumbnail} alt={item.data.title} loading="eager" class="w-full h-auto rounded-2xl" />
      </div>

      <!-- Content -->
      <div class="prose prose-lg max-w-none mt-12
        prose-headings:font-bold prose-headings:tracking-tight
        prose-a:text-forest prose-a:underline-offset-4
        prose-img:rounded-2xl">
        <Content />
      </div>

      {item.data.testimonial && (
        <figure class="mt-16 md:mt-20 border-t border-stone pt-10">
          <p class="label text-forest mb-6">Client note</p>
          <blockquote class="headline text-xl md:text-2xl text-ink leading-snug">
            <span class="text-forest">&ldquo;</span>{item.data.testimonial.quote}<span class="text-forest">&rdquo;</span>
          </blockquote>
          <figcaption class="mt-6 text-[13px] text-ink/60">
            <span class="text-ink font-medium">{item.data.testimonial.author}</span>
            {item.data.testimonial.role && (
              <span class="text-ink/50"> · {item.data.testimonial.role}</span>
            )}
          </figcaption>
        </figure>
      )}
    </div>
  </article>

  <!-- Next project CTA -->
  <section class="bg-forest text-cream py-16">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold text-cream">Like this work?</h2>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="/portfolio" class="border border-cream text-cream px-6 py-2 font-medium rounded-full transition-all duration-300 hover:bg-cream hover:text-forest">
          View More Projects
        </a>
        <a href="/contact" class="bg-cream text-forest px-6 py-2 font-medium rounded-full transition-all duration-300 hover:bg-cream-dark">
          Start Your Project
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

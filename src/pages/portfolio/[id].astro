---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('portfolio');
  return items.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<BaseLayout title={item.data.title} description={item.data.description}>
  <article class="pt-32 pb-24">
    <div class="max-w-4xl mx-auto px-6">
      <!-- Header -->
      <a href="/portfolio" class="text-forest text-sm font-medium hover:underline underline-offset-4 mb-8 inline-block">
        &larr; Back to Portfolio
      </a>
      <span class="text-xs font-medium text-forest uppercase tracking-widest block mb-3">
        {item.data.category}
      </span>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight">{item.data.title}</h1>
      <p class="mt-4 text-lg text-gray max-w-2xl">{item.data.description}</p>

      {item.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-6">
          {item.data.tags.map((tag: string) => (
            <span class="px-3 py-1 bg-forest/5 text-forest text-xs font-medium rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}

      <!-- Featured image -->
      <div class="bg-forest/5 rounded-2xl mt-12 overflow-hidden">
        <img src={item.data.thumbnail} alt={item.data.title} class="w-full h-auto rounded-2xl" />
      </div>

      <!-- Content -->
      <div class="prose prose-lg max-w-none mt-12
        prose-headings:font-bold prose-headings:tracking-tight
        prose-a:text-forest prose-a:underline-offset-4
        prose-img:rounded-2xl">
        <Content />
      </div>
    </div>
  </article>

  <!-- Next project CTA -->
  <section class="bg-forest text-cream py-16">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold text-cream">Like this work?</h2>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="/portfolio" class="border border-cream text-cream px-6 py-2 font-medium rounded-full transition-all duration-300 hover:bg-cream hover:text-forest">
          View More Projects
        </a>
        <a href="/contact" class="bg-cream text-forest px-6 py-2 font-medium rounded-full transition-all duration-300 hover:bg-cream-dark">
          Start Your Project
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

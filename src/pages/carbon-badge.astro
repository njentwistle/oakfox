---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageUrl = 'https://oakfox.co.uk/carbon-badge';

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Website Carbon Audit',
      item: 'https://oakfox.co.uk/website-carbon-audit',
    },
    { '@type': 'ListItem', position: 3, name: 'Carbon Rating Badge', item: pageUrl },
  ],
};

const webPage = {
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: 'The OakFox Carbon Rating Badge',
  description:
    'A free embeddable badge for websites rated A+, A or B in the OakFox website carbon audit. Links to a live re-audit so the rating is always verifiable.',
  inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://oakfox.co.uk/#website' },
  about: { '@id': 'https://oakfox.co.uk/#organization' },
};

const faqs = [
  {
    q: 'Who can display the badge?',
    a: 'Any website that scores A+, A or B in the audit. It is free, there is no fee and no application — if your site earned the grade, the embed code appears with your results and you are welcome to use it.',
  },
  {
    q: 'What happens if my rating changes later?',
    a: 'The badge links to a live re-run of the audit rather than a saved result, so whatever a visitor sees when they click is measured fresh that moment. Nothing to keep updated on your side. If your site slips below B, we would ask you to take the badge down — but the link will show the honest grade either way, which is rather the point.',
  },
  {
    q: 'Can I recolour it or crop it to fit my design?',
    a: 'Please do not. A badge that has been edited stops being evidence of anything. There is a light and a dark version, in SVG and PNG, which covers almost every footer — if none of them work for your site, email us and we will look at it.',
  },
  {
    q: 'Does the link have to stay on it?',
    a: 'Yes. The badge makes a claim about a measurement, and the link is how a visitor checks that claim is true. A badge nobody can verify is just a graphic.',
  },
  {
    q: 'How heavy is the badge itself?',
    a: 'The SVG is 458 bytes over the wire. It would be a poor advert for lightweight web design if the badge were the heaviest thing in your footer.',
  },
  {
    q: 'Why does the badge not show my exact CO₂ figure?',
    a: 'Because it would go out of date the next time you edited a page, and you would have no way of knowing. The grade is stable enough to put in a file; the gram figure belongs on the live audit where it is re-measured on demand.',
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const variants = [
  { grade: 'A+', file: 'carbon-a-plus', label: 'A+ · under 0.040 g' },
  { grade: 'A', file: 'carbon-a', label: 'A · under 0.079 g' },
  { grade: 'B', file: 'carbon-b', label: 'B · under 0.145 g' },
];
---

<BaseLayout
  title="The Carbon Rating Badge | OakFox"
  description="A free embeddable badge for websites rated A+, A or B in the OakFox website carbon audit. 458 bytes, links to a live re-audit, and honest about what it measures."
  schema={[webPage, faqSchema, breadcrumbs]}
>
  <!-- ============ Hero ============ -->
  <section class="pt-32 pb-16 md:pt-40 md:pb-20">
    <div class="max-w-3xl mx-auto px-6">
      <span class="text-xs font-medium text-forest uppercase tracking-widest block mb-4">
        Carbon Rating Badge
      </span>
      <h1 class="headline text-4xl md:text-5xl lg:text-6xl text-ink leading-[1.05]">
        Proof you can put in your footer.
      </h1>
      <p class="mt-7 text-lg text-ink/75 leading-relaxed">
        If your website scores A+, A or B in our
        <a
          href="/website-carbon-audit/"
          class="text-forest underline underline-offset-4 hover:text-forest-dark transition-colors"
          >free carbon audit</a
        >, you have built something genuinely lighter than most of the web. This
        badge says so, and links to a live re-measurement so anyone can check.
      </p>
      <p class="mt-5 text-[15px] text-ink/65 leading-relaxed">
        It is free. There is no application, no fee, and nothing to sign. Run the
        audit and if you earned it, the embed code appears with your results.
      </p>
      <div class="mt-9">
        <a
          href="/website-carbon-audit/"
          class="inline-flex items-center gap-2 bg-forest text-cream hover:bg-forest-dark transition-colors duration-300 px-7 py-3.5 rounded-full text-[14px] font-medium"
        >
          Audit your site
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ The badges ============ -->
  <section class="py-16 md:py-20 border-t border-stone">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="headline text-2xl md:text-3xl text-ink">The three grades</h2>
      <p class="mt-4 text-[15px] text-ink/70 leading-relaxed max-w-2xl">
        Bands come from the Sustainable Web Design Model, as applied by
        <a
          href="https://www.thegreenwebfoundation.org/co2-js/"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4 hover:text-forest">co2.js</a
        >. Grams are CO₂e per page view. Below B there is no badge — we are not
        going to hand out a graphic for a middling result.
      </p>

      <div class="mt-10 space-y-4">
        {
          variants.map((v) => (
            <div
              class="flex flex-wrap items-center gap-x-8 gap-y-4 border border-stone rounded-2xl p-5 md:p-6"
            >
              <img
                src={`/badge/${v.file}.svg`}
                alt={`Carbon rating ${v.grade} badge, light style`}
                width="200"
                height="56"
                loading="lazy"
                decoding="async"
              />
              <div
                class="rounded-xl p-3"
                style="background:#1F2319"
              >
                <img
                  src={`/badge/${v.file}-dark.svg`}
                  alt={`Carbon rating ${v.grade} badge, dark style`}
                  width="200"
                  height="56"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <span class="text-[13px] text-ink/65">{v.label}</span>
            </div>
          ))
        }
      </div>

      <p class="mt-8 text-[13px] text-ink/60 leading-relaxed max-w-2xl">
        Each badge comes in SVG and PNG. Use the SVG unless your site builder
        refuses it — Wix and Squarespace both reject SVG uploads in places, which
        is the only reason the PNG exists.
      </p>
    </div>
  </section>

  <!-- ============ How it stays honest ============ -->
  <section class="py-16 md:py-20 border-t border-stone">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="headline text-2xl md:text-3xl text-ink">How it stays honest</h2>
      <div class="mt-8 space-y-7">
        <div class="flex gap-5">
          <span
            class="shrink-0 w-8 h-8 rounded-full bg-forest text-cream flex items-center justify-center text-[13px] font-medium"
            >1</span
          >
          <div>
            <h3 class="text-[16px] font-medium text-ink">The badge carries a grade, not a number</h3>
            <p class="mt-2 text-[15px] text-ink/70 leading-relaxed">
              A gram figure baked into an image file starts drifting the moment
              you add a photo to a page, and you would never know. The grade is
              stable enough to sit in a file for a year; the precise figure lives
              where it can be re-measured.
            </p>
          </div>
        </div>
        <div class="flex gap-5">
          <span
            class="shrink-0 w-8 h-8 rounded-full bg-forest text-cream flex items-center justify-center text-[13px] font-medium"
            >2</span
          >
          <div>
            <h3 class="text-[16px] font-medium text-ink">The link re-audits live</h3>
            <p class="mt-2 text-[15px] text-ink/70 leading-relaxed">
              Clicking the badge runs the audit again from scratch, against your
              site as it is at that moment — not against a result we cached when
              you first earned it. There is nothing for you to maintain, and
              nothing we can quietly leave stale.
            </p>
          </div>
        </div>
        <div class="flex gap-5">
          <span
            class="shrink-0 w-8 h-8 rounded-full bg-forest text-cream flex items-center justify-center text-[13px] font-medium"
            >3</span
          >
          <div>
            <h3 class="text-[16px] font-medium text-ink">
              If your site gets heavier, the audit says so
            </h3>
            <p class="mt-2 text-[15px] text-ink/70 leading-relaxed">
              We would ask you to take the badge down if you drop below B, but we
              are not policing footers. The safeguard is structural: anyone who
              clicks sees the real current grade regardless of which badge is
              sitting above it.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="py-16 md:py-20 border-t border-stone">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="headline text-2xl md:text-3xl text-ink">Questions</h2>
      <dl class="mt-8 divide-y divide-stone">
        {
          faqs.map((f) => (
            <div class="py-6 first:pt-0">
              <dt class="text-[16px] font-medium text-ink">{f.q}</dt>
              <dd class="mt-2.5 text-[15px] text-ink/70 leading-relaxed">{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="py-16 md:py-24 border-t border-stone">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="headline text-2xl md:text-3xl text-ink">Find out where you stand.</h2>
      <p class="mt-4 text-[15px] text-ink/70 leading-relaxed max-w-xl mx-auto">
        The audit takes about twenty seconds and needs nothing but your web
        address. If you are already at B or better, the embed code will be
        waiting at the bottom of your results.
      </p>
      <div class="mt-8">
        <a
          href="/website-carbon-audit/"
          class="inline-flex items-center gap-2 bg-forest text-cream hover:bg-forest-dark transition-colors duration-300 px-8 py-4 rounded-full text-[14px] font-medium"
        >
          Run the free audit
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

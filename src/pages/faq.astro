---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'What does OakFox do?',
    a: 'OakFox is a sustainable design studio based in West Lancashire. We offer <a href="/services/branding" class="text-forest underline underline-offset-4">branding</a>, <a href="/services/web-design" class="text-forest underline underline-offset-4">web design</a>, <a href="/services/development" class="text-forest underline underline-offset-4">web development</a>, <a href="/services/copywriting" class="text-forest underline underline-offset-4">copywriting</a>, <a href="/services/marketing" class="text-forest underline underline-offset-4">marketing</a>, and <a href="/services/green-web-hosting" class="text-forest underline underline-offset-4">green web hosting</a> — often in combination — for businesses that want to grow without the environmental cost. Dedicated ecology reporting and automation (PEA, BNG, SFI) is handled by our venture, <a href="https://ecoscribe.co.uk" class="text-forest underline underline-offset-4">EcoScribe</a>.',
  },
  {
    q: 'Where is OakFox based? Do you work with clients outside the UK?',
    a: "We're based in rural West Lancashire and registered as a company in England. Our studio is in <a href=\"/locations/burscough\" class=\"text-forest underline underline-offset-4\">Burscough</a>, between <a href=\"/locations/ormskirk\" class=\"text-forest underline underline-offset-4\">Ormskirk</a> and <a href=\"/locations/southport\" class=\"text-forest underline underline-offset-4\">Southport</a>. We work with clients across the UK, Ireland, and mainland Europe — see our <a href=\"/locations\" class=\"text-forest underline underline-offset-4\">locations page</a> for where we know the ground best. Most collaboration happens remotely, with occasional visits for brand discovery, shoots, or installations.",
  },
  {
    q: 'What does a typical OakFox project look like?',
    a: 'Most engagements start with a discovery conversation, followed by a proposal, a defined scope, and a phased delivery — usually over six to fourteen weeks depending on complexity. We take on a small number of projects each quarter so every client gets considered attention.',
  },
  {
    q: 'How much does it cost to work with OakFox?',
    a: "Every project is priced case-by-case. We work with a range of businesses — from independent start-ups to established brands — and shape each quote around what your project actually needs, rather than slotting you into a tier. We'll talk through specifics on a free initial call and send a detailed written quote before you commit to anything.",
  },
  {
    q: 'How long does a project take?',
    a: 'Most projects take six to fourteen weeks. A focused brand refresh can be faster; a full brand-plus-website build with multiple stakeholders takes longer. We set a realistic timeline during scoping and protect it with milestone reviews.',
  },
  {
    q: 'What makes OakFox "sustainable" — is it just greenwashing?',
    a: "Sustainability runs through every decision we make — from the client work we take on, to the hosting and code we deliver, to the supply chain advice we give. We consult on sourcing, packaging, and waste for client operations; specify efficient hosting and lightweight builds on web projects; and we're honest about the limits. A website alone isn't going to save the planet, but every considered choice compounds.",
  },
  {
    q: 'Do you only work with sustainable or ethical brands?',
    a: "No — but we reserve the right to decline projects we can't get behind. We'd rather help a business we believe in improve its impact than polish the image of one that won't change its practices.",
  },
  {
    q: 'Who will I actually work with day-to-day?',
    a: "Nathan James Entwistle, OakFox's founder, leads every project directly. We bring in trusted collaborators — photographers, illustrators, specialist developers — when the work calls for it, but your main point of contact stays consistent throughout.",
  },
  {
    q: 'Do you do ongoing work like marketing retainers?',
    a: 'Yes. After the initial delivery, many clients continue with us on monthly retainers for marketing, website upkeep, sustainability reporting, or creative support. Retainers are scoped to the hours and services you actually need, so they fit the rhythm of your business rather than a fixed package.',
  },
  {
    q: 'How do I start a project with you?',
    a: 'Send a note through our contact page with a few lines about your business and what you are hoping to do. We reply within 24 hours to set up a free initial call — no pitch, no obligation.',
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]*>/g, '');

const faqSchema = {
  '@type': 'FAQPage',
  '@id': 'https://oakfox.co.uk/faq#faq',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: stripHtml(item.a),
    },
  })),
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: 'https://oakfox.co.uk/faq' },
  ],
};
---

<BaseLayout
  title="FAQ — OakFox Sustainable Design Studio"
  description="Common questions about working with OakFox — pricing, timelines, sustainability credentials, retainers, and how to start a project with our West Lancashire studio."
  schema={[faqSchema, breadcrumbs]}
>
  <section class="pt-32 pb-16">
    <div class="max-w-3xl mx-auto px-6">
      <p class="label text-forest mb-6">Frequently asked</p>
      <h1 class="headline text-ink" style="font-size: clamp(2rem, 5vw, 3.5rem);">
        Questions we hear <em class="text-forest">most often</em>.
      </h1>
      <p class="mt-6 text-[15px] text-ink/65 leading-relaxed max-w-xl">
        If what you're looking for isn't here, send us a note — we reply within 24 hours.
      </p>
    </div>
  </section>

  <section class="pb-24">
    <div class="max-w-3xl mx-auto px-6">
      <dl class="border-t border-stone">
        {faqs.map((item) => (
          <div class="border-b border-stone py-8 md:py-10 reveal">
            <dt>
              <h2 class="headline text-xl md:text-2xl text-ink mb-4">
                {item.q}
              </h2>
            </dt>
            <dd class="text-[15px] text-ink/70 leading-relaxed" set:html={item.a}></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone relative overflow-hidden">
    <div class="hero-glow" style="top: 50%;"></div>
    <div class="max-w-3xl mx-auto px-6 relative z-10">
      <div class="reveal">
        <p class="label text-gray mb-6">Still curious?</p>
        <h2 class="headline text-2xl md:text-3xl">
          Let's talk it through.
        </h2>
        <a href="/contact" class="inline-flex items-center gap-3 mt-8 text-[13px] font-medium text-forest group">
          Start a conversation
          <span class="w-10 h-10 rounded-full border border-forest/30 flex items-center justify-center transition-all duration-500 group-hover:bg-forest group-hover:text-cream">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

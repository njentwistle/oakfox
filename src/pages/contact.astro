---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageUrl = 'https://oakfox.co.uk/contact';

const serviceOptions = [
  'Branding',
  'Web Design',
  'Development',
  'Hosting',
  'Copywriting',
  'Marketing',
  'Not sure yet',
];

const contactPage = {
  '@type': 'ContactPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: 'Contact OakFox — Sustainable Design Studio, West Lancashire',
  description:
    'Get in touch with OakFox for branding, web design, development, marketing, or environmental consultancy. Based in West Lancashire, UK. We reply within 24 hours.',
  inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://oakfox.co.uk/#website' },
  about: { '@id': 'https://oakfox.co.uk/#organization' },
};

const contactPoint = {
  '@type': 'ContactPoint',
  '@id': `${pageUrl}#contactpoint`,
  contactType: 'sales and enquiries',
  email: 'nathan@oakfox.co.uk',
  telephone: '+44 7730 396404',
  areaServed: ['GB', 'IE', 'EU'],
  availableLanguage: ['English'],
  hoursAvailable: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '17:30',
  },
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: pageUrl },
  ],
};
---

<BaseLayout
  title="Contact OakFox — Sustainable Design Studio, West Lancashire"
  description="Contact OakFox for branding, web design, development, marketing, or environmental consultancy. Based at Martland Mill, Burscough, West Lancashire. We reply within 24 hours."
  schema={[contactPage, contactPoint, breadcrumbs]}
>
  <section class="pt-32 pb-24">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="label text-forest mb-4">Contact</p>
        <h1 class="headline text-4xl md:text-5xl tracking-tight">
          Tell us what you're <em class="text-forest">building</em>.
        </h1>
        <p class="mt-6 text-gray leading-relaxed max-w-xl mx-auto">
          Tell us about your project — branding, web design, development, marketing,
          or environmental consultancy. We're a sustainable design studio in West
          Lancashire, UK, working with independent businesses and established
          brands across the UK, Ireland, and Europe. We reply within 24 hours.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/book" class="inline-flex items-center gap-2 bg-forest text-cream text-sm font-medium px-5 py-2.5 rounded-full hover:bg-forest-dark transition-colors">
            Book a free call
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="#contact-form" class="inline-flex items-center gap-2 border border-stone text-ink text-sm font-medium px-5 py-2.5 rounded-full hover:border-forest hover:text-forest transition-colors">
            Send a message
          </a>
        </div>
      </div>

      <form id="contact-form" class="space-y-8">
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-sm font-medium mb-2">Your name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 rounded-xl border border-gray-light bg-white text-black focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest transition-all"
              placeholder="Jane Cole"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium mb-2">Your email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 rounded-xl border border-gray-light bg-white text-black focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest transition-all"
              placeholder="john@example.com"
            />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium mb-3">How can we help?</label>
          <div class="flex flex-wrap gap-2" id="service-pills">
            {serviceOptions.map((service) => (
              <label class="service-pill">
                <input type="checkbox" name="services[]" value={service} class="sr-only" />
                <span class="pill-label">{service}</span>
              </label>
            ))}
          </div>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium mb-2">
            Message <span class="text-ink/40 font-normal">(optional)</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            class="w-full px-4 py-3 rounded-xl border border-gray-light bg-white text-black focus:outline-none focus:ring-2 focus:ring-forest/30 focus:border-forest transition-all resize-none"
            placeholder="A few lines about your project — or just say hello and we'll take it from there."
          ></textarea>
        </div>

        <div id="form-status" class="text-center text-sm font-medium" style="min-height: 24px;"></div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-forest text-cream px-8 py-3 font-medium rounded-full transition-all duration-300 hover:bg-forest-dark hover:scale-[1.02]"
        >
          Send my message
        </button>
        <p class="text-center text-[13px] text-ink/50">
          No obligation — we reply within 24 hours.
        </p>
      </form>

      <div class="mt-16 pt-10 border-t border-stone grid sm:grid-cols-3 gap-8">
        <div>
          <p class="label text-gray mb-3">Call us</p>
          <a href="tel:+447730396404" class="text-[15px] text-ink hover:text-forest transition-colors duration-300">
            07730 396404
          </a>
        </div>
        <div>
          <p class="label text-gray mb-3">Email</p>
          <a href="mailto:nathan@oakfox.co.uk" class="text-[15px] text-ink hover:text-forest transition-colors duration-300">
            nathan@oakfox.co.uk
          </a>
        </div>
        <div>
          <p class="label text-gray mb-3">Studio</p>
          <address class="not-italic text-[15px] text-ink/70 leading-relaxed">
            Martland Mill, Mart Ln<br />
            Burscough, Ormskirk<br />
            L40 0SD
          </address>
        </div>
      </div>
    </div>
  </section>

  <style>
    .service-pill {
      cursor: pointer;
      display: inline-block;
    }

    .pill-label {
      display: inline-block;
      padding: 8px 20px;
      border-radius: 9999px;
      font-size: 14px;
      font-weight: 500;
      border: 1.5px solid #D6D1C8;
      color: #2E3329;
      background: transparent;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      user-select: none;
    }

    .pill-label:hover {
      border-color: #1A5C12;
      color: #1A5C12;
    }

    .service-pill input:checked + .pill-label {
      background: #1A5C12;
      border-color: #1A5C12;
      color: #F5F0E8;
      box-shadow: 0 0 12px rgba(26, 92, 18, 0.2);
    }
  </style>

  <script>
    const serviceSlugToPill: Record<string, string> = {
      branding: 'Branding',
      design: 'Web Design',
      'web-design': 'Web Design',
      development: 'Development',
      dev: 'Development',
      hosting: 'Hosting',
      'green-web-hosting': 'Hosting',
      'web-hosting': 'Hosting',
      copywriting: 'Copywriting',
      copy: 'Copywriting',
      marketing: 'Marketing',
    };

    const hostingPlanCopy: Record<string, { message: string }> = {
      'hosting-starter': {
        message:
          "Hi — I'd like to move to the Hosting Starter plan.\n\nMy current site: \nCurrently hosted at: \nAny specific dates or constraints for the move: ",
      },
      'hosting-growth': {
        message:
          "Hi — I'd like to move to the Hosting Growth plan.\n\nMy current site(s): \nCurrently hosted at: \nNumber of sites to migrate: \nAny specific dates or constraints for the move: ",
      },
      'hosting-business': {
        message:
          "Hi — I'd like to discuss the Hosting Business plan.\n\nMy current site(s): \nCurrently hosted at: \nApprox monthly traffic: \nNumber of sites to migrate: \nAny specific dates or constraints for the move: ",
      },
    };

    function tickPillByLabel(label: string) {
      const pills = document.querySelectorAll<HTMLInputElement>('input[name="services[]"]');
      for (const pill of pills) {
        if (pill.value.toLowerCase() === label.toLowerCase()) {
          pill.checked = true;
          return true;
        }
      }
      return false;
    }

    function applyQueryParamsToForm() {
      const params = new URLSearchParams(window.location.search);
      const message = document.getElementById('message') as HTMLTextAreaElement | null;

      const service = params.get('service');
      if (service) {
        const pillLabel = serviceSlugToPill[service.toLowerCase()];
        if (pillLabel) tickPillByLabel(pillLabel);
      }

      const plan = params.get('plan');
      if (plan && hostingPlanCopy[plan]) {
        tickPillByLabel('Hosting');
        if (message && !message.value) {
          message.value = hostingPlanCopy[plan].message;
        }
      }
    }

    function initContactForm() {
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      if (!form) return;
      const status = document.getElementById('form-status');
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
      if (!status || !submitBtn) return;

      applyQueryParamsToForm();

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        status.textContent = '';
        status.style.color = '';
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';

        const formData = new FormData(form);
        const adKeys = ['gclid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
        for (const key of adKeys) {
          const val = sessionStorage.getItem('oakfox_' + key);
          if (val) formData.set(key, val);
        }

        try {
          const res = await fetch('/api/contact.php', {
            method: 'POST',
            body: formData,
          });

          const data = await res.json();

          if (res.ok && data.success) {
            status.style.color = '#1A5C12';
            status.textContent = "Message sent! We'll be in touch soon.";
            if (window.gtag && window.__awConversionIds?.contact) {
              window.gtag('event', 'conversion', {
                send_to: window.__awConversionIds.contact,
              });
            }
            form.reset();
          } else {
            status.style.color = '#b44d4d';
            status.textContent = data.error || 'Something went wrong. Please try again.';
          }
        } catch {
          status.style.color = '#b44d4d';
          status.textContent = 'Network error. Please email nathan@oakfox.co.uk directly.';
        }

        submitBtn.disabled = false;
        submitBtn.textContent = 'Send my message';
      });
    }

    document.addEventListener('astro:page-load', initContactForm);
  </script>
</BaseLayout>

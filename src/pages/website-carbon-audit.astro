---
import BaseLayout from '../layouts/BaseLayout.astro';
import JournalLinks from '../components/JournalLinks.astro';

const pageUrl = 'https://oakfox.co.uk/website-carbon-audit';

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Website Carbon Audit', item: pageUrl },
  ],
};

const webApplication = {
  '@type': 'WebApplication',
  '@id': `${pageUrl}#webapp`,
  name: 'Free Website Carbon Audit',
  url: pageUrl,
  description:
    'Free website sustainability checker. Enter a URL and get an instant carbon audit — CO₂ per page view, page weight, a green hosting check, and an A+ to F grade based on the Sustainable Web Design Model.',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
  provider: { '@id': 'https://oakfox.co.uk/#organization' },
  featureList: [
    'CO₂e per page view estimate (Sustainable Web Design Model)',
    'A+ to F digital carbon rating',
    'Page weight / data transfer measurement',
    'Green hosting verification against The Green Web Foundation directory',
    'Comparison against the median web page',
  ],
};

// Sustainable Web Design digital carbon ratings — grams CO2e per visit, as
// applied by co2.js perVisit. Bands mirror the published percentiles of pages
// tested worldwide.
const gradeBands = [
  { grade: 'A+', limit: '0.040 g', meaning: 'The top 5% of pages tested worldwide. Genuinely exceptional.' },
  { grade: 'A', limit: '0.079 g', meaning: 'Top 10%. A lean, well-built page.' },
  { grade: 'B', limit: '0.145 g', meaning: 'Top 20%. Lighter than most of the web.' },
  { grade: 'C', limit: '0.209 g', meaning: 'Top 30%. Middling, usually with easy wins available.' },
  { grade: 'D', limit: '0.278 g', meaning: 'Top 40%. Heavier than it needs to be.' },
  { grade: 'E', limit: '0.359 g', meaning: 'Around the median. Half the web does better.' },
  { grade: 'F', limit: 'over 0.359 g', meaning: 'Heavier than the median page. There is real work to do.' },
];

const checks = [
  {
    label: 'Transfer',
    title: 'Page weight',
    description:
      'Every byte your page ships has to be stored, transmitted, and rendered, and each step draws electricity. We measure how much data one visit to your homepage actually transfers, the single biggest factor in its footprint.',
  },
  {
    label: 'Carbon',
    title: 'CO₂ per visit',
    description:
      'Using the Sustainable Web Design Model, the peer-reviewed standard behind most digital carbon tools, that transfer converts into an estimate of grams of CO₂e emitted per page view, and an A+ to F rating.',
  },
  {
    label: 'Hosting',
    title: 'Green hosting check',
    description:
      'We check your domain against The Green Web Foundation\'s verified directory to see whether your site runs on renewable-powered infrastructure, or whether the greenest fix available is simply moving host.',
  },
];

const improvements = [
  {
    title: 'Compress and right-size your images',
    body: 'Images are the heaviest thing on most pages. Modern formats (WebP, AVIF), sensible dimensions, and lazy loading routinely cut page weight by half or more without any visible difference.',
    link: { href: '/services/development', label: 'How we build lean sites' },
  },
  {
    title: 'Ship less JavaScript',
    body: 'Trackers, chat widgets, embedded fonts, and framework bloat all cost carbon on every single visit. Static-first builds strip most of it out; this page you are reading ships almost none.',
    link: { href: '/services/development', label: 'Static-first development' },
  },
  {
    title: 'Move to verified green hosting',
    body: 'The same site on renewable-powered infrastructure emits meaningfully less per visit, and it is usually the easiest change on this list. We migrate sites free on every hosting plan.',
    link: { href: '/services/green-web-hosting', label: 'Managed green hosting from £9/month' },
  },
  {
    title: 'Design pages that say more with less',
    body: 'Auto-playing video backgrounds, carousels nobody swipes, five font families. A considered design brief is a sustainability decision. Leaner pages convert better too.',
    link: { href: '/services/web-design', label: 'Considered web design' },
  },
];

const faqs = [
  {
    q: 'What does the website carbon audit measure?',
    a: 'The audit measures three things: how much data one visit to your page transfers (page weight), an estimate of the CO₂e emitted per page view calculated with the Sustainable Web Design Model, and whether your site runs on verified green hosting according to The Green Web Foundation\'s directory. You get an A+ to F digital carbon rating and a comparison against the other pages tested worldwide.',
  },
  {
    q: 'How accurate is the carbon estimate?',
    a: 'It is a modelled estimate, not a meter reading. No carbon tool can measure your exact emissions. The Sustainable Web Design Model is the most widely used methodology in the field: it combines data transfer with published figures for data centre, network, and device energy, and global grid carbon intensity. It is accurate enough to compare sites fairly and to track whether changes you make are working.',
  },
  {
    q: 'What is a good website carbon grade?',
    a: 'A or A+ means your page is in the top 10% of pages tested worldwide, under roughly 0.08 grams of CO₂e per visit. The median web page emits around 0.36 grams per visit, which rates an E. Anything at C or below usually has straightforward fixes available: oversized images, unused JavaScript, or fossil-fuelled hosting.',
  },
  {
    q: 'Is this audit really free?',
    a: 'Yes, completely. No signup, no email gate, no trial. Run as many URLs as you like. OakFox is a sustainable web studio; if your grade is poor we would obviously love to help fix it, but the tool itself asks nothing of you.',
  },
  {
    q: 'How do I reduce my website\'s carbon footprint?',
    a: 'In rough order of impact: compress and resize images (the biggest win on most sites), remove unnecessary JavaScript and third-party scripts, use system fonts or subset web fonts, switch to verified green hosting, enable caching and a CDN, and design pages with less on them. Most sites can halve their per-view emissions with a focused day of work.',
  },
  {
    q: 'Does a greener website load faster and rank better?',
    a: 'Almost always. The same things that cut carbon (smaller pages, less JavaScript, efficient images) are exactly what makes a site fast, and speed feeds directly into Core Web Vitals, which Google uses as a ranking signal. Lower bounce rates and better conversion follow. Green performance and commercial performance are the same work.',
  },
  {
    q: 'How do I know if my web hosting is green?',
    a: 'Check your domain against The Green Web Foundation\'s verified directory, which is exactly what this audit does. Verified green hosts have provided evidence that their infrastructure runs on renewable energy. Be wary of hosts that only claim "carbon neutrality" through offsets; that is not the same thing as running on renewables.',
  },
  {
    q: 'Why can\'t the audit reach my website?',
    a: 'Some security firewalls and website security plugins block every automated visitor, including our crawler. When that happens the audit automatically retries the measurement through Google Lighthouse, which almost every site allows. If both routes are blocked, send us the URL and we\'ll run the audit by hand. An over-aggressive firewall is worth knowing about anyway.',
  },
  {
    q: 'How is this different from the Website Carbon Calculator?',
    a: 'Same underlying science, independent measurement. We run our own crawler against your page, estimate emissions with co2.js, the open-source implementation of the Sustainable Web Design Model maintained by The Green Web Foundation, and check your hosting against the same foundation\'s verified directory, all in one pass. Then we add a plain-English verdict and practical next steps. And because OakFox is a working design and development studio, the advice comes from people who fix these problems for a living.',
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const journalPosts = [
  {
    href: '/blog/sustainable-web-design-practical-guide',
    title: 'Sustainable Web Design: A Practical Guide',
    note: 'How to design and build low-carbon, accessible websites. The long version of the advice on this page.',
  },
  {
    href: '/blog/is-your-web-host-actually-green',
    title: 'Is Your Web Host Actually Green?',
    note: 'Offsets versus renewables, and how to verify a hosting claim instead of taking it on faith.',
  },
  {
    href: '/blog/green-web-hosting-uk-compared',
    title: 'Green Web Hosting in the UK, Compared',
    note: 'The main UK green hosts side by side. If your audit flagged your hosting, start here.',
  },
];
---

<BaseLayout
  title="Free Website Carbon Audit — Check How Green Your Website Is"
  description="Free website carbon audit. Check your site's CO₂ footprint, page weight, and green hosting in seconds — instant A+ to F grade, no signup. From OakFox."
  schema={[webApplication, breadcrumbs, faqSchema]}
>
  <!-- ============ Hero + tool ============ -->
  <section class="relative pt-32 pb-16 md:pb-20 overflow-hidden">
    <div class="hero-glow" style="top: 40%;"></div>
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <h1 class="headline text-ink max-w-4xl" style="font-size: clamp(2rem, 5.5vw, 4.5rem);">
        How <em class="text-forest">green</em> is your website?
      </h1>
      <div class="mt-8 md:mt-10 grid md:grid-cols-12 gap-8">
        <p class="md:col-span-6 text-[15px] md:text-base text-ink/65 leading-relaxed max-w-[65ch]">
          Enter your URL and get an instant environmental audit, covering CO₂ per
          visit, page weight, a verified green hosting check, and an A+ to F
          grade. Free, no signup, no email gate, no catch.
        </p>
      </div>

      <!-- The tool -->
      <div class="mt-10 md:mt-14 max-w-2xl">
        <form id="audit-form" class="flex flex-col sm:flex-row gap-3" novalidate>
          <label for="audit-url" class="sr-only">Your website address</label>
          <input
            id="audit-url"
            name="url"
            type="text"
            inputmode="url"
            autocomplete="url"
            spellcheck="false"
            placeholder="yourwebsite.co.uk"
            required
            class="flex-1 bg-white border border-stone rounded-full px-6 py-4 text-[15px] text-ink placeholder:text-gray focus:outline-none focus:border-forest transition-colors duration-300"
          />
          <button
            id="audit-submit"
            type="submit"
            class="inline-flex items-center justify-center gap-2 bg-forest text-cream hover:bg-forest-dark transition-colors duration-300 px-8 py-4 rounded-full text-[14px] font-medium whitespace-nowrap"
          >
            Audit my site
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </form>
        <p id="audit-status" class="mt-5 text-[14px] text-ink/65 leading-relaxed min-h-[1.5rem]" role="status" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <!-- ============ Results ============ -->
  <section id="audit-result" class="pb-20 md:pb-28 hidden" aria-live="polite">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="border border-stone rounded-2xl bg-white/60 p-8 md:p-12 relative overflow-hidden">
        <div id="confetti-host" class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true"></div>

        <div class="grid md:grid-cols-12 gap-10 md:gap-14 items-start relative z-10">
          <!-- Grade badge -->
          <div class="md:col-span-3 flex flex-col items-center md:items-start">
            <div id="grade-badge" class="w-36 h-36 md:w-44 md:h-44 rounded-full flex items-center justify-center bg-forest">
              <span id="grade-letter" class="headline text-cream" style="font-size: clamp(3.5rem, 5vw, 5rem);">–</span>
            </div>
            <p class="mt-5 text-[12px] font-mono uppercase tracking-widest text-gray text-center md:text-left">
              Digital carbon rating
            </p>
          </div>

          <!-- Verdict + stats -->
          <div class="md:col-span-9">
            <p class="label text-gray mb-3">Results for <span id="result-url" class="text-ink/80 normal-case tracking-normal font-sans"></span></p>
            <h2 id="verdict-title" class="headline text-2xl md:text-4xl text-ink"></h2>
            <p id="verdict-copy" class="mt-4 text-[15px] text-ink/65 leading-relaxed max-w-2xl"></p>

            <dl class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-6">
              <div class="border-t border-stone pt-4">
                <dt class="text-[11px] font-mono uppercase tracking-widest text-gray mb-2">CO₂ per visit</dt>
                <dd id="stat-co2" class="text-xl md:text-2xl font-semibold text-ink">–</dd>
              </div>
              <div class="border-t border-stone pt-4">
                <dt class="text-[11px] font-mono uppercase tracking-widest text-gray mb-2">Page weight</dt>
                <dd id="stat-weight" class="text-xl md:text-2xl font-semibold text-ink">–</dd>
              </div>
              <div class="border-t border-stone pt-4">
                <dt class="text-[11px] font-mono uppercase tracking-widest text-gray mb-2">Cleaner than</dt>
                <dd id="stat-cleaner" class="text-xl md:text-2xl font-semibold text-ink">–</dd>
              </div>
              <div class="border-t border-stone pt-4">
                <dt class="text-[11px] font-mono uppercase tracking-widest text-gray mb-2">Hosting</dt>
                <dd id="stat-hosting" class="text-xl md:text-2xl font-semibold text-ink">–</dd>
              </div>
            </dl>
            <p id="stat-hosting-detail" class="mt-3 text-[13px] text-ink/65 leading-relaxed"></p>
            <p id="equiv-line" class="mt-5 text-[14px] text-ink/65 leading-relaxed border-l-2 border-forest/40 pl-4"></p>
            <p id="cache-note" class="mt-4 text-[12px] text-ink/65 leading-relaxed hidden">
              Showing a saved result from the last hour.
              <button type="button" id="fresh-btn" class="text-forest underline underline-offset-4 hover:text-forest-dark transition-colors duration-300">Re-run a fresh audit</button>
              Handy if you've just made changes.
            </p>
            <p id="lighthouse-note" class="mt-4 text-[12px] text-ink/65 leading-relaxed hidden">
              This site's firewall blocks direct checks, so page weight was
              measured by Google Lighthouse instead. The same carbon model is
              applied to Google's numbers.
            </p>

            <!-- CTA: needs work -->
            <div id="cta-improve" class="mt-10 hidden">
              <div class="flex flex-wrap items-center gap-4">
                <a
                  id="cta-improve-link"
                  href="/contact?service=carbon-audit"
                  class="inline-flex items-center gap-2 bg-forest text-cream hover:bg-forest-dark transition-colors duration-300 px-7 py-3.5 rounded-full text-[14px] font-medium"
                >
                  Get a free improvement plan
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
                <a
                  id="cta-hosting-link"
                  href="/services/green-web-hosting"
                  class="hidden items-center gap-2 border border-forest/30 text-forest hover:bg-forest hover:text-cream transition-colors duration-300 px-7 py-3.5 rounded-full text-[14px] font-medium"
                >
                  Switch to green hosting, free migration
                </a>
              </div>
              <p class="mt-4 text-[13px] text-ink/65 leading-relaxed max-w-xl">
                Tell us your URL and we will reply within 24 hours with the three
                changes that would move your grade the most. No charge, no
                obligation, and you are free to make them yourself.
              </p>
            </div>

            <!-- CTA: celebration -->
            <div id="cta-celebrate" class="mt-10 hidden">
              <p class="text-[15px] text-ink/75 leading-relaxed max-w-xl">
                🎉 Genuinely brilliant. A low-carbon page on verified green
                hosting puts this site in rare company. Most of the web never
                gets close. Whoever built and hosts it deserves a biscuit.
              </p>
              <div class="mt-6 flex flex-wrap items-center gap-4">
                <button
                  id="share-btn"
                  type="button"
                  class="inline-flex items-center gap-2 bg-forest text-cream hover:bg-forest-dark transition-colors duration-300 px-7 py-3.5 rounded-full text-[14px] font-medium"
                >
                  Copy link to these results
                </button>
                <a
                  href="/contact"
                  class="inline-flex items-center gap-2 border border-forest/30 text-forest hover:bg-forest hover:text-cream transition-colors duration-300 px-7 py-3.5 rounded-full text-[14px] font-medium"
                >
                  Talk to a studio that speaks your language
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <p class="mt-6 text-[12px] text-ink/65 leading-relaxed max-w-3xl">
        Page weight is measured by OakFox's own crawler: your page plus the
        assets an initial view loads (lazy-loaded media excluded); real-browser
        weight can be slightly higher where scripts inject extra content. Carbon is estimated with
        <a href="https://www.thegreenwebfoundation.org/co2-js/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-forest">co2.js</a>
        and the Sustainable Web Design Model · hosting verified against
        <a href="https://www.thegreenwebfoundation.org" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-forest">The Green Web Foundation</a>'s
        directory. Results are modelled estimates for comparison, not meter readings.
      </p>
    </div>
  </section>

  <!-- ============ What we check ============ -->
  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <p class="label text-gray mb-10 md:mb-14">What the audit checks</p>
      <div class="grid md:grid-cols-3 gap-8 md:gap-12">
        {checks.map((c) => (
          <div class="reveal">
            <p class="label text-forest mb-4">{c.label}</p>
            <h2 class="headline text-xl md:text-2xl mb-4">{c.title}</h2>
            <p class="text-[14px] text-ink/65 leading-relaxed max-w-[65ch]">{c.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Grade bands ============ -->
  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10 md:gap-16">
        <div class="md:col-span-4">
          <h2 class="headline text-2xl md:text-3xl">
            What an A+ actually means.
          </h2>
          <p class="mt-6 text-[14px] text-ink/65 leading-relaxed max-w-[65ch]">
            Grades follow the Sustainable Web Design digital carbon ratings: grams of CO₂e per visit, banded against every page tested
            worldwide. The median page emits roughly 0.36&nbsp;g per visit,
            which rates an&nbsp;E.
          </p>
        </div>
        <div class="md:col-span-7 md:col-start-6">
          <dl class="border-t border-stone">
            {gradeBands.map((band) => (
              <div class="reveal border-b border-stone py-4 grid grid-cols-[3rem_7rem_1fr] md:grid-cols-[3.5rem_9rem_1fr] gap-4 items-baseline">
                <dt class="headline text-xl md:text-2xl text-forest">{band.grade}</dt>
                <dd class="text-[13px] font-mono text-ink/65">{band.grade === 'F' ? band.limit : `≤ ${band.limit}`}</dd>
                <dd class="text-[14px] text-ink/65 leading-relaxed max-w-[65ch]">{band.meaning}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Why it matters ============ -->
  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10 md:gap-16">
        <div class="md:col-span-4">
          <h2 class="headline text-2xl md:text-3xl">
            A lighter site is a better business, not just a greener one.
          </h2>
        </div>
        <ol class="md:col-span-7 md:col-start-6 border-t border-stone">
          <li class="reveal border-b border-stone py-6">
            <h3 class="text-base md:text-lg font-medium text-ink mb-3">The internet runs on electricity</h3>
            <p class="text-[14px] text-ink/65 leading-relaxed max-w-[65ch]">
              Data centres and transmission networks account for around 1–2% of
              global electricity use, and every page view draws on both. Your
              website's carbon footprint is real, recurring, and, unlike most
              emissions, fixable in an afternoon.
            </p>
          </li>
          <li class="reveal border-b border-stone py-6">
            <h3 class="text-base md:text-lg font-medium text-ink mb-3">Carbon and conversion are the same metric</h3>
            <p class="text-[14px] text-ink/65 leading-relaxed max-w-[65ch]">
              The changes that cut CO₂ (smaller images, less JavaScript, faster hosting) are the changes that cut load time. Faster pages bounce
              less, convert more, and score better on the Core Web Vitals that
              feed Google's rankings. There is no trade-off to weigh here.
            </p>
          </li>
          <li class="reveal border-b border-stone py-6">
            <h3 class="text-base md:text-lg font-medium text-ink mb-3">Claims are cheap. Evidence isn't</h3>
            <p class="text-[14px] text-ink/65 leading-relaxed max-w-[65ch]">
              If sustainability is part of your brand, your website is the first
              place anyone can check the claim. A verifiable grade and green
              hosting you can prove beat a leaf icon in the footer every time.
            </p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ How to improve ============ -->
  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10 md:gap-16 mb-12 md:mb-16">
        <div class="md:col-span-4">
          <h2 class="headline text-2xl md:text-3xl">
            Four fixes, in order of impact.
          </h2>
        </div>
        <p class="md:col-span-7 md:col-start-6 text-[15px] text-ink/65 leading-relaxed max-w-[65ch]">
          Most sites don't need a rebuild to move two grades. They need someone
          to do the unglamorous work below. Do it yourself with our
          <a href="/blog/sustainable-web-design-practical-guide" class="text-forest hover:underline underline-offset-4">practical guide</a>,
          or ask us for a free improvement plan.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-8 md:gap-12">
        {improvements.map((item, i) => (
          <div class="reveal border-t border-stone pt-6">
            <p class="label text-forest mb-3">0{i + 1}</p>
            <h3 class="headline text-lg md:text-xl mb-3">{item.title}</h3>
            <p class="text-[14px] text-ink/65 leading-relaxed mb-4 max-w-[65ch]">{item.body}</p>
            <a href={item.link.href} class="text-[13px] font-medium text-forest hover:underline underline-offset-4">
              {item.link.label} →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <JournalLinks
    intro="The thinking behind the tool: what makes a website heavy, what genuinely green hosting looks like, and how to fix both."
    posts={journalPosts}
  />

  <!-- ============ FAQ ============ -->
  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-4">
          <h2 class="headline text-2xl md:text-3xl">
            Website carbon questions, answered.
          </h2>
        </div>
        <dl class="md:col-span-7 md:col-start-6 border-t border-stone">
          {faqs.map((f) => (
            <div class="reveal border-b border-stone py-6">
              <dt class="text-base md:text-lg font-medium text-ink mb-3">{f.q}</dt>
              <dd class="text-[14px] md:text-[15px] text-ink/65 leading-relaxed max-w-[65ch]">{f.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ Final CTA ============ -->
  <section class="py-24 md:py-40 border-t border-stone relative overflow-hidden">
    <div class="hero-glow" style="top: 50%;"></div>
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <div class="reveal max-w-2xl">
        <h2 class="headline text-3xl md:text-4xl lg:text-5xl">
          Didn't like your <em class="text-forest">grade</em>?
        </h2>
        <p class="mt-6 text-[15px] text-ink/65 leading-relaxed max-w-lg">
          Send us your URL and we will reply within 24 hours with the three
          changes that would move it most. Free, specific to your site, and
          yours to act on with or without us.
        </p>
        <a href="/contact?service=carbon-audit" class="inline-flex items-center gap-3 mt-10 text-[13px] font-medium text-forest group">
          Get your free improvement plan
          <span class="w-10 h-10 rounded-full border border-forest/30 flex items-center justify-center transition-all duration-500 group-hover:bg-forest group-hover:text-cream">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  #grade-badge {
    transition: background-color 500ms ease;
  }
  .confetto {
    position: absolute;
    top: -12px;
    width: 8px;
    height: 14px;
    opacity: 0.9;
    animation: confetti-fall 3.2s ease-in forwards;
  }
  @keyframes confetti-fall {
    to {
      transform: translateY(110vh) rotate(720deg);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .confetto {
      display: none;
    }
  }
</style>

<script>
  import { co2 } from '@tgwf/co2';

  // ---- Sustainable Web Design digital carbon ratings (g CO2e / visit),
  //      matching co2.js perVisit output. Fallback only — the letter grade
  //      normally comes from co2.js itself. ----
  const SWD_BANDS: Array<{ grade: string; max: number }> = [
    { grade: 'A+', max: 0.04 },
    { grade: 'A', max: 0.079 },
    { grade: 'B', max: 0.145 },
    { grade: 'C', max: 0.209 },
    { grade: 'D', max: 0.278 },
    { grade: 'E', max: 0.359 },
    { grade: 'F', max: Infinity },
  ];

  const GRADE_COLORS: Record<string, string> = {
    'A+': '#1A5C12',
    A: '#2E6B1E',
    B: '#4F7A1F',
    C: '#B07D10',
    D: '#B25714',
    E: '#A63A1B',
    F: '#8F1F1F',
  };

  // Percentile anchors behind the SWD rating bands, for "cleaner than X%".
  const CLEANER_ANCHORS: Array<[number, number]> = [
    [0, 99],
    [0.04, 95],
    [0.079, 90],
    [0.145, 80],
    [0.209, 70],
    [0.278, 60],
    [0.359, 50],
  ];

  let swdModel: any = null;
  function estimateCarbon(bytes: number, greenHost: boolean): { grams: number; rating: string | null } {
    if (!swdModel) {
      const options = {
        rating: true,
        dataReloadRatio: 0.02,
        firstVisitPercentage: 0.75,
        returnVisitPercentage: 0.25,
      };
      try {
        swdModel = new co2({ model: 'swd', version: 4, ...options });
      } catch {
        swdModel = new co2({ model: 'swd', ...options });
      }
    }
    const raw: any = swdModel.perVisit(bytes, greenHost);
    if (typeof raw === 'number') return { grams: raw, rating: null };
    return {
      grams: Number(raw?.total ?? raw?.co2 ?? 0),
      rating: typeof raw?.rating === 'string' ? raw.rating : null,
    };
  }

  function cleanerThanFromGrams(grams: number): number | null {
    if (grams > 0.359) return null; // below the median — shown as text instead
    for (let i = 1; i < CLEANER_ANCHORS.length; i++) {
      const [g0, p0] = CLEANER_ANCHORS[i - 1];
      const [g1, p1] = CLEANER_ANCHORS[i];
      if (grams <= g1) {
        return Math.round(p0 + ((grams - g0) / (g1 - g0)) * (p1 - p0));
      }
    }
    return 50;
  }

  const VERDICTS: Record<string, { title: string; copy: string }> = {
    great: {
      title: 'Genuinely brilliant.',
      copy: 'This page is lighter than at least 90% of the web and runs on verified green hosting. That combination is rare. Enjoy the confetti.',
    },
    leanUnknown: {
      title: 'Impressively lean.',
      copy: 'The page itself is in the top tier for weight and carbon. We could not reach the green hosting directory just now, so run the audit again in a minute for the full verdict.',
    },
    almostHosting: {
      title: 'So close to the full house.',
      copy: 'The page itself is impressively lean. The only thing standing between this site and bragging rights is the hosting underneath it. Moving to a verified green host is usually a one-day job, and we do migrations free.',
    },
    decent: {
      title: 'Decent, with easy wins left.',
      copy: 'This page is lighter than most of the web, but it is not lean yet. Sites in this band usually get to an A with image compression and a hard look at their scripts, often without touching the design.',
    },
    heavy: {
      title: 'Heavier than it needs to be.',
      copy: 'Every visit to this page emits more carbon than most of the web, and the same weight is slowing it down for visitors and search engines. The good news: grades this low usually have the most to gain from a few focused fixes.',
    },
  };

  const LOADING_MESSAGES = [
    'Fetching your page…',
    'Weighing every byte…',
    'Checking your host\'s energy supply…',
    'Crunching the carbon numbers…',
    'Nearly there. First-time audits take a little longer…',
  ];

  function gradeFromGrams(grams: number): string {
    for (const band of SWD_BANDS) {
      if (grams <= band.max) return band.grade;
    }
    return 'F';
  }

  function formatBytes(bytes: number): string {
    if (bytes >= 1024 * 1024) return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
    return `${Math.round(bytes / 1024)} KB`;
  }

  function formatGrams(grams: number): string {
    if (grams < 0.1) return `${grams.toFixed(3)} g`;
    return `${grams.toFixed(2)} g`;
  }

  function normaliseUrl(raw: string): URL | null {
    let input = raw.trim();
    if (!input) return null;
    if (!/^https?:\/\//i.test(input)) input = `https://${input}`;
    try {
      const url = new URL(input);
      if (!url.hostname.includes('.')) return null;
      return url;
    } catch {
      return null;
    }
  }

  // Optional Google API key for the PageSpeed fallback. Keyless works using
  // each visitor's own per-IP quota; a key (restricted to the PageSpeed API +
  // this site's referrer) makes it fully reliable.
  const PSI_API_KEY = '';

  async function fetchLighthouseBytes(url: URL): Promise<{ bytes: number } | null> {
    try {
      const endpoint =
        `https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url=${encodeURIComponent(url.href)}` +
        `&category=performance${PSI_API_KEY ? `&key=${PSI_API_KEY}` : ''}`;
      const res = await fetchWithTimeout(endpoint, 70000);
      if (!res.ok) return null;
      const data = await res.json();
      const bytes = data?.lighthouseResult?.audits?.['total-byte-weight']?.numericValue;
      return typeof bytes === 'number' && bytes > 0 ? { bytes: Math.round(bytes) } : null;
    } catch {
      return null;
    }
  }

  function fetchWithTimeout(resource: string, timeoutMs: number): Promise<Response> {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    return fetch(resource, { signal: controller.signal }).finally(() => clearTimeout(timer));
  }

  function el<T extends HTMLElement>(id: string): T {
    return document.getElementById(id) as T;
  }

  function dropConfetti(): void {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const host = document.getElementById('confetti-host');
    if (!host) return;
    const colors = ['#1A5C12', '#4F7A1F', '#B07D10', '#F5F0E8', '#8A8680'];
    for (let i = 0; i < 70; i++) {
      const piece = document.createElement('span');
      piece.className = 'confetto';
      piece.style.left = `${Math.random() * 100}%`;
      piece.style.background = colors[i % colors.length];
      piece.style.animationDelay = `${Math.random() * 1.2}s`;
      piece.style.transform = `rotate(${Math.random() * 360}deg)`;
      host.appendChild(piece);
    }
    setTimeout(() => { host.innerHTML = ''; }, 5000);
  }

  let lastAuditedUrl: URL | null = null;

  async function runAudit(url: URL, fresh = false): Promise<void> {
    const status = el<HTMLParagraphElement>('audit-status');
    const result = el<HTMLElement>('audit-result');
    const submit = el<HTMLButtonElement>('audit-submit');

    submit.disabled = true;
    submit.style.opacity = '0.6';
    result.classList.add('hidden');

    let messageIndex = 0;
    status.textContent = LOADING_MESSAGES[0];
    const rotate = setInterval(() => {
      messageIndex = Math.min(messageIndex + 1, LOADING_MESSAGES.length - 1);
      status.textContent = LOADING_MESSAGES[messageIndex];
    }, 4000);

    // Hosting check (fast) and carbon estimate (can take a while on a cold
    // run — the API has to fetch and weigh the page) fired in parallel.
    const greenPromise = fetchWithTimeout(
      `https://api.thegreenwebfoundation.org/api/v3/greencheck/${encodeURIComponent(url.hostname)}`,
      15000,
    ).then((r) => (r.ok ? r.json() : null)).catch(() => null);

    let carbon: any = null;
    let carbonError: 'rate-limit' | 'failed' | 'blocked' | null = null;
    try {
      const response = await fetchWithTimeout(
        `/api/carbon-audit.php?url=${encodeURIComponent(url.href)}${fresh ? '&fresh=1' : ''}`,
        75000,
      );
      if (response.status === 429) carbonError = 'rate-limit';
      else {
        const payload = await response.json().catch(() => null);
        if (payload?.ok) carbon = payload;
        else carbonError = payload?.error === 'blocked' ? 'blocked' : 'failed';
      }
    } catch {
      carbonError = 'failed';
    }

    // Firewalls that block our server by IP almost never block Google,
    // fall back to Lighthouse via the PageSpeed Insights API, called from
    // the visitor's own browser.
    let viaLighthouse = false;
    if (carbonError === 'blocked') {
      clearInterval(rotate);
      status.textContent =
        'Their firewall blocks direct checks. Asking Google Lighthouse instead. This can take up to a minute…';
      const psi = await fetchLighthouseBytes(url);
      if (psi) {
        carbon = { ok: true, bytes: psi.bytes, cached: false };
        carbonError = null;
        viaLighthouse = true;
      }
    }

    const green = await greenPromise;
    clearInterval(rotate);
    submit.disabled = false;
    submit.style.opacity = '';

    if (!carbon || typeof carbon.bytes !== 'number') {
      let message =
        carbonError === 'rate-limit'
          ? 'That\'s a lot of audits in one minute. Give it a moment and try again.'
          : carbonError === 'blocked'
            ? `That site's firewall blocks automated checks, and Google's Lighthouse fallback was busy too. Try again in a few minutes, or `
            : `We couldn't audit that address. Check the URL is public and loading, then try again, or `;
      status.innerHTML = '';
      status.append(message);
      if (carbonError !== 'rate-limit') {
        const link = document.createElement('a');
        link.href = '/contact';
        link.className = 'text-forest underline underline-offset-4';
        link.textContent = 'send it to us and we\'ll run it by hand';
        status.append(link, '.');
      }
      if (green && typeof green.green === 'boolean') {
        status.append(
          ` One thing we did learn: ${url.hostname} ${green.green ? 'is on verified green hosting, a strong start.' : 'is not in the verified green hosting directory.'}`,
        );
      }
      return;
    }

    // ---- Derive the numbers ----
    const greenKnown: boolean = !!(green && typeof green.green === 'boolean');
    const isGreenHost: boolean = greenKnown ? green.green : false;
    const { grams, rating } = estimateCarbon(carbon.bytes, isGreenHost);
    const grade: string = rating ?? gradeFromGrams(grams);
    const cleanerThan: number | null = cleanerThanFromGrams(grams);

    // ---- Populate the card ----
    lastAuditedUrl = url;
    el<HTMLElement>('cache-note').classList.toggle('hidden', carbon.cached !== true);
    el<HTMLElement>('lighthouse-note').classList.toggle('hidden', !viaLighthouse);
    el<HTMLSpanElement>('result-url').textContent = url.hostname;
    el<HTMLSpanElement>('grade-letter').textContent = grade;
    el<HTMLDivElement>('grade-badge').style.backgroundColor = GRADE_COLORS[grade] ?? GRADE_COLORS.F;
    el<HTMLElement>('stat-co2').textContent = formatGrams(grams);
    el<HTMLElement>('stat-weight').textContent = formatBytes(carbon.bytes);
    el<HTMLElement>('stat-cleaner').textContent = cleanerThan !== null ? `${cleanerThan}% of pages` : 'Below median';
    el<HTMLElement>('stat-hosting').textContent = isGreenHost ? 'Green ✓' : greenKnown ? 'Not green' : 'Unknown';
    el<HTMLElement>('stat-hosting-detail').textContent = isGreenHost
      ? `Verified green hosting${green?.hosted_by ? `, hosted by ${green.hosted_by}` : ''} (The Green Web Foundation directory).`
      : greenKnown
        ? `No verified green hosting evidence found for ${url.hostname} in The Green Web Foundation directory.`
        : 'We could not reach the green hosting directory just now. Try again shortly for the hosting result.';

    const annualKg = (grams * 120000) / 1000; // 10k visits/month for a year
    const carKm = Math.round((annualKg * 1000) / 170); // ~170 g CO2e per petrol-car km
    el<HTMLElement>('equiv-line').textContent =
      `At 10,000 visits a month, this page would emit roughly ${annualKg.toFixed(1)} kg of CO₂e a year, about the same as driving ${carKm.toLocaleString()} km in a petrol car.`;

    // ---- Verdict + CTA state ----
    const isLean = grade === 'A+' || grade === 'A';
    let verdict;
    if (isLean && isGreenHost) verdict = VERDICTS.great;
    else if (isLean && greenKnown) verdict = VERDICTS.almostHosting;
    else if (isLean) verdict = VERDICTS.leanUnknown;
    else if (grade === 'B' || grade === 'C') verdict = VERDICTS.decent;
    else verdict = VERDICTS.heavy;

    el<HTMLElement>('verdict-title').textContent = verdict.title;
    el<HTMLElement>('verdict-copy').textContent = verdict.copy;

    const celebrate = isLean && isGreenHost;
    el<HTMLElement>('cta-celebrate').classList.toggle('hidden', !celebrate);
    el<HTMLElement>('cta-improve').classList.toggle('hidden', celebrate);
    const offerHostingSwitch = greenKnown && !isGreenHost;
    const hostingLink = el<HTMLAnchorElement>('cta-hosting-link');
    hostingLink.classList.toggle('hidden', !offerHostingSwitch);
    hostingLink.classList.toggle('inline-flex', offerHostingSwitch);
    el<HTMLAnchorElement>('cta-improve-link').href =
      `/contact?service=carbon-audit&audit=${encodeURIComponent(url.hostname)}&grade=${encodeURIComponent(grade)}`;

    // Shareable URL for these results.
    const shareUrl = `${window.location.origin}${window.location.pathname}?url=${encodeURIComponent(url.hostname)}`;
    history.replaceState(null, '', shareUrl);

    status.textContent = '';
    result.classList.remove('hidden');
    result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    if (celebrate) dropConfetti();
  }

  function initAudit(): void {
    const form = document.getElementById('audit-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const input = el<HTMLInputElement>('audit-url');
    const status = el<HTMLParagraphElement>('audit-status');

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const url = normaliseUrl(input.value);
      if (!url) {
        status.textContent = 'That doesn\'t look like a web address. Try something like yourwebsite.co.uk';
        return;
      }
      runAudit(url);
    });

    document.getElementById('fresh-btn')?.addEventListener('click', () => {
      if (lastAuditedUrl) runAudit(lastAuditedUrl, true);
    });

    document.getElementById('share-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('share-btn')!;
      try {
        await navigator.clipboard.writeText(window.location.href);
        btn.textContent = 'Link copied ✓';
        setTimeout(() => { btn.textContent = 'Copy link to these results'; }, 2500);
      } catch {
        btn.textContent = window.location.href;
      }
    });

    // Shareable / linkable audits: ?url=example.com auto-runs on load.
    const preset = new URLSearchParams(window.location.search).get('url');
    if (preset) {
      const url = normaliseUrl(preset);
      if (url) {
        input.value = url.hostname;
        runAudit(url);
      }
    }
  }

  document.addEventListener('astro:page-load', initAudit);
  if (document.readyState !== 'loading') initAudit();
  else document.addEventListener('DOMContentLoaded', initAudit, { once: true });
</script>

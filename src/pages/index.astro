---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuditCta from '../components/AuditCta.astro';
import Img from '../components/Img.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../lib/posts';

const portfolioItems = (await getCollection('portfolio'))
  .sort(
    (a, b) =>
      (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
      b.data.date.valueOf() - a.data.date.valueOf()
  )
  .slice(0, 4);

// The first pinned project carries the hero, so the work section below picks
// up from the second — otherwise the same thumbnail appears twice on the page.
const heroWork = portfolioItems[0];
const workItems = portfolioItems.slice(1);

const blogPosts = (await getCollection('blog', isPublished))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 1);

const services = [
  { name: 'Branding', description: 'Identity systems that communicate your values.', href: '/services/branding' },
  { name: 'Environmental', description: 'Sustainability built into every project.', href: '/services/environmental' },
  { name: 'Web Design', description: 'Considered sites, accessible from the start.', href: '/services/web-design' },
  { name: 'Development', description: 'Fast, green, modern builds.', href: '/services/development' },
  { name: 'Copywriting', description: 'Words that mean something.', href: '/services/copywriting' },
  { name: 'Marketing', description: 'Strategy that respects the audience.', href: '/services/marketing' },
];

const testimonials = [
  {
    quote:
      "They completely blew past our expectations. The design is beautifully polished, the development is seamless, and their communication throughout the project was first-class. Highly recommend them if you want a premium digital presence.",
    name: 'Wesley Boyce',
    org: 'Brand identity & website',
  },
  {
    quote:
      "I absolutely love the look and feel of my new author website — isn't it so beautiful? They are so easy to work with and accommodating. I can recommend OakFox 100%.",
    name: 'Jennifer Lane',
    org: 'Jennifer Lane Writes',
  },
];

const homeSchema = {
  '@type': 'WebPage',
  '@id': 'https://oakfox.co.uk/#webpage',
  url: 'https://oakfox.co.uk/',
  name: 'OakFox — Sustainable Design Studio, West Lancashire UK',
  description:
    'OakFox is a sustainable design studio in West Lancashire, UK, offering branding, web design, development, marketing, and environmental consultancy for independent businesses and established brands.',
  inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://oakfox.co.uk/#website' },
  about: { '@id': 'https://oakfox.co.uk/#organization' },
  primaryImageOfPage: 'https://oakfox.co.uk/og-default.png',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    ],
  },
};
---

<BaseLayout
  title="Sustainable Design Studio, West Lancashire"
  description="OakFox is a sustainable design studio in West Lancashire, UK. Branding, web design, web development, marketing, and environmental consultancy for independent businesses and established brands — 15+ years of experience, no greenwashing."
  schema={homeSchema}
>
  <!-- ========== HERO ========== -->
  <section data-scene="hero" class="relative min-h-[100dvh] flex flex-col justify-center overflow-hidden">
    <div class="max-w-[1400px] mx-auto w-full px-6 md:px-10 relative z-10 pt-24 pb-16 md:pt-24 md:pb-24">
      <div class="grid md:grid-cols-12 gap-10 md:gap-12 items-center">
        <div class="md:col-span-7">
          <h1 class="headline text-ink" style="font-size: clamp(1.9rem, 4.4vw, 3.5rem);">
            <span class="block">
              <span class="split-word"><span>We</span></span> <span class="split-word"><span>build</span></span> <span class="split-word"><span>brands</span></span> <span class="split-word"><span>that</span></span> <em class="text-forest"><span class="split-word"><span>grow</span></span></em>
            </span>
            <span class="block">
              <span class="split-word"><span>without</span></span> <span class="split-word"><span>costing</span></span> <span class="split-word"><span>the</span></span> <em class="text-forest"><span class="split-word"><span>earth</span></span></em><span class="split-word"><span>.</span></span>
            </span>
          </h1>

          <p data-hero-paragraph class="mt-8 md:mt-10 text-[15px] text-ink/65 leading-relaxed max-w-[52ch]">
            Sustainable design, development, marketing and environmental
            consultancy from a West Lancashire studio with 15+ years of practice.
          </p>

          <div class="mt-8 md:mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a
              href="/contact"
              data-magnetic
              class="inline-flex items-center gap-3 bg-forest text-cream text-[15px] font-medium pl-6 pr-2 py-2 rounded-full hover:bg-forest-dark transition-all duration-300 group"
            >
              Start a project
              <span class="w-9 h-9 rounded-full bg-cream/15 flex items-center justify-center transition-transform duration-500 group-hover:translate-x-0.5">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
            <a
              href="/book"
              class="inline-flex items-center gap-2 text-[14px] font-medium text-ink/70 hover:text-forest transition-colors duration-300"
            >
              Book a free call
            </a>
          </div>
        </div>

        {heroWork && (
          <div class="md:col-span-5">
            <a href={`/portfolio/${heroWork.id}`} class="group block">
              <div class="img-wrap bg-stone/30 overflow-hidden">
                <Img
                  src={heroWork.data.thumbnail}
                  alt={heroWork.data.title}
                  loading="eager"
                  class="w-full h-auto"
                />
              </div>
              <div class="mt-4 flex items-baseline justify-between gap-4">
                <span class="text-[14px] font-medium text-ink group-hover:text-forest transition-colors duration-300">
                  {heroWork.data.title}
                </span>
                <span class="label text-gray shrink-0">{heroWork.data.category}</span>
              </div>
            </a>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ========== SELECTED WORK ========== -->
  <section data-scene="work" class="py-20 md:py-32">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="reveal flex items-baseline justify-between mb-12 md:mb-16">
        <h2 class="headline text-xl md:text-2xl">Selected work</h2>
        <a href="/portfolio" class="link-line text-[13px] font-medium text-ink/65 hover:text-forest transition-colors">
          View all
        </a>
      </div>

      {workItems.length > 0 ? (
        <div class="space-y-16 md:space-y-24 reveal-stagger">
          {/* Featured item — large */}
          {workItems[0] && (
            <a href={`/portfolio/${workItems[0].id}`} class="reveal group block">
              <div class="img-wrap bg-stone/30 min-h-48 max-h-[500px] overflow-hidden">
                <Img
                  src={workItems[0].data.thumbnail}
                  alt={workItems[0].data.title}
                  class="w-full h-auto"
                />
              </div>
              <div class="mt-5 flex items-baseline justify-between gap-4">
                <div>
                  <h3 class="headline text-xl md:text-2xl">{workItems[0].data.title}</h3>
                  <p class="text-[13px] text-ink/65 mt-1">{workItems[0].data.description}</p>
                </div>
                <span class="label text-gray shrink-0">{workItems[0].data.category}</span>
              </div>
            </a>
          )}

          {/* Remaining items — two-up grid */}
          {workItems.length > 1 && (
            <div class="grid md:grid-cols-2 gap-8 md:gap-12">
              {workItems.slice(1).map((item) => (
                <a href={`/portfolio/${item.id}`} class="reveal group block">
                  <div class="img-wrap bg-stone/30 min-h-40 max-h-80 overflow-hidden">
                    <Img
                      src={item.data.thumbnail}
                      alt={item.data.title}
                      class="w-full h-auto"
                    />
                  </div>
                  <div class="mt-4 flex items-baseline justify-between gap-4">
                    <h3 class="headline text-lg md:text-xl">{item.data.title}</h3>
                    <span class="label text-gray shrink-0">{item.data.category}</span>
                  </div>
                </a>
              ))}
            </div>
          )}
        </div>
      ) : (
        <p class="text-ink/65 text-center py-12">Work coming soon.</p>
      )}
    </div>
  </section>

  <!-- ========== APPROACH ========== -->
  <section data-scene="approach" class="py-20 md:py-32 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-12 md:gap-16">
        <div class="reveal md:col-span-5">
          <h2 class="headline text-2xl md:text-3xl">
            Good design and good ethics aren't at&nbsp;odds.
          </h2>
          <p class="mt-6 text-[15px] text-ink/65 leading-relaxed">
            Most studios say they're sustainable. We can prove it. Our hosting is
            independently verified by the Green Web Foundation, auditable in
            thirty seconds via their public registry, and our work is informed
            by our own original research into UK woodlands and biodiversity. So
            sustainability arrives as evidence, not as a tagline.
          </p>
          <a
            href="https://www.thegreenwebfoundation.org/green-web-check/?url=oakfox.co.uk"
            target="_blank"
            rel="noopener noreferrer"
            class="link-line inline-flex items-center gap-2 mt-6 text-[13px] font-medium text-forest"
          >
            Verify our green hosting
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <div class="reveal md:col-span-6 md:col-start-7">
          <h2 class="headline text-lg md:text-xl mb-6">Services</h2>
          <ul class="border-t border-stone">
            {services.map((service) => (
              <li class="border-b border-stone">
                <a href={service.href} class="group flex items-baseline justify-between py-4 md:py-5 gap-4">
                  <span class="text-[15px] md:text-base font-medium text-ink group-hover:text-forest transition-colors duration-300">
                    {service.name}
                  </span>
                  <span class="text-[13px] text-ink/65 hidden sm:block">
                    {service.description}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Stats -->
      <div data-scene="stats" class="reveal mt-20 md:mt-28 border-t border-stone pt-10">
        <p class="text-[15px] text-ink/65 mb-8">The studio is new. The experience isn't.</p>
        <div class="grid grid-cols-3 gap-6 md:gap-12">
          <div>
            <div class="headline text-2xl md:text-3xl" data-count-to="15" data-count-suffix="+">15+</div>
            <div class="label text-gray mt-2">Years in practice</div>
          </div>
          <div>
            <div class="headline text-2xl md:text-3xl" data-count-to="120" data-count-suffix="+">120+</div>
            <div class="label text-gray mt-2">Projects delivered</div>
          </div>
          <div>
            <div class="headline text-2xl md:text-3xl">2025</div>
            <div class="label text-gray mt-2">OakFox founded</div>
          </div>
        </div>
      </div>

      <!-- Locations signpost -->
      <div data-locations class="reveal mt-16 md:mt-20 border-t border-stone pt-10 flex flex-wrap items-baseline gap-x-6 gap-y-3">
        <p class="label text-gray">Serving</p>
        <a href="/locations/ormskirk" class="text-[13px] text-ink/65 hover:text-forest transition-colors">Ormskirk</a>
        <a href="/locations/burscough" class="text-[13px] text-ink/65 hover:text-forest transition-colors">Burscough</a>
        <a href="/locations/southport" class="text-[13px] text-ink/65 hover:text-forest transition-colors">Southport</a>
        <a href="/locations/preston" class="text-[13px] text-ink/65 hover:text-forest transition-colors">Preston</a>
        <a href="/locations/manchester" class="text-[13px] text-ink/65 hover:text-forest transition-colors">Manchester</a>
        <a href="/locations/lancashire" class="text-[13px] text-ink/65 hover:text-forest transition-colors">Lancashire</a>
        <a href="/locations" class="text-[13px] font-medium text-forest hover:underline underline-offset-4 ml-auto">All UK locations →</a>
      </div>
    </div>
  </section>

  <AuditCta />

  <!-- ========== TESTIMONIALS ========== -->
  <section class="py-20 md:py-32 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <h2 class="headline text-xl md:text-2xl mb-12 md:mb-16 reveal">What clients say</h2>
      <div class="grid md:grid-cols-2 gap-10 md:gap-12 reveal-stagger max-w-4xl">
        {testimonials.map((t) => (
          <figure class="reveal border-t border-stone pt-6">
            <blockquote class="text-[15px] text-ink/75 leading-relaxed">
              “{t.quote}”
            </blockquote>
            <figcaption class="mt-6">
              <span class="block text-[14px] font-medium text-ink">{t.name}</span>
              <span class="block label text-gray mt-1">{t.org}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== JOURNAL ========== -->
  {blogPosts.length > 0 && (
    <section data-scene="journal" class="py-16 md:py-20 border-t border-stone">
      <div class="max-w-[1400px] mx-auto px-6 md:px-10">
        <div class="reveal flex items-center justify-between gap-6">
          <div class="flex items-baseline gap-6 md:gap-10 min-w-0">
            <h2 class="label text-gray shrink-0">Latest</h2>
            <a href={`/blog/${blogPosts[0].id}`} class="group flex items-baseline gap-4 min-w-0">
              <h3 class="text-[15px] md:text-base font-medium text-ink group-hover:text-forest transition-colors truncate">
                {blogPosts[0].data.title}
              </h3>
              <time class="label text-gray shrink-0 hidden sm:block">
                {blogPosts[0].data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
              </time>
            </a>
          </div>
          <a href="/blog" class="link-line text-[13px] font-medium text-ink/65 hover:text-forest transition-colors shrink-0">
            All posts
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ========== CTA ========== -->
  <section data-scene="cta" class="py-24 md:py-40 border-t border-stone relative overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <div class="max-w-2xl">
        <h2 class="headline text-3xl md:text-4xl lg:text-5xl">
          Let's build something<br/>that <em class="text-forest">lasts</em>.
        </h2>
        <div class="flex flex-wrap gap-4 mt-10">
          <a
            href="/book"
            data-magnetic
            class="inline-flex items-center gap-3 text-[13px] font-medium text-forest group"
          >
            Book a free call
            <span class="w-10 h-10 rounded-full border border-forest/30 flex items-center justify-center transition-all duration-500 group-hover:bg-forest group-hover:text-cream">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-3 text-[13px] font-medium text-ink/70 hover:text-forest transition-colors duration-300"
          >
            Start a project
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

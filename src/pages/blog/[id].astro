---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => {
    const related = posts
      .filter((p) => p.id !== post.id)
      .map((p) => ({
        post: p,
        score: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
      }))
      .filter((r) => r.score > 0)
      .sort((a, b) => b.score - a.score || b.post.data.date.valueOf() - a.post.data.date.valueOf())
      .slice(0, 3)
      .map((r) => r.post);
    return {
      params: { id: post.id },
      props: { post, related },
    };
  });
}

const { post, related } = Astro.props;
const { Content } = await render(post);

const articleUrl = `https://oakfox.co.uk/blog/${post.id}`;
const articleSchema = {
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  inLanguage: 'en-GB',
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  articleSection: post.data.category,
  keywords: post.data.tags.join(', '),
  author: {
    '@type': 'Person',
    '@id': 'https://oakfox.co.uk/about#nathan',
    name: post.data.author,
    url: 'https://oakfox.co.uk/about',
  },
  publisher: { '@id': 'https://oakfox.co.uk/#organization' },
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Journal', item: 'https://oakfox.co.uk/blog' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: articleUrl },
  ],
};

const pageSchemas: Record<string, unknown>[] = [articleSchema, breadcrumbs];
if (post.data.howto) {
  pageSchemas.push({
    '@type': 'HowTo',
    '@id': `${articleUrl}#howto`,
    name: post.data.howto.name,
    description: post.data.howto.description,
    ...(post.data.howto.totalTime ? { totalTime: post.data.howto.totalTime } : {}),
    step: post.data.howto.steps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.name,
      text: s.text,
    })),
  });
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  schema={pageSchemas}
>
  <article class="pt-32 pb-24">
    <div class="max-w-3xl mx-auto px-6">
      <a href="/blog" class="text-forest text-sm font-medium hover:underline underline-offset-4 mb-8 inline-block">
        &larr; Back to Blog
      </a>
      <span class="text-xs font-medium text-forest uppercase tracking-widest block mb-3">
        {post.data.category}
      </span>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight">
        {post.data.title}
      </h1>
      <div class="flex items-center gap-4 mt-6 text-sm text-gray">
        <a href="/about#nathan" class="hover:text-forest transition-colors duration-300">
          {post.data.author}
        </a>
        <span>&middot;</span>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
      </div>

      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {post.data.tags.map((tag: string) => (
            <a
              href={`/blog/tags/${tag}`}
              class="px-3 py-1 bg-forest/5 text-forest text-xs font-medium rounded-full hover:bg-forest hover:text-cream transition-colors duration-300"
            >
              {tag}
            </a>
          ))}
        </div>
      )}

      <div class="prose prose-lg max-w-none mt-12
        prose-headings:font-bold prose-headings:tracking-tight
        prose-a:text-forest prose-a:underline-offset-4
        prose-img:rounded-2xl">
        <Content />
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="py-16 md:py-20 border-t border-stone">
      <div class="max-w-4xl mx-auto px-6">
        <p class="label text-gray mb-10">Related reading</p>
        <div class="grid md:grid-cols-3 gap-6 md:gap-8">
          {related.map((r) => (
            <a
              href={`/blog/${r.id}`}
              class="group block rounded-2xl border border-stone p-6 transition-all duration-300 hover:border-forest"
            >
              <span class="text-xs font-medium text-forest uppercase tracking-widest">
                {r.data.category}
              </span>
              <h3 class="text-base md:text-lg font-semibold mt-3 group-hover:text-forest transition-colors duration-300">
                {r.data.title}
              </h3>
              <p class="text-[13px] text-ink/60 mt-2 line-clamp-3">{r.data.description}</p>
              <time datetime={r.data.date.toISOString()} class="mt-4 block text-[11px] text-ink/40">
                {r.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
              </time>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="bg-forest text-cream py-16">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold text-cream">Enjoyed this post?</h2>
      <p class="text-cream-dark/80 mt-2">Check out more of our work or get in touch.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="/blog" class="border border-cream text-cream px-6 py-2 font-medium rounded-full transition-all duration-300 hover:bg-cream hover:text-forest">
          More Posts
        </a>
        <a href="/contact" class="bg-cream text-forest px-6 py-2 font-medium rounded-full transition-all duration-300 hover:bg-cream-dark">
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

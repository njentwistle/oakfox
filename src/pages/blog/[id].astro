---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuditCta from '../../components/AuditCta.astro';
import { getCollection, render } from 'astro:content';
import { isPublished } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', isPublished);
  return posts.map((post) => {
    const related = posts
      .filter((p) => p.id !== post.id)
      .map((p) => ({
        post: p,
        score: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
      }))
      .filter((r) => r.score > 0)
      .sort((a, b) => b.score - a.score || b.post.data.date.valueOf() - a.post.data.date.valueOf())
      .slice(0, 3)
      .map((r) => r.post);
    return {
      params: { id: post.id },
      props: { post, related },
    };
  });
}

const { post, related } = Astro.props;
const { Content } = await render(post);

const articleUrl = `https://oakfox.co.uk/blog/${post.id}`;
const articleSchema = {
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  inLanguage: 'en-GB',
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  articleSection: post.data.category,
  keywords: post.data.tags.join(', '),
  author: { '@id': 'https://oakfox.co.uk/#organization' },
  publisher: { '@id': 'https://oakfox.co.uk/#organization' },
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Journal', item: 'https://oakfox.co.uk/blog' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: articleUrl },
  ],
};

const pageSchemas: Record<string, unknown>[] = [articleSchema, breadcrumbs];
if (post.data.faq && post.data.faq.length > 0) {
  pageSchemas.push({
    '@type': 'FAQPage',
    '@id': `${articleUrl}#faq`,
    mainEntity: post.data.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
if (post.data.howto) {
  pageSchemas.push({
    '@type': 'HowTo',
    '@id': `${articleUrl}#howto`,
    name: post.data.howto.name,
    description: post.data.howto.description,
    ...(post.data.howto.totalTime ? { totalTime: post.data.howto.totalTime } : {}),
    step: post.data.howto.steps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.name,
      text: s.text,
    })),
  });
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  schema={pageSchemas}
>
  <article class="pt-32 pb-24">
    <div class="max-w-3xl mx-auto px-6">
      <a href="/blog" class="text-forest text-sm font-medium hover:underline underline-offset-4 mb-8 inline-block">
        &larr; Back to Blog
      </a>
      <span class="text-xs font-medium text-forest uppercase tracking-widest block mb-3">
        {post.data.category}
      </span>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight">
        {post.data.title}
      </h1>
      <div class="flex items-center gap-4 mt-6 text-sm text-gray">
        <a href="/about" class="hover:text-forest transition-colors duration-300">
          {post.data.author}
        </a>
        <span>&middot;</span>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        {post.data.updated && (
          <>
            <span>&middot;</span>
            <span>
              Updated{' '}
              <time datetime={post.data.updated.toISOString()}>
                {post.data.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
            </span>
          </>
        )}
      </div>

      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {post.data.tags.map((tag: string) => (
            <a
              href={`/blog/tags/${tag}`}
              class="px-3 py-1 bg-forest/5 text-forest text-xs font-medium rounded-full hover:bg-forest hover:text-cream transition-colors duration-300"
            >
              {tag}
            </a>
          ))}
        </div>
      )}

      <div class="prose prose-lg max-w-none mt-12
        prose-headings:font-bold prose-headings:tracking-tight
        prose-a:text-forest prose-a:underline-offset-4
        prose-img:rounded-2xl">
        <Content />
      </div>

      {post.data.faq && post.data.faq.length > 0 && (
        <section class="mt-16 pt-12 border-t border-stone">
          <p class="label text-gray mb-6">Frequently asked</p>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-8">Common questions</h2>
          <dl class="border-t border-stone">
            {post.data.faq.map((f) => (
              <div class="border-b border-stone py-6">
                <dt class="text-base md:text-lg font-medium text-ink mb-3">{f.q}</dt>
                <dd class="text-[14px] md:text-[15px] text-ink/70 leading-relaxed">{f.a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}
    </div>
  </article>

  <AuditCta />

  {related.length > 0 && (
    <section class="py-16 md:py-20 border-t border-stone">
      <div class="max-w-4xl mx-auto px-6">
        <p class="label text-gray mb-10">Related reading</p>
        <div class="grid md:grid-cols-3 gap-6 md:gap-8">
          {related.map((r) => (
            <a
              href={`/blog/${r.id}`}
              class="group block rounded-2xl border border-stone p-6 transition-all duration-300 hover:border-forest"
            >
              <span class="text-xs font-medium text-forest uppercase tracking-widest">
                {r.data.category}
              </span>
              <h3 class="text-base md:text-lg font-semibold mt-3 group-hover:text-forest transition-colors duration-300">
                {r.data.title}
              </h3>
              <p class="text-[13px] text-ink/60 mt-2 line-clamp-3">{r.data.description}</p>
              <time datetime={r.data.date.toISOString()} class="mt-4 block text-[11px] text-ink/40">
                {r.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
              </time>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-20 md:py-28 border-t border-stone relative overflow-hidden">
    <div class="hero-glow" style="top: 50%;"></div>
    <div class="max-w-3xl mx-auto px-6 relative z-10">
      <p class="label text-gray mb-6">Working on something similar?</p>
      <h2 class="headline text-2xl md:text-3xl lg:text-4xl">
        Tell us about your <em class="text-forest">project</em>.
      </h2>
      <p class="mt-6 text-[15px] text-ink/65 leading-relaxed max-w-xl">
        We work with independent businesses and established brands across the UK,
        Ireland, and Europe — branding, web, marketing, and environmental
        consultancy. Send a few lines and we'll reply within 24 hours.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href="/contact" class="inline-flex items-center gap-3 text-[13px] font-medium bg-forest text-cream hover:bg-forest-dark transition-colors duration-300 px-5 py-3 rounded-full">
          Start a conversation
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/book" class="inline-flex items-center gap-2 text-[13px] font-medium text-ink/70 hover:text-forest transition-colors duration-300">
          Or book a free call
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

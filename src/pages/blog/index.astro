---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../lib/posts';

const posts = (await getCollection('blog', isPublished))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const topTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12);

const pageUrl = 'https://oakfox.co.uk/blog';

const blogSchema = {
  '@type': 'Blog',
  '@id': `${pageUrl}#blog`,
  url: pageUrl,
  name: 'OakFox Journal',
  description:
    'Essays and practical guides on sustainable branding, accessible web design, green web development, marketing without greenwashing, and environmental consultancy — from OakFox, a sustainable design studio in West Lancashire, UK.',
  inLanguage: 'en-GB',
  publisher: { '@id': 'https://oakfox.co.uk/#organization' },
  blogPost: posts.slice(0, 10).map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    url: `https://oakfox.co.uk/blog/${post.id}`,
    author: { '@id': 'https://oakfox.co.uk/#organization' },
  })),
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Journal', item: pageUrl },
  ],
};
---

<BaseLayout
  title="Journal — Sustainable Branding, Web Design & Environmental Writing"
  description="Essays and practical guides from the OakFox studio on sustainable branding, accessible web design, green web development, honest marketing, and environmental consultancy."
  schema={[blogSchema, breadcrumbs]}
>
  <section class="pt-32 pb-8">
    <div class="max-w-7xl mx-auto px-6">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight max-w-3xl">Journal</h1>
      <p class="mt-6 text-lg text-gray max-w-2xl">
        Essays and practical guides from the <a href="/about" class="text-forest underline underline-offset-4">OakFox studio</a>
        on sustainable branding, accessible web design, green web development,
        honest marketing, and environmental consultancy.
      </p>
      <div class="mt-6 flex flex-wrap gap-4">
        <a href="/contact" class="text-forest font-medium text-sm hover:underline underline-offset-4">
          Start a project &rarr;
        </a>
        <a href="/portfolio" class="text-forest font-medium text-sm hover:underline underline-offset-4">
          See selected work &rarr;
        </a>
      </div>

      <div class="mt-10 flex flex-col gap-4">
        <div class="relative max-w-md">
          <input
            id="blog-search"
            type="search"
            placeholder="Search posts…"
            class="w-full pl-11 pr-4 py-3 rounded-full border border-stone bg-cream text-[14px] text-ink placeholder:text-ink/65 focus:outline-none focus:border-forest focus:ring-2 focus:ring-forest/20 transition-all"
            aria-label="Search posts"
          />
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-ink/65" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="11" cy="11" r="7" />
            <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
          </svg>
        </div>
        {topTags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-2">
            <span class="text-[11px] font-mono uppercase tracking-widest text-gray pr-2 self-center">Tags</span>
            {topTags.map(([tag, count]) => (
              <a
                href={`/blog/tags/${tag}`}
                class="px-3 py-1 bg-forest/5 text-forest text-xs font-medium rounded-full hover:bg-forest hover:text-cream transition-colors duration-300"
              >
                {tag} <span class="text-forest/60">· {count}</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="py-8 pb-24">
    <div class="max-w-7xl mx-auto px-6">
      {posts.length > 0 ? (
        <div id="blog-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="blog-card group block rounded-2xl border border-gray-light p-6 transition-all duration-300 hover:border-forest hover:shadow-lg"
              data-title={post.data.title.toLowerCase()}
              data-description={post.data.description.toLowerCase()}
              data-tags={post.data.tags.join(' ').toLowerCase()}
              data-category={post.data.category.toLowerCase()}
            >
              <span class="text-xs font-medium text-forest uppercase tracking-widest">
                {post.data.category}
              </span>
              <h2 class="text-xl font-semibold mt-3 group-hover:text-forest transition-colors duration-300">
                {post.data.title}
              </h2>
              <p class="text-gray text-sm mt-2 line-clamp-3">{post.data.description}</p>
              <div class="flex items-center justify-between mt-6 pt-4 border-t border-gray-light">
                <span class="text-xs text-gray">{post.data.author}</span>
                <time datetime={post.data.date.toISOString()} class="text-xs text-gray">
                  {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-gray text-center py-12">Blog posts coming soon.</p>
      )}
      <p id="blog-empty" class="hidden text-gray text-center py-12">No posts match that search.</p>
    </div>
  </section>

  <script>
    function initBlogSearch() {
      const input = document.getElementById('blog-search') as HTMLInputElement | null;
      if (!input) return;
      const cards = document.querySelectorAll<HTMLAnchorElement>('.blog-card');
      const empty = document.getElementById('blog-empty');

      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        let visible = 0;
        cards.forEach((card) => {
          const hay = [
            card.dataset.title ?? '',
            card.dataset.description ?? '',
            card.dataset.tags ?? '',
            card.dataset.category ?? '',
          ].join(' ');
          const match = q === '' || hay.includes(q);
          card.style.display = match ? '' : 'none';
          if (match) visible += 1;
        });
        if (empty) empty.classList.toggle('hidden', visible > 0);
      });
    }

    document.addEventListener('astro:page-load', initBlogSearch);
  </script>

  <section class="py-20 md:py-24 border-t border-stone relative overflow-hidden">
    <div class="max-w-3xl mx-auto px-6 relative z-10">
      <NewsletterSignup />
    </div>
  </section>
</BaseLayout>

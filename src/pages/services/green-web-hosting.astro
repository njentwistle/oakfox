---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocationSignpost from '../../components/LocationSignpost.astro';

const pageUrl = 'https://oakfox.co.uk/services/green-web-hosting';

const serviceSchema = {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: 'Green Web Hosting',
  description: 'Managed green web hosting for UK businesses — renewable-powered infrastructure, hands-on support, free migrations. OakFox handles setup, monitoring, and maintenance on top of verified green hosting.',
  provider: { '@id': 'https://oakfox.co.uk/#organization' },
  areaServed: ['United Kingdom', 'England', 'Scotland', 'Wales', 'Northern Ireland'],
  serviceType: 'Web hosting',
  url: pageUrl,
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://oakfox.co.uk/services' },
    { '@type': 'ListItem', position: 3, name: 'Green Web Hosting', item: pageUrl },
  ],
};

// TODO Nathan: confirm pricing + specs against your HostingUK reseller package.
const plans = [
  {
    name: 'Starter',
    price: '£9',
    cadence: '/ month',
    summary: 'A single site, fully managed. For sole traders, small studios, and brochure sites.',
    features: [
      '1 website',
      '10 GB SSD storage',
      'Unmetered UK bandwidth',
      'Free SSL certificate',
      'Daily backups (14-day retention)',
      'Free migration from your current host',
      'Email support, next business day',
    ],
    cta: { label: 'Start with Starter', href: '/contact?plan=hosting-starter' },
    highlight: false,
  },
  {
    name: 'Growth',
    price: '£22',
    cadence: '/ month',
    summary: 'Multi-site businesses, e-commerce, and sites with growing traffic.',
    features: [
      'Up to 3 websites',
      '30 GB SSD storage',
      'Unmetered UK bandwidth',
      'Free SSL certificates (all sites)',
      'Daily backups (30-day retention)',
      'Free migration from your current host',
      'Priority email support, same business day',
      'Quarterly performance + uptime check-in',
    ],
    cta: { label: 'Choose Growth', href: '/contact?plan=hosting-growth' },
    highlight: true,
  },
  {
    name: 'Business',
    price: '£45',
    cadence: '/ month',
    summary: 'Higher-traffic sites, multiple brands, or businesses needing hands-on involvement.',
    features: [
      'Up to 10 websites',
      '100 GB SSD storage',
      'Unmetered UK bandwidth',
      'Free SSL certificates (all sites)',
      'Hourly backups (60-day retention)',
      'Free migration from your current host',
      'Phone + email support, 4-hour response SLA',
      'Monthly performance + uptime check-in',
      'Quarterly review call',
    ],
    cta: { label: 'Talk about Business', href: '/contact?plan=hosting-business' },
    highlight: false,
  },
];

const offerings = [
  {
    label: 'Infrastructure',
    title: 'Renewable-powered UK hosting',
    description:
      'Sites run on verified renewable-powered UK infrastructure — UK data centres, no offsetting smoke and mirrors. The lowest-carbon hosting layer available without running our own kit.',
  },
  {
    label: 'Management',
    title: 'You do not touch a cPanel',
    description:
      'We handle the setup, DNS, SSL, backups, security updates, and monitoring. When something goes wrong — and one day it will — you email us, not a queue ticket on a global support desk. UK office hours, real reply.',
  },
  {
    label: 'Migration',
    title: 'Free move from your current host',
    description:
      'Migrating from SiteGround, GoDaddy, Bluehost, Krystal, or anywhere else? We handle it end to end — files, databases, email, DNS — with zero downtime. No charge for the move on any plan.',
  },
];

const whyGreen = [
  {
    title: 'The internet has a carbon footprint',
    body: 'Data centres and transmission networks now account for around 1–2% of global electricity use. Hosting choice is one of the highest-leverage sustainability decisions any business can make for its digital footprint.',
  },
  {
    title: 'Green hosting is verifiable',
    body: 'We host with providers on The Green Web Foundation\'s verified directory — not just companies that buy offsets and call it neutral. You can independently check whether a site is hosted green at thegreenwebfoundation.org.',
  },
  {
    title: 'It is no slower, and no more expensive',
    body: 'Modern renewable-powered UK hosting performs identically to fossil-fuel-backed grid hosting on speed, uptime, and cost. The trade-off is essentially zero — which makes the case for switching very straightforward.',
  },
];

const forWho = [
  'Small businesses, studios, and sole traders who want their hosting to reflect their values',
  'Sustainability-focused brands who would rather not explain why their site runs on coal-powered infrastructure',
  'Anyone tired of WordPress hosts with confusing dashboards and overseas support queues',
  'Existing OakFox clients consolidating their stack with one UK supplier',
  'Businesses migrating away from a host that bills in dollars and supports in a timezone twelve hours behind',
];

const faqs = [
  {
    q: 'Is green web hosting actually greener, or is it marketing?',
    a: 'Both exist. Genuinely green hosting runs on verified renewable energy — solar, wind, hydro — and can be independently checked against The Green Web Foundation\'s public directory. Hosts that simply purchase carbon offsets to claim "neutrality" are not the same thing. OakFox only resells hosts on the verified green directory.',
  },
  {
    q: 'Where are your servers located?',
    a: 'All hosting plans run in UK data centres — relevant for GDPR, for performance to UK visitors, and for the carbon intensity of the underlying grid.',
  },
  {
    q: 'Will moving to green hosting hurt my SEO or speed?',
    a: 'No. Modern green hosting performs identically to standard hosting on every metric — uptime, response time, Core Web Vitals, Lighthouse score. If anything, a move from a slow shared host to managed green hosting often improves performance.',
  },
  {
    q: 'Do you handle the migration from my current host?',
    a: 'Yes, free on every plan. We move your files, databases, email accounts, and DNS records, then schedule the DNS cutover for a quiet time so visitors see zero downtime. Most migrations complete inside a working day.',
  },
  {
    q: 'What is included in "managed"?',
    a: 'Setup, DNS configuration, SSL certificates, automated backups, security updates, uptime monitoring, and a real human to email when something is wrong. You never need to log into cPanel unless you want to.',
  },
  {
    q: 'Do you offer green web hosting in London / Manchester / Liverpool / elsewhere in the UK?',
    a: 'Yes — every plan is available UK-wide. Hosting is location-independent at the point of purchase, though we serve clients across the UK including London, Manchester, Liverpool, Birmingham, Leeds, Edinburgh, and our home patch of West Lancashire / Ormskirk.',
  },
  {
    q: 'What happens if I want to leave?',
    a: 'You own your data. We hand over a complete export — files, databases, DNS records — and assist with migration to your new host. No lock-in, no exit fees, no awkward conversations.',
  },
  {
    q: 'How does this compare to Krystal, Kualo, or GreenGeeks directly?',
    a: 'Going direct to a host is cheaper if you are comfortable managing your own hosting. OakFox\'s plans cost a little more because they include hands-on UK support, free migrations, ongoing maintenance, and the same person to talk to whether the question is about hosting, your site, or your brand.',
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Green Web Hosting UK — Managed, Renewable-Powered Hosting"
  description="Managed green web hosting for UK businesses. Renewable-powered UK data centres, free migration, real UK support — from £9 / month. Verified green hosting by OakFox."
  schema={[serviceSchema, breadcrumbs, faqSchema]}
>
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="hero-glow" style="top: 45%;"></div>
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <p class="label text-forest mb-8">Service · Green Web Hosting</p>
      <h1 class="headline text-ink max-w-4xl" style="font-size: clamp(2rem, 5.5vw, 4.5rem);">
        Managed <em class="text-forest">green</em> hosting.
        UK <em class="text-forest">support</em>.
      </h1>
      <div class="mt-10 md:mt-14 grid md:grid-cols-12 gap-8 items-end">
        <p class="md:col-span-6 text-[15px] md:text-base text-ink/65 leading-relaxed">
          Renewable-powered hosting in UK data centres, with the boring bits —
          setup, DNS, SSL, backups, monitoring — handled by OakFox. Free
          migration from your current host, plans from £9 a month, and a real
          person to email when something needs fixing.
        </p>
        <div class="md:col-span-3 md:col-start-10 flex items-center justify-start md:justify-end">
          <a href="#plans" class="inline-flex items-center gap-3 text-[13px] font-medium text-forest group">
            See the plans
            <span class="w-10 h-10 rounded-full border border-forest/30 flex items-center justify-center transition-all duration-500 group-hover:bg-forest group-hover:text-cream">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 5v14M5 12l7 7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <p class="label text-gray mb-10 md:mb-14">What's included</p>
      <div class="grid md:grid-cols-3 gap-8 md:gap-12">
        {offerings.map((o) => (
          <div class="reveal">
            <p class="label text-forest mb-4">{o.label}</p>
            <h3 class="headline text-xl md:text-2xl mb-4">{o.title}</h3>
            <p class="text-[14px] text-ink/60 leading-relaxed">{o.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="plans" class="py-20 md:py-28 border-t border-stone scroll-mt-24">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10 md:gap-16 mb-12 md:mb-16">
        <div class="md:col-span-4">
          <p class="label text-gray mb-6">Plans</p>
          <h2 class="headline text-2xl md:text-3xl">
            Three plans. <em class="text-forest">No&nbsp;upsells.</em>
          </h2>
        </div>
        <p class="md:col-span-7 md:col-start-6 text-[15px] text-ink/65 leading-relaxed">
          Every plan includes free migration, free SSL, daily backups, and real
          UK support. The difference is how many sites you need to host and how
          quickly you need us to respond when something is wrong.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 md:gap-8">
        {plans.map((p) => (
          <div class={`reveal flex flex-col border ${p.highlight ? 'border-forest bg-forest/5' : 'border-stone'} rounded-2xl p-8`}>
            <div class="flex items-baseline justify-between mb-6">
              <h3 class="headline text-xl md:text-2xl">{p.name}</h3>
              {p.highlight && <span class="label text-forest">Most popular</span>}
            </div>
            <div class="mb-6">
              <span class="text-4xl md:text-5xl font-semibold text-ink">{p.price}</span>
              <span class="text-[14px] text-ink/55 ml-1">{p.cadence}</span>
            </div>
            <p class="text-[14px] text-ink/65 leading-relaxed mb-8">{p.summary}</p>
            <ul class="space-y-3 mb-10 flex-1">
              {p.features.map((f) => (
                <li class="flex items-start gap-3 text-[14px] text-ink/75 leading-relaxed">
                  <svg class="w-4 h-4 mt-1 text-forest flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <a href={p.cta.href} class={`inline-flex items-center justify-center gap-2 py-3 px-5 rounded-full text-[13px] font-medium transition-colors duration-500 ${p.highlight ? 'bg-forest text-cream hover:bg-forest/90' : 'border border-forest/30 text-forest hover:bg-forest hover:text-cream'}`}>
              {p.cta.label}
            </a>
          </div>
        ))}
      </div>

      <p class="mt-10 text-[13px] text-ink/50 leading-relaxed max-w-2xl">
        Prices exclude VAT. Annual billing available with two months free.
        Need something larger — a busy e-commerce store, a high-traffic
        publication, or dedicated infrastructure? <a href="/contact" class="text-forest hover:underline underline-offset-4">Get in touch</a> for a custom quote.
      </p>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10 md:gap-16">
        <div class="md:col-span-4">
          <p class="label text-gray mb-6">Why green</p>
          <h2 class="headline text-2xl md:text-3xl">
            Hosting is the easiest <em class="text-forest">sustainability win</em> your website has.
          </h2>
        </div>
        <ol class="md:col-span-7 md:col-start-6 border-t border-stone">
          {whyGreen.map((w) => (
            <li class="reveal border-b border-stone py-6">
              <h3 class="text-base md:text-lg font-medium text-ink mb-3">{w.title}</h3>
              <p class="text-[14px] text-ink/60 leading-relaxed">{w.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-4">
          <p class="label text-gray mb-6">Who it's for</p>
          <h2 class="headline text-2xl md:text-3xl">
            Good fits <em class="text-forest">look&nbsp;like…</em>
          </h2>
        </div>
        <ul class="md:col-span-7 md:col-start-6 border-t border-stone">
          {forWho.map((line) => (
            <li class="reveal border-b border-stone py-5 text-[15px] md:text-base text-ink/75 leading-relaxed">
              {line}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone bg-forest/5">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10 items-center">
        <div class="md:col-span-7">
          <p class="label text-forest mb-6">Bundle</p>
          <h2 class="headline text-2xl md:text-3xl mb-6">
            Hosting + a site that <em class="text-forest">earns&nbsp;it</em>.
          </h2>
          <p class="text-[15px] text-ink/70 leading-relaxed max-w-xl">
            Green hosting is a strong start. A static-first, accessible,
            performant build is the rest of the story. We design and develop
            websites built to match the infrastructure underneath them — and
            bundle the first 12 months of hosting in.
          </p>
        </div>
        <div class="md:col-span-4 md:col-start-9 flex md:justify-end">
          <a href="/services/development" class="inline-flex items-center gap-3 text-[13px] font-medium text-forest group">
            See development services
            <span class="w-10 h-10 rounded-full border border-forest/30 flex items-center justify-center transition-all duration-500 group-hover:bg-forest group-hover:text-cream">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <LocationSignpost service="Green web hosting" keyword="green web hosting" />

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-4">
          <p class="label text-gray mb-6">Frequently asked</p>
          <h2 class="headline text-2xl md:text-3xl">
            Green hosting <em class="text-forest">questions</em> we hear a lot.
          </h2>
          <p class="mt-6 text-[14px] text-ink/55 leading-relaxed">
            Reading up first? Our <a href="/blog/green-web-hosting-uk-compared" class="text-forest hover:underline underline-offset-4">green web hosting comparison</a> covers the main UK providers in depth.
          </p>
        </div>
        <dl class="md:col-span-7 md:col-start-6 border-t border-stone">
          {faqs.map((f) => (
            <div class="reveal border-b border-stone py-6">
              <dt class="text-base md:text-lg font-medium text-ink mb-3">{f.q}</dt>
              <dd class="text-[14px] md:text-[15px] text-ink/65 leading-relaxed">{f.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-40 border-t border-stone relative overflow-hidden">
    <div class="hero-glow" style="top: 50%;"></div>
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <div class="reveal max-w-2xl">
        <p class="label text-gray mb-6">Next step</p>
        <h2 class="headline text-3xl md:text-4xl lg:text-5xl">
          Ready to <em class="text-forest">move</em>?
        </h2>
        <p class="mt-6 text-[15px] text-ink/60 leading-relaxed max-w-lg">
          Tell us where your site is hosted right now and which plan fits.
          We reply within 24 hours with a migration window and a single
          invoice — no setup fees, no surprise add-ons.
        </p>
        <a href="/contact?service=green-web-hosting" class="inline-flex items-center gap-3 mt-10 text-[13px] font-medium text-forest group">
          Start the migration
          <span class="w-10 h-10 rounded-full border border-forest/30 flex items-center justify-center transition-all duration-500 group-hover:bg-forest group-hover:text-cream">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

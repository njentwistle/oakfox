---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const pageUrl = 'https://oakfox.co.uk/services/environmental';

const webPage = {
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: 'Environmental & Sustainability — OakFox',
  description:
    'Sustainability is woven into every OakFox project — verified green hosting and original ecological research. Dedicated ecology reporting and automation (PEA, BNG, SFI) is handled by our venture, EcoScribe.',
  inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://oakfox.co.uk/#website' },
  about: { '@id': 'https://oakfox.co.uk/#organization' },
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://oakfox.co.uk/services' },
    { '@type': 'ListItem', position: 3, name: 'Environmental', item: pageUrl },
  ],
};
---

<BaseLayout
  title="Environmental & Sustainability"
  description="Sustainability is woven into every OakFox project — verified green hosting and original ecological research. Dedicated ecology reporting and automation is handled by our venture, EcoScribe."
  schema={[webPage, breadcrumbs]}
>
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="hero-glow" style="top: 45%;"></div>
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <p class="label text-forest mb-8">Environmental</p>
      <h1 class="headline text-ink max-w-4xl" style="font-size: clamp(2rem, 5.5vw, 4.5rem);">
        Sustainability, <em class="text-forest">by proof</em> — not by claim.
      </h1>
      <div class="mt-10 md:mt-14 grid md:grid-cols-12 gap-8">
        <p class="md:col-span-7 text-[15px] md:text-base text-ink/65 leading-relaxed">
          The environment isn't a service line at OakFox — it's a constraint on every
          decision. Our hosting is independently verified by the Green Web Foundation,
          and our work is informed by our own original research into UK woodlands and
          biodiversity. Sustainability arrives as evidence, not as a tagline.
        </p>
      </div>
    </div>
  </section>

  <!-- HOW SUSTAINABILITY SHOWS UP IN THE STUDIO WORK -->
  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-4">
          <p class="label text-gray mb-6">In the work</p>
          <h2 class="headline text-2xl md:text-3xl">
            Built into the <em class="text-forest">brand and the build</em>.
          </h2>
        </div>
        <div class="md:col-span-7 md:col-start-6 grid gap-8">
          <div class="border-t border-stone pt-6">
            <h3 class="text-base md:text-lg font-medium text-ink mb-2">Verified green hosting</h3>
            <p class="text-[14px] md:text-[15px] text-ink/65 leading-relaxed">
              Sites run on renewable-powered UK infrastructure, independently verified by the
              Green Web Foundation and auditable in thirty seconds. See
              <a href="/services/green-web-hosting" class="text-forest underline underline-offset-4">green web hosting</a>.
            </p>
          </div>
          <div class="border-t border-stone pt-6">
            <h3 class="text-base md:text-lg font-medium text-ink mb-2">Low-carbon, accessible builds</h3>
            <p class="text-[14px] md:text-[15px] text-ink/65 leading-relaxed">
              Static-first architecture measured against real performance and carbon budgets —
              part of every <a href="/services/development" class="text-forest underline underline-offset-4">development</a> engagement.
            </p>
          </div>
          <div class="border-t border-stone pt-6">
            <h3 class="text-base md:text-lg font-medium text-ink mb-2">Honest, anti-greenwashing brand work</h3>
            <p class="text-[14px] md:text-[15px] text-ink/65 leading-relaxed">
              We'll tell you when a sustainability claim outstrips what a business actually does.
              Credibility beats a better press release — see <a href="/services/branding" class="text-forest underline underline-offset-4">branding</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ECOSCRIBE BRIDGE -->
  <section class="py-20 md:py-28 border-t border-stone bg-forest/[0.03]">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10 items-center">
        <div class="md:col-span-7">
          <p class="label text-forest mb-6">Our environmental venture</p>
          <h2 class="headline text-2xl md:text-3xl mb-6">
            Ecology reporting &amp; automation is now <em class="text-forest">EcoScribe</em>.
          </h2>
          <p class="text-[15px] text-ink/70 leading-relaxed max-w-xl">
            Our work automating Preliminary Ecological Appraisals (PEA), Biodiversity Net Gain
            (BNG) assessments, and SFI applications for ecologists and environmental consultancies
            has grown into its own venture — <strong>EcoScribe</strong>. If you're an ecological
            consultancy, landowner, or developer looking to take the paperwork off your plate,
            that's where to go.
          </p>
        </div>
        <div class="md:col-span-4 md:col-start-9 flex md:justify-end">
          <a
            href="https://ecoscribe.co.uk"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-3 bg-forest text-cream text-[14px] font-medium pl-6 pr-2 py-2 rounded-full hover:bg-forest-dark transition-all duration-300 group"
          >
            Visit EcoScribe
            <span class="w-9 h-9 rounded-full bg-cream/15 flex items-center justify-center transition-transform duration-500 group-hover:translate-x-0.5">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 md:py-40 border-t border-stone relative overflow-hidden">
    <div class="hero-glow" style="top: 50%;"></div>
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <div class="reveal max-w-2xl">
        <p class="label text-gray mb-6">Working with OakFox</p>
        <h2 class="headline text-3xl md:text-4xl lg:text-5xl">
          Build a brand that can <em class="text-forest">prove it</em>.
        </h2>
        <p class="mt-6 text-[15px] text-ink/60 leading-relaxed max-w-lg">
          For branding, web, marketing, or green hosting with sustainability built in,
          send a few lines. We reply within 24 hours.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href="/contact" class="inline-flex items-center gap-3 text-[13px] font-medium text-forest group">
            Start a conversation
            <span class="w-10 h-10 rounded-full border border-forest/30 flex items-center justify-center transition-all duration-500 group-hover:bg-forest group-hover:text-cream">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
          <a href="/book" class="inline-flex items-center gap-2 text-[13px] font-medium text-ink/70 hover:text-forest transition-colors duration-300">
            Or book a free call
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

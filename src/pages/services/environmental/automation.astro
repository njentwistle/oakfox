---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const pageUrl = 'https://oakfox.co.uk/services/environmental/automation';

const serviceSchema = {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: 'Environmental Automation',
  description: 'Intelligent automation for environmental consultancies, ecologists, and regenerative farmers. Report generation, grant drafting, and compliance workflows — built on green infrastructure.',
  provider: { '@id': 'https://oakfox.co.uk/#organization' },
  areaServed: ['United Kingdom', 'Ireland', 'Europe'],
  serviceType: 'Business process automation',
  url: pageUrl,
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://oakfox.co.uk/services' },
    { '@type': 'ListItem', position: 3, name: 'Environmental', item: 'https://oakfox.co.uk/services/environmental' },
    { '@type': 'ListItem', position: 4, name: 'Automation', item: pageUrl },
  ],
};

const offerings = [
  {
    label: 'Reporting',
    title: 'Report generation from the field',
    description:
      'Ecologists, surveyors, and consultants speak or type their findings. A structured, formatted, professional report is produced in minutes — in your template, with your terminology.',
  },
  {
    label: 'Applications',
    title: 'Grant and scheme drafting',
    description:
      'SFI, Countryside Stewardship, Biodiversity Net Gain submissions, funding applications. We build systems that draft from your farm or project data — you review and submit.',
  },
  {
    label: 'Compliance',
    title: 'Evidence and audit workflows',
    description:
      'Carbon sequestration records, BNG monitoring, certification paperwork. Automated capture, organised archive, ready when the auditor or buyer asks.',
  },
];

const process = [
  { step: '01', title: 'Listen', body: 'We sit with the people doing the work and map where the hours actually go — reports, applications, evidence chasing, chasing people who never reply.' },
  { step: '02', title: 'Scope', body: 'One workflow first. We pick the highest-pain, highest-repetition task and scope exactly what solving it looks like.' },
  { step: '03', title: 'Build', body: 'A working prototype in your tools, your templates, your tone. Green-hosted, GDPR-aware, auditable from day one.' },
  { step: '04', title: 'Pilot', body: 'You use it on real work for a defined period. We refine against what actually happens, not what we assumed would.' },
  { step: '05', title: 'Handover', body: 'Documentation, a clear support route, and a retainer option for ongoing refinement — because your reporting requirements will keep changing.' },
];

const forWho = [
  'Ecological consultancies producing repetitive report formats (PEA, EIA, BNG)',
  'Environmental consultancies drowning in planning and compliance paperwork',
  'Regenerative farmers evidencing SFI, carbon, or biodiversity outcomes',
  'Conservation charities and trusts with small teams and large administrative loads',
  'Renewable energy and environmental law practices with document-heavy workflows',
];

const principles = [
  {
    title: 'No clinical or ecological judgement',
    body: 'These systems handle writing, formatting, and administration. The expert decisions stay with the expert. That is the deal — and we state it in every proposal.',
  },
  {
    title: 'Green infrastructure by default',
    body: 'Hosting on verified renewable-powered providers. Model choices made with energy cost in mind. We measure what we build and are honest about it.',
  },
  {
    title: 'Your tools, not ours',
    body: 'We integrate into the booking systems, CRMs, and data sources you already use. We do not sell a platform you have to onboard into.',
  },
];
---

<BaseLayout
  title="Environmental Automation"
  description="OakFox builds intelligent automation for environmental consultancies, ecologists, and regenerative farmers. Report generation, grant drafting, and compliance workflows — built on green infrastructure."
  schema={[serviceSchema, breadcrumbs]}
>
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="hero-glow" style="top: 45%;"></div>
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <p class="label text-forest mb-8">
        <a href="/services/environmental" class="hover:text-ink transition-colors duration-300">Environmental</a>
        <span class="text-ink/40 mx-2">·</span>
        Automation
      </p>
      <h1 class="headline text-ink max-w-4xl" style="font-size: clamp(2rem, 5.5vw, 4.5rem);">
        Less <em class="text-forest">admin</em>.
        More time for the work that <em class="text-forest">matters</em>.
      </h1>
      <div class="mt-10 md:mt-14 grid md:grid-cols-12 gap-8 items-end">
        <p class="md:col-span-6 text-[15px] md:text-base text-ink/65 leading-relaxed">
          We build intelligent automation for the people doing the most important
          environmental work — ecologists, consultancies, regenerative farmers,
          conservation teams. Reports that write themselves. Grant applications
          drafted from the data you already collect. Compliance evidence
          organised before anyone asks for it.
        </p>
        <div class="md:col-span-3 md:col-start-10 flex items-center justify-start md:justify-end">
          <a href="/contact" class="inline-flex items-center gap-3 text-[13px] font-medium text-forest group">
            Start a conversation
            <span class="w-10 h-10 rounded-full border border-forest/30 flex items-center justify-center transition-all duration-500 group-hover:bg-forest group-hover:text-cream">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <p class="label text-gray mb-10 md:mb-14">What's included</p>
      <div class="grid md:grid-cols-3 gap-8 md:gap-12">
        {offerings.map((o) => (
          <div class="reveal">
            <p class="label text-forest mb-4">{o.label}</p>
            <h3 class="headline text-xl md:text-2xl mb-4">{o.title}</h3>
            <p class="text-[14px] text-ink/60 leading-relaxed">{o.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10 md:gap-16">
        <div class="md:col-span-4">
          <p class="label text-gray mb-6">How we work</p>
          <h2 class="headline text-2xl md:text-3xl">
            Five stages. <em class="text-forest">One&nbsp;workflow at a time.</em>
          </h2>
        </div>
        <ol class="md:col-span-7 md:col-start-6 border-t border-stone">
          {process.map((p) => (
            <li class="reveal border-b border-stone py-6 grid grid-cols-[auto,1fr] gap-6 md:gap-10">
              <span class="label text-gray pt-1">{p.step}</span>
              <div>
                <h3 class="text-base md:text-lg font-medium text-ink">{p.title}</h3>
                <p class="mt-2 text-[14px] text-ink/60 leading-relaxed">{p.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-4">
          <p class="label text-gray mb-6">How we approach it</p>
          <h2 class="headline text-2xl md:text-3xl">
            Responsibly <em class="text-forest">built</em>.
          </h2>
        </div>
        <div class="md:col-span-7 md:col-start-6 grid gap-8">
          {principles.map((p) => (
            <div class="reveal border-t border-stone pt-6">
              <h3 class="text-base md:text-lg font-medium text-ink mb-2">{p.title}</h3>
              <p class="text-[14px] text-ink/60 leading-relaxed">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-4">
          <p class="label text-gray mb-6">Who it's for</p>
          <h2 class="headline text-2xl md:text-3xl">
            Good fits <em class="text-forest">look&nbsp;like…</em>
          </h2>
        </div>
        <ul class="md:col-span-7 md:col-start-6 border-t border-stone">
          {forWho.map((line) => (
            <li class="reveal border-b border-stone py-5 text-[15px] md:text-base text-ink/75 leading-relaxed">
              {line}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-40 border-t border-stone relative overflow-hidden">
    <div class="hero-glow" style="top: 50%;"></div>
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <div class="reveal max-w-2xl">
        <p class="label text-gray mb-6">Next step</p>
        <h2 class="headline text-3xl md:text-4xl lg:text-5xl">
          Tell us where the <em class="text-forest">hours go</em>.
        </h2>
        <p class="mt-6 text-[15px] text-ink/60 leading-relaxed max-w-lg">
          Send a few lines about the workflow that's eating your week. We reply within
          24 hours to set up a free scoping call — no pitch deck, no obligation.
        </p>
        <a href="/contact" class="inline-flex items-center gap-3 mt-10 text-[13px] font-medium text-forest group">
          Start a conversation
          <span class="w-10 h-10 rounded-full border border-forest/30 flex items-center justify-center transition-all duration-500 group-hover:bg-forest group-hover:text-cream">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

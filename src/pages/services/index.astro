---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageUrl = 'https://oakfox.co.uk/services';

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: pageUrl },
  ],
};

const services = [
  {
    label: 'Branding',
    title: 'Sustainable brand identity',
    description:
      'Identity systems, voice, and guidelines for businesses that want to grow without the environmental cost. Built to last rather than trend.',
    href: '/services/branding',
    cta: 'See the service',
  },
  {
    label: 'Environmental',
    title: 'Consultancy and intelligent automation',
    description:
      'Practical consultancy on operations, supply chain, and packaging — plus intelligent automation for environmental consultancies, ecologists, and regenerative farmers.',
    href: '/services/environmental',
    cta: 'See both services',
  },
];

const enquire = [
  {
    title: 'Design',
    description: 'Considered visual communication across print and digital.',
  },
  {
    title: 'Development',
    description: 'Fast, accessible, modern websites and web applications.',
  },
  {
    title: 'Marketing',
    description: 'Strategy and campaigns that grow reach without greenwashing.',
  },
];
---

<BaseLayout
  title="Services"
  description="OakFox services: sustainable branding, practical environmental consultancy, intelligent automation, design, development, and marketing."
  schema={[breadcrumbs]}
>
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="hero-glow" style="top: 45%;"></div>
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <p class="label text-forest mb-8">Services</p>
      <h1 class="headline text-ink max-w-4xl" style="font-size: clamp(2rem, 5.5vw, 4.5rem);">
        How we <em class="text-forest">help</em>.
      </h1>
      <div class="mt-10 md:mt-14 grid md:grid-cols-12 gap-8">
        <p class="md:col-span-7 text-[15px] md:text-base text-ink/65 leading-relaxed">
          OakFox runs two dedicated practice areas — branding, and environmental —
          alongside project work in design, development, and marketing. Every
          engagement is shaped by the same belief: work that respects the planet
          performs better, lasts longer, and matters more.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <p class="label text-gray mb-10 md:mb-14">Dedicated practices</p>
      <div class="grid md:grid-cols-2 gap-10 md:gap-16">
        {services.map((s) => (
          <a href={s.href} class="reveal group block border-t border-stone pt-8 hover:border-forest transition-colors duration-500">
            <p class="label text-forest mb-4">{s.label}</p>
            <h2 class="headline text-2xl md:text-3xl mb-5 group-hover:text-forest transition-colors duration-500">
              {s.title}
            </h2>
            <p class="text-[14px] md:text-[15px] text-ink/65 leading-relaxed mb-8">
              {s.description}
            </p>
            <span class="inline-flex items-center gap-3 text-[13px] font-medium text-forest">
              {s.cta}
              <span class="w-10 h-10 rounded-full border border-forest/30 flex items-center justify-center transition-all duration-500 group-hover:bg-forest group-hover:text-cream">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-4">
          <p class="label text-gray mb-6">Project work</p>
          <h2 class="headline text-2xl md:text-3xl">
            Also <em class="text-forest">available</em>.
          </h2>
          <p class="mt-6 text-[14px] text-ink/60 leading-relaxed max-w-sm">
            Design, development, and marketing work that sits alongside the dedicated
            practices — or stands on its own when that's what the project needs.
            Enquire for scope and pricing.
          </p>
        </div>
        <ul class="md:col-span-7 md:col-start-6 border-t border-stone">
          {enquire.map((e) => (
            <li class="reveal border-b border-stone py-5 md:py-6">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="text-base md:text-lg font-medium text-ink">{e.title}</h3>
                <a href="/contact" class="text-[13px] text-forest/80 hover:text-forest transition-colors duration-300 shrink-0">
                  Enquire
                </a>
              </div>
              <p class="mt-2 text-[14px] text-ink/60 leading-relaxed">{e.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-40 border-t border-stone relative overflow-hidden">
    <div class="hero-glow" style="top: 50%;"></div>
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <div class="reveal max-w-2xl">
        <p class="label text-gray mb-6">Not sure which fits?</p>
        <h2 class="headline text-3xl md:text-4xl lg:text-5xl">
          Start with a <em class="text-forest">conversation</em>.
        </h2>
        <p class="mt-6 text-[15px] text-ink/60 leading-relaxed max-w-lg">
          Send a few lines about what you're trying to do. We reply within
          24 hours and point you toward the right starting point — or tell
          you if we're not the right fit for the work.
        </p>
        <a href="/contact" class="inline-flex items-center gap-3 mt-10 text-[13px] font-medium text-forest group">
          Start a conversation
          <span class="w-10 h-10 rounded-full border border-forest/30 flex items-center justify-center transition-all duration-500 group-hover:bg-forest group-hover:text-cream">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

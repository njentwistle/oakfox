---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuditCta from '../../components/AuditCta.astro';
import LocationSignpost from '../../components/LocationSignpost.astro';

const pageUrl = 'https://oakfox.co.uk/services';

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: pageUrl },
  ],
};

const practices = [
  {
    label: 'Branding',
    title: 'Sustainable brand identity',
    description:
      'Identity systems, voice, and guidelines for businesses that want to grow without the environmental cost. Built to last rather than trend.',
    href: '/services/branding',
    cta: 'See the service',
  },
  {
    label: 'Environmental',
    title: 'Sustainability, proven not claimed',
    description:
      'Verified green hosting and original ecological research woven into every project, plus EcoScribe, our venture automating ecology reports (PEA, BNG, SFI) for the environmental sector.',
    href: '/services/environmental',
    cta: 'See the practice',
  },
];

const projectServices = [
  {
    label: 'Web Design',
    title: 'Considered website design',
    description:
      'Information architecture, user experience, visual design, and design systems, accessible from the start.',
    href: '/services/web-design',
  },
  {
    label: 'Development',
    title: 'Fast, accessible, green builds',
    description:
      'Static-first architecture, modern frameworks, CMS your team can use, deployed to verified renewable-powered hosting.',
    href: '/services/development',
  },
  {
    label: 'Green Web Hosting',
    title: 'Managed green hosting, UK support',
    description:
      'Renewable-powered UK hosting with the boring bits handled: setup, DNS, SSL, backups, monitoring. Free migration on every plan.',
    href: '/services/green-web-hosting',
  },
  {
    label: 'Copywriting',
    title: 'Words that mean something',
    description:
      'Brand voice, website copy, campaign copy, long-form. Honest, precise, edited enough times to feel effortless.',
    href: '/services/copywriting',
  },
  {
    label: 'Marketing',
    title: 'Attention earned, not bought',
    description:
      'Strategy, content, email, organic social, SEO. Fewer better pieces. No greenwashing, no vanity metrics.',
    href: '/services/marketing',
  },
];
---

<BaseLayout
  title="Services"
  description="OakFox services: sustainable branding, environmental consultancy and automation, web design, development, copywriting, and marketing."
  schema={[breadcrumbs]}
>
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <h1 class="headline text-ink max-w-4xl" style="font-size: clamp(2rem, 5.5vw, 4.5rem);">
        Two practices, one <em class="text-forest">standard</em>.
      </h1>
      <div class="mt-10 md:mt-14 grid md:grid-cols-12 gap-8">
        <p class="md:col-span-7 text-[15px] md:text-base text-ink/65 leading-relaxed">
          OakFox runs two dedicated practice areas, branding and environmental,
          alongside focused services in web design, development, copywriting, and
          marketing. Every engagement is shaped by the same belief: work that
          respects the planet performs better, lasts longer, and matters more.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <p class="label text-gray mb-10 md:mb-14">Dedicated practices</p>
      <div class="grid md:grid-cols-2 gap-10 md:gap-16">
        {practices.map((s) => (
          <a href={s.href} class="reveal group block border-t border-stone pt-8 hover:border-forest transition-colors duration-500">
            <p class="label text-forest mb-4">{s.label}</p>
            <h2 class="headline text-2xl md:text-3xl mb-5 group-hover:text-forest transition-colors duration-500">
              {s.title}
            </h2>
            <p class="text-[14px] md:text-[15px] text-ink/65 leading-relaxed mb-8">
              {s.description}
            </p>
            <span class="inline-flex items-center gap-3 text-[13px] font-medium text-forest">
              {s.cta}
              <span class="w-10 h-10 rounded-full border border-forest/30 flex items-center justify-center transition-all duration-500 group-hover:bg-forest group-hover:text-cream">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <p class="label text-gray mb-10 md:mb-14">Project services</p>
      <div class="grid md:grid-cols-2 gap-8 md:gap-10">
        {projectServices.map((s) => (
          <a href={s.href} class="reveal group block border-t border-stone pt-6 hover:border-forest transition-colors duration-500">
            <p class="label text-forest mb-3">{s.label}</p>
            <h3 class="headline text-xl md:text-2xl mb-3 group-hover:text-forest transition-colors duration-500">
              {s.title}
            </h3>
            <p class="text-[14px] text-ink/65 leading-relaxed mb-6">{s.description}</p>
            <span class="inline-flex items-center gap-2 text-[13px] font-medium text-forest/80 group-hover:text-forest transition-colors duration-300">
              See the service
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <LocationSignpost service="Services" keyword="design and consultancy" />

  <AuditCta />

  <section class="py-24 md:py-40 border-t border-stone relative overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <div class="reveal max-w-2xl">
        <h2 class="headline text-3xl md:text-4xl lg:text-5xl">
          Start with a <em class="text-forest">conversation</em>.
        </h2>
        <p class="mt-6 text-[15px] text-ink/65 leading-relaxed max-w-lg">
          Send a few lines about what you're trying to do. We reply within
          24 hours and point you toward the right starting point, or tell
          you if we're not the right fit for the work.
        </p>
        <a href="/contact" class="inline-flex items-center gap-3 mt-10 text-[13px] font-medium text-forest group">
          Start a conversation
          <span class="w-10 h-10 rounded-full border border-forest/30 flex items-center justify-center transition-all duration-500 group-hover:bg-forest group-hover:text-cream">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

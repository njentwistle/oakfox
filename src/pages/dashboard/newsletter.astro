---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Letter">
  <div class="db-fade-in">
    <header style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; flex-wrap: wrap; gap: 12px;">
      <div>
        <h1 class="db-heading" style="font-size: 32px; margin-bottom: 4px;">Studio Notes</h1>
        <p style="color: var(--db-text-muted); font-size: 13px;">Bespoke newsletter list. Data lives on your server, not a third party.</p>
      </div>
      <a
        href="/dashboard/newsletter-data.php?format=csv"
        class="db-btn db-btn-primary"
        download
      >
        Download CSV
      </a>
    </header>

    <div id="letter-stats" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 24px;"></div>

    <div id="letter-list"></div>

    <p id="letter-error" style="color: var(--db-danger); font-size: 13px; display: none;"></p>
  </div>

  <script>
    type Subscriber = {
      email: string;
      status: 'confirmed' | 'pending' | 'unsubscribed' | string;
      created: string | null;
      confirmed: string | null;
      updated: string | null;
    };

    const statsEl = document.getElementById('letter-stats')!;
    const listEl = document.getElementById('letter-list')!;
    const errEl = document.getElementById('letter-error')!;

    function fmt(iso: string | null): string {
      if (!iso) return '—';
      const d = new Date(iso);
      return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    function statCard(label: string, value: number | string) {
      return `<div style="background: var(--db-surface); border: 1px solid var(--db-border); border-radius: 10px; padding: 14px 16px;">
        <div style="font-size: 11px; color: var(--db-text-muted); text-transform: uppercase; letter-spacing: 0.12em;">${label}</div>
        <div style="font-size: 24px; font-weight: 600; margin-top: 6px;">${value}</div>
      </div>`;
    }

    function render(data: { subscribers: Subscriber[]; stats: Record<string, number> }) {
      statsEl.innerHTML = [
        statCard('Total', data.stats.total ?? 0),
        statCard('Confirmed', data.stats.confirmed ?? 0),
        statCard('Pending', data.stats.pending ?? 0),
        statCard('Unsubscribed', data.stats.unsubscribed ?? 0),
      ].join('');

      if (!data.subscribers.length) {
        listEl.innerHTML = `<div style="background: var(--db-surface); border: 1px solid var(--db-border); border-radius: 10px; padding: 32px; text-align: center; color: var(--db-text-muted);">No subscribers yet. The signup form is live in the footer and on the Journal page.</div>`;
        return;
      }

      const rows = data.subscribers
        .sort((a, b) => (b.created ?? '').localeCompare(a.created ?? ''))
        .map((s) => {
          const colour = s.status === 'confirmed' ? 'var(--db-accent)' : s.status === 'pending' ? '#c8a24a' : 'var(--db-text-muted)';
          return `<tr>
            <td style="padding: 12px 16px; border-bottom: 1px solid var(--db-border);">${s.email}</td>
            <td style="padding: 12px 16px; border-bottom: 1px solid var(--db-border); color: ${colour}; text-transform: capitalize; font-size: 13px;">${s.status}</td>
            <td style="padding: 12px 16px; border-bottom: 1px solid var(--db-border); color: var(--db-text-muted); font-size: 13px;">${fmt(s.created)}</td>
            <td style="padding: 12px 16px; border-bottom: 1px solid var(--db-border); color: var(--db-text-muted); font-size: 13px;">${fmt(s.confirmed)}</td>
          </tr>`;
        }).join('');

      listEl.innerHTML = `<div style="background: var(--db-surface); border: 1px solid var(--db-border); border-radius: 10px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="background: rgba(0,0,0,0.2);">
              <th style="padding: 10px 16px; text-align: left; font-size: 11px; color: var(--db-text-muted); text-transform: uppercase; letter-spacing: 0.12em; font-weight: 500;">Email</th>
              <th style="padding: 10px 16px; text-align: left; font-size: 11px; color: var(--db-text-muted); text-transform: uppercase; letter-spacing: 0.12em; font-weight: 500;">Status</th>
              <th style="padding: 10px 16px; text-align: left; font-size: 11px; color: var(--db-text-muted); text-transform: uppercase; letter-spacing: 0.12em; font-weight: 500;">Signed up</th>
              <th style="padding: 10px 16px; text-align: left; font-size: 11px; color: var(--db-text-muted); text-transform: uppercase; letter-spacing: 0.12em; font-weight: 500;">Confirmed</th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      </div>`;
    }

    async function load() {
      try {
        const res = await fetch('/dashboard/newsletter-data.php', { credentials: 'include' });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        render(data);
      } catch (e) {
        errEl.style.display = 'block';
        errEl.textContent = 'Could not load subscribers. ' + (e instanceof Error ? e.message : '');
      }
    }

    load();
  </script>
</DashboardLayout>

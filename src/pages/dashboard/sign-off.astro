---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Client sign-off">
  <div class="db-fade-in">
    <header style="margin-bottom: 24px;">
      <h1 class="db-heading" style="font-size: 32px; margin-bottom: 4px;">Client sign-off</h1>
      <p style="color: var(--db-text-muted); font-size: 13px; max-width: 70ch;">
        Create a private link where a client reads what you've agreed and signs it. You both get an email copy, and the
        signed record stays on the server, outside the website. A sent agreement can't be edited: withdraw it and create a new one.
      </p>
    </header>

    <section class="db-card" style="margin-bottom: 16px;">
      <h2 class="db-heading" style="font-size: 16px; margin-bottom: 6px;">Payments to collect</h2>
      <p style="color: var(--db-text-muted); font-size: 12px; margin-bottom: 12px;">
        Saved when a client signs. You're emailed a week before each payment, on the day, and weekly while it's unpaid.
        Mark it paid and the reminder moves to the next due date.
      </p>
      <div id="payments"><p style="color: var(--db-text-muted); font-size: 13px;">Loading…</p></div>
    </section>

    <form id="compose" class="db-card" style="margin-bottom: 16px;" novalidate>
      <h2 class="db-heading" style="font-size: 16px; margin-bottom: 14px;">New sign-off</h2>

      <div class="so-grid so-grid-3">
        <label><span class="db-label">Client name</span><input name="name" class="db-input" placeholder="Jane Smith" required /></label>
        <label><span class="db-label">Company</span><input name="company" class="db-input" placeholder="Smith &amp; Co. Ltd" /></label>
        <label><span class="db-label">Client email</span><input name="email" type="email" class="db-input" placeholder="jane@smithco.com" required /></label>
      </div>

      <div class="so-grid" style="margin-top: 12px;">
        <label><span class="db-label">Title</span><input name="title" class="db-input" placeholder="Website, domain and hosting" required /></label>
        <label><span class="db-label">Introduction</span><textarea name="intro" class="db-input" rows="3" placeholder="This confirms the work you asked us to go ahead with."></textarea></label>
      </div>

      <div style="margin-top: 18px;">
        <span class="db-label">Items</span>
        <div id="items" class="so-items"></div>
        <button type="button" id="add-item" class="db-btn db-btn-sm" style="margin-top: 8px;">Add item</button>
      </div>

      <label style="display: block; margin-top: 18px;">
        <span class="db-label">Terms, one per line</span>
        <textarea name="terms" class="db-input" rows="3" placeholder="Hosting has a minimum term of 12 months."></textarea>
      </label>

      <label style="display: flex; gap: 10px; align-items: center; margin-top: 14px; font-size: 13px; color: var(--db-text-secondary);">
        <input type="checkbox" name="billingChoice" class="db-checkbox" checked />
        Ask the client whether they'll pay the monthly items monthly or annually (12 months up front)
      </label>

      <div style="display: flex; gap: 12px; align-items: center; margin-top: 18px; flex-wrap: wrap;">
        <button type="submit" id="create" class="db-btn db-btn-primary">Create private link</button>
        <span id="compose-error" role="alert" style="color: var(--db-danger); font-size: 13px;"></span>
      </div>

      <div id="created" class="so-created" hidden>
        <span class="db-label">Private link</span>
        <input id="created-url" class="db-input db-mono" readonly />
        <div style="display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap;">
          <button type="button" class="db-btn db-btn-sm" data-copy>Copy link</button>
          <a class="db-btn db-btn-sm" id="created-mail" href="#">Email to client</a>
          <a class="db-btn db-btn-sm db-btn-ghost" id="created-open" href="#" target="_blank" rel="noopener">Open</a>
        </div>
      </div>
    </form>

    <section class="db-card">
      <h2 class="db-heading" style="font-size: 16px; margin-bottom: 14px;">Sign-offs</h2>
      <div id="list"><p style="color: var(--db-text-muted); font-size: 13px;">Loading…</p></div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var form = $('compose');
      var field = function (n) { return form.querySelector('[name="' + n + '"]'); };

      function el(tag, attrs, text) {
        var e = document.createElement(tag);
        for (var k in attrs || {}) e.setAttribute(k, attrs[k]);
        if (text != null) e.textContent = text;
        return e;
      }
      function when(iso) {
        return new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'Europe/London' });
      }
      function copy(text, button) {
        navigator.clipboard.writeText(text).then(function () {
          var was = button.textContent;
          button.textContent = 'Copied';
          setTimeout(function () { button.textContent = was; }, 1500);
        });
      }
      function mailto(client, title, url) {
        var first = (client.name || '').split(' ')[0];
        var body = 'Hi ' + first + ',\n\n'
          + 'Here’s the agreement for ' + title + '. It sets out what we agreed and the prices. Please read it through and sign at the bottom:\n\n'
          + url + '\n\n'
          + 'Once you’ve signed, you’ll get a copy by email.\n\n'
          + 'Many thanks,\nNathan';
        return 'mailto:' + encodeURIComponent(client.email) + '?subject=' + encodeURIComponent('Your agreement with OakFox: ' + title) + '&body=' + encodeURIComponent(body);
      }

      /* ---------- Items ---------- */

      function addItem(item) {
        item = item || {};
        var row = el('div', { class: 'so-item' });
        row.innerHTML =
          '<input class="db-input" data-k="label" placeholder="Item, e.g. One-page website" />' +
          '<input class="db-input" data-k="detail" placeholder="Detail (optional)" />' +
          '<input class="db-input" data-k="price" type="number" min="0" step="0.01" placeholder="Price £" />' +
          '<input class="db-input" data-k="was" type="number" min="0" step="0.01" placeholder="Usually £" title="Optional: shown struck through, for a discount" />' +
          '<select class="db-input db-select" data-k="unit"><option value="one-off">One-off</option><option value="month">Per month</option><option value="year">Per year</option></select>' +
          '<button type="button" class="db-btn db-btn-sm db-btn-ghost" aria-label="Remove item">Remove</button>';
        ['label', 'detail', 'price', 'was', 'unit'].forEach(function (k) {
          if (item[k] != null) row.querySelector('[data-k="' + k + '"]').value = item[k];
        });
        row.querySelector('button').onclick = function () { row.remove(); };
        $('items').appendChild(row);
      }
      $('add-item').onclick = function () { addItem(); };
      addItem();

      function readItems() {
        return Array.prototype.map.call($('items').children, function (row) {
          var v = function (k) { return row.querySelector('[data-k="' + k + '"]').value; };
          return { label: v('label'), detail: v('detail'), price: v('price') || 0, was: v('was') || null, unit: v('unit') };
        }).filter(function (i) { return i.label.trim(); });
      }

      /* ---------- Create ---------- */

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var error = $('compose-error'), button = $('create');
        error.textContent = '';
        button.disabled = true;
        var client = { name: field('name').value, company: field('company').value, email: field('email').value };
        var title = field('title').value;
        fetch('/dashboard/signoffs-update.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'create',
            client: client,
            title: title,
            intro: field('intro').value,
            items: readItems(),
            terms: field('terms').value.split('\n'),
            billingChoice: field('billingChoice').checked,
          }),
        })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) {
            if (!res.ok) { error.textContent = res.j.error || 'Could not create the link.'; return; }
            $('created').hidden = false;
            $('created-url').value = res.j.url;
            $('created-open').href = res.j.url;
            $('created-mail').href = mailto(client, title, res.j.url);
            load();
          })
          .catch(function () { error.textContent = 'Could not reach the server.'; })
          .finally(function () { button.disabled = false; });
      });
      form.querySelector('[data-copy]').onclick = function (e) { copy($('created-url').value, e.target); };

      /* ---------- List ---------- */

      var badges = { awaiting: ['Awaiting signature', 'db-badge-in-progress'], signed: ['Signed', 'db-badge-done'], withdrawn: ['Withdrawn', 'db-badge-not-started'] };

      function row(s) {
        var box = el('div', { class: 'so-row' });
        var head = el('div', { class: 'so-row-head' });
        var who = el('div');
        who.append(el('div', { class: 'so-title' }, s.title), el('div', { class: 'so-sub' }, [s.client.name, s.client.company].filter(Boolean).join(', ') + ', sent ' + when(s.created)));
        var badge = badges[s.status] || badges.awaiting;
        head.append(who, el('span', { class: 'db-badge ' + badge[1] }, badge[0]));
        box.appendChild(head);

        box.appendChild(el('div', { class: 'so-sub' }, s.summary.map(function (t) { return t[0] + ': ' + t[1]; }).join('. ')));

        var sig = s.signature;
        if (sig) {
          var dl = el('dl', { class: 'so-audit' });
          [['Signed by', sig.name + (sig.role ? ', ' + sig.role : '')], ['Signed at', when(sig.signedAt)], ['Payment choice', s.billing || 'Not asked'], ['Email', sig.email], ['IP address', sig.ip], ['Browser', sig.userAgent], ['Fingerprint', sig.fingerprint]]
            .forEach(function (p) { dl.append(el('dt', null, p[0]), el('dd', p[0] === 'Fingerprint' ? { class: 'db-mono' } : null, p[1])); });
          box.appendChild(dl);
        }
        if (s.payments && s.payments.length) {
          var sched = el('ul', { class: 'so-schedule' });
          s.payments.forEach(function (p) {
            var state = p.status === 'active' ? 'next due ' + day(p.nextDue) : p.status === 'done' ? 'paid' : 'stopped';
            sched.appendChild(el('li', null, p.label + ', ' + money(p.amount) + every(p) + ': ' + state + (p.paid.length ? ', paid ' + p.paid.length + (p.paid.length === 1 ? ' time' : ' times') : '')));
          });
          box.appendChild(sched);
        }
        if (s.withdrawnAt) box.appendChild(el('div', { class: 'so-sub' }, 'Withdrawn ' + when(s.withdrawnAt)));

        var actions = el('div', { class: 'so-actions' });
        var copyBtn = el('button', { type: 'button', class: 'db-btn db-btn-sm' }, 'Copy link');
        copyBtn.onclick = function () { copy(s.url, copyBtn); };
        actions.append(copyBtn, el('a', { class: 'db-btn db-btn-sm db-btn-ghost', href: s.url, target: '_blank', rel: 'noopener' }, 'Open'));
        if (s.status === 'awaiting') {
          actions.appendChild(el('a', { class: 'db-btn db-btn-sm', href: mailto(s.client, s.title, s.url) }, 'Email to client'));
          var withdraw = el('button', { type: 'button', class: 'db-btn db-btn-sm db-btn-ghost' }, 'Withdraw');
          withdraw.onclick = function () {
            if (!confirm('Withdraw "' + s.title + '"? The link will stop accepting a signature.')) return;
            fetch('/dashboard/signoffs-update.php', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'withdraw', token: s.token }) })
              .then(function (r) { return r.json(); })
              .then(function (j) { if (j.error) alert(j.error); load(); });
          };
          actions.appendChild(withdraw);
        }
        box.appendChild(actions);
        return box;
      }

      /* ---------- Payments ---------- */

      function money(n) { return '£' + Number(n).toLocaleString('en-GB', Number.isInteger(Number(n)) ? {} : { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
      function every(p) { return { month: ' a month', year: ' a year', once: ' once' }[p.every] || ''; }
      function day(ymd) { return new Date(ymd + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }); }
      function daysUntil(ymd) {
        var today = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/London' });
        return Math.round((Date.parse(ymd) - Date.parse(today)) / 86400000);
      }
      function relative(days) {
        if (days === 0) return 'Due today';
        if (days > 0) return 'Due in ' + days + (days === 1 ? ' day' : ' days');
        return -days + (days === -1 ? ' day' : ' days') + ' overdue';
      }
      function payment(token, id, op, date) {
        return fetch('/dashboard/signoffs-update.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'payment', token: token, id: id, op: op, date: date }),
        })
          .then(function (r) { return r.json(); })
          .then(function (j) { if (j.error) alert(j.error); load(); });
      }

      function paymentRow(s, p) {
        var days = daysUntil(p.nextDue);
        var box = el('div', { class: 'so-pay' + (days < 0 ? ' so-pay-late' : '') });
        var what = el('div');
        what.append(
          el('div', { class: 'so-title' }, s.client.company || s.client.name),
          el('div', { class: 'so-sub' }, p.label + ', ' + money(p.amount) + every(p) + (p.paid.length ? '. Last paid ' + day(p.paid[p.paid.length - 1].paidAt.slice(0, 10)) : ''))
        );
        var due = el('div', { class: 'so-due' });
        due.append(el('div', { class: 'so-due-rel' }, relative(days)), el('div', { class: 'so-sub' }, day(p.nextDue)));

        var actions = el('div', { class: 'so-actions', style: 'margin-top: 0;' });
        var paid = el('button', { type: 'button', class: 'db-btn db-btn-sm db-btn-primary' }, 'Mark paid');
        paid.onclick = function () { payment(s.token, p.id, 'paid'); };
        var date = el('input', { type: 'date', class: 'db-input so-date', value: p.nextDue, 'aria-label': 'Next due date' });
        date.onchange = function () { if (date.value) payment(s.token, p.id, 'date', date.value); };
        var stop = el('button', { type: 'button', class: 'db-btn db-btn-sm db-btn-ghost' }, 'Stop');
        stop.onclick = function () {
          if (confirm('Stop reminders for ' + p.label + ' (' + (s.client.company || s.client.name) + ')?')) payment(s.token, p.id, 'stop');
        };
        actions.append(paid, date, stop);
        box.append(what, due, actions);
        return box;
      }

      function renderPayments(signoffs) {
        var list = $('payments');
        list.textContent = '';
        var pays = [];
        signoffs.forEach(function (s) {
          (s.payments || []).forEach(function (p) { if (p.status === 'active') pays.push([s, p]); });
        });
        pays.sort(function (a, b) { return a[1].nextDue.localeCompare(b[1].nextDue); });
        if (!pays.length) {
          list.appendChild(el('p', { style: 'color: var(--db-text-muted); font-size: 13px;' }, 'Nothing to collect yet. Payments appear here when a client signs.'));
          return;
        }
        pays.forEach(function (x) { list.appendChild(paymentRow(x[0], x[1])); });
      }

      function load() {
        fetch('/dashboard/signoffs-data.php', { cache: 'no-store' })
          .then(function (r) { return r.json(); })
          .then(function (j) {
            renderPayments(j.signoffs);
            var list = $('list');
            list.textContent = '';
            if (!j.signoffs.length) {
              list.appendChild(el('p', { style: 'color: var(--db-text-muted); font-size: 13px;' }, 'No sign-offs yet. Create one above and send the link to your client.'));
              return;
            }
            j.signoffs.forEach(function (s) { list.appendChild(row(s)); });
          })
          .catch(function () { $('list').textContent = 'Could not load sign-offs.'; });
      }
      load();
    })();
  </script>

  <style>
    .so-grid { display: grid; gap: 12px; }
    .so-grid-3 { grid-template-columns: repeat(3, 1fr); }
    .so-grid label, label > .db-label { display: block; }
    .so-grid .db-label, label > .db-label { margin-bottom: 6px; }
    .so-grid .db-input, form textarea.db-input { width: 100%; }
    .so-items { display: grid; gap: 8px; margin-top: 6px; }
    :global(.so-item) { display: grid; grid-template-columns: 2fr 2.4fr 0.9fr 0.9fr 1fr auto; gap: 8px; }
    :global(.so-item .db-input) { width: 100%; min-width: 0; }
    .so-created { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--db-border); }
    .so-created .db-input { width: 100%; margin-top: 6px; }
    :global(.so-row) { padding: 16px 0; border-bottom: 1px solid var(--db-border); }
    :global(.so-row:last-child) { border-bottom: 0; }
    :global(.so-row-head) { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
    :global(.so-title) { color: var(--db-text); font-weight: 600; font-size: 14px; }
    :global(.so-sub) { color: var(--db-text-muted); font-size: 12px; margin-top: 3px; }
    :global(.so-audit) { display: grid; grid-template-columns: max-content 1fr; gap: 4px 14px; margin: 12px 0 0; font-size: 12px; }
    :global(.so-audit dt) { color: var(--db-text-muted); }
    :global(.so-audit dd) { margin: 0; color: var(--db-text-secondary); word-break: break-all; }
    :global(.so-schedule) { margin: 10px 0 0; padding-left: 18px; font-size: 12px; color: var(--db-text-secondary); }
    :global(.so-pay) { display: grid; grid-template-columns: 1fr auto auto; gap: 16px; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--db-border); }
    :global(.so-pay:last-child) { border-bottom: 0; }
    :global(.so-due) { text-align: right; }
    :global(.so-due-rel) { font-size: 13px; font-weight: 600; color: var(--db-text); }
    :global(.so-pay-late .so-due-rel) { color: var(--db-danger); }
    :global(.so-date) { width: 150px; padding: 6px 8px; font-size: 12px; }
    :global(.so-actions) { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
    @media (max-width: 800px) {
      .so-grid-3 { grid-template-columns: 1fr; }
      :global(.so-item) { grid-template-columns: 1fr 1fr; }
      :global(.so-pay) { grid-template-columns: 1fr auto; }
      :global(.so-pay .so-actions) { grid-column: 1 / -1; }
    }
  </style>
</DashboardLayout>

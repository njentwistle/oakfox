---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Focus">
  <div id="focus-app" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: calc(100vh - 80px); text-align: center; padding: 24px; position: relative;">

    <!-- Ambient background glow that intensifies when running -->
    <div id="focus-ambient" style="position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 1.5s ease;">
      <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 500px; height: 500px; background: radial-gradient(circle, rgba(92,140,74,0.06) 0%, transparent 70%); border-radius: 50%;"></div>
    </div>

    <!-- Focus text -->
    <p class="db-label" style="margin-bottom: 16px; position: relative; z-index: 1;">Today's Focus</p>
    <h1 class="db-heading" style="font-size: clamp(22px, 3.5vw, 36px); max-width: 560px; margin-bottom: 56px; min-height: 1.2em; opacity: 0.85; position: relative; z-index: 1;" id="focus-display"></h1>

    <!-- Timer ring -->
    <div id="timer-ring" class="focus-ring-paused" style="width: 200px; height: 200px; border-radius: 50%; border: 1.5px solid var(--db-border); display: flex; align-items: center; justify-content: center; margin-bottom: 40px; transition: border-color 0.5s; position: relative; z-index: 1;">
      <span class="db-mono" style="font-size: 44px; font-weight: 700; letter-spacing: -0.02em; color: var(--db-text);" id="timer-display">25:00</span>
    </div>

    <!-- Controls -->
    <div style="display: flex; gap: 8px; margin-bottom: 28px; position: relative; z-index: 1;">
      <button class="db-btn db-btn-primary" id="timer-start" style="min-width: 100px;">Start</button>
      <button class="db-btn db-btn-primary" id="timer-pause" style="display: none; min-width: 100px;">Pause</button>
      <button class="db-btn" id="timer-reset">Reset</button>
    </div>

    <!-- Session counter -->
    <p class="db-mono" style="font-size: 11px; color: var(--db-text-muted); position: relative; z-index: 1;">
      Sessions today &middot; <span id="session-count" style="color: var(--db-accent);">0</span>
    </p>

    <!-- Break message -->
    <div id="break-message" style="display: none; margin-top: 32px; padding: 20px 28px; background: var(--db-accent-soft); border: 1px solid rgba(92, 140, 74, 0.15); border-radius: var(--db-radius-lg); position: relative; z-index: 1;">
      <p class="db-heading" style="font-size: 18px; color: var(--db-accent); margin-bottom: 4px;">Take a break</p>
      <p class="db-mono" style="font-size: 14px; color: var(--db-text-secondary);" id="break-timer">5:00</p>
    </div>

    <!-- Keyboard hints -->
    <div style="position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%); display: flex; gap: 24px; z-index: 1;">
      <span style="font-size: 11px; color: var(--db-text-muted); opacity: 0.5; display: flex; align-items: center; gap: 6px;">
        <kbd style="padding: 3px 8px; border: 1px solid var(--db-border); border-radius: 5px; font-family: 'JetBrains Mono', monospace; font-size: 10px; background: rgba(255,255,255,0.02);">Space</kbd> Start / Pause
      </span>
      <span style="font-size: 11px; color: var(--db-text-muted); opacity: 0.5; display: flex; align-items: center; gap: 6px;">
        <kbd style="padding: 3px 8px; border: 1px solid var(--db-border); border-radius: 5px; font-family: 'JetBrains Mono', monospace; font-size: 10px; background: rgba(255,255,255,0.02);">R</kbd> Reset
      </span>
      <span style="font-size: 11px; color: var(--db-text-muted); opacity: 0.5; display: flex; align-items: center; gap: 6px;">
        <kbd style="padding: 3px 8px; border: 1px solid var(--db-border); border-radius: 5px; font-family: 'JetBrains Mono', monospace; font-size: 10px; background: rgba(255,255,255,0.02);">Esc</kbd> Exit
      </span>
    </div>
  </div>

  <script>
    const WORK_DURATION = 25 * 60;
    const BREAK_DURATION = 5 * 60;

    let timeLeft = WORK_DURATION;
    let isRunning = false;
    let isBreak = false;
    let interval: ReturnType<typeof setInterval> | null = null;

    const timerDisplay = document.getElementById('timer-display')!;
    const timerRing = document.getElementById('timer-ring')!;
    const startBtn = document.getElementById('timer-start')!;
    const pauseBtn = document.getElementById('timer-pause')!;
    const resetBtn = document.getElementById('timer-reset')!;
    const breakMsg = document.getElementById('break-message')!;
    const breakTimer = document.getElementById('break-timer')!;
    const sessionCount = document.getElementById('session-count')!;
    const focusDisplay = document.getElementById('focus-display')!;
    const ambient = document.getElementById('focus-ambient')!;

    focusDisplay.textContent = localStorage.getItem('oakfox_focus') || 'Set a focus on the Command page.';

    function getSessionKey(): string { return 'oakfox_pomodoro_' + new Date().toISOString().split('T')[0]; }
    function getSessions(): number { return parseInt(localStorage.getItem(getSessionKey()) || '0', 10); }
    function addSession() {
      const count = getSessions() + 1;
      localStorage.setItem(getSessionKey(), String(count));
      sessionCount.textContent = String(count);
    }
    sessionCount.textContent = String(getSessions());

    function formatTime(s: number): string {
      const min = Math.floor(s / 60);
      const sec = s % 60;
      return `${String(min).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
    }

    function updateDisplay() {
      if (isBreak) breakTimer.textContent = formatTime(timeLeft);
      else timerDisplay.textContent = formatTime(timeLeft);
    }

    function startTimer() {
      if (isRunning) return;
      isRunning = true;
      startBtn.style.display = 'none';
      pauseBtn.style.display = '';

      if (!isBreak) {
        timerRing.classList.remove('focus-ring-paused');
        timerRing.classList.add('focus-ring');
        timerRing.style.borderColor = 'var(--db-accent)';
        ambient.style.opacity = '1';
      }

      interval = setInterval(() => {
        timeLeft--;
        updateDisplay();
        if (timeLeft <= 0) {
          clearInterval(interval!);
          interval = null;
          isRunning = false;
          if (isBreak) {
            isBreak = false;
            breakMsg.style.display = 'none';
            timeLeft = WORK_DURATION;
            updateDisplay();
            startBtn.style.display = '';
            pauseBtn.style.display = 'none';
          } else {
            addSession();
            isBreak = true;
            timeLeft = BREAK_DURATION;
            timerRing.classList.remove('focus-ring');
            timerRing.classList.add('focus-ring-paused');
            timerRing.style.borderColor = 'var(--db-border)';
            ambient.style.opacity = '0';
            breakMsg.style.display = '';
            startBtn.style.display = '';
            pauseBtn.style.display = 'none';
            updateDisplay();
            startTimer();
          }
        }
      }, 1000);
    }

    function pauseTimer() {
      if (!isRunning) return;
      isRunning = false;
      if (interval) clearInterval(interval);
      interval = null;
      startBtn.style.display = '';
      pauseBtn.style.display = 'none';
      if (!isBreak) {
        timerRing.classList.remove('focus-ring');
        timerRing.classList.add('focus-ring-paused');
      }
    }

    function resetTimer() {
      pauseTimer();
      isBreak = false;
      breakMsg.style.display = 'none';
      timeLeft = WORK_DURATION;
      timerRing.style.borderColor = 'var(--db-border)';
      ambient.style.opacity = '0';
      updateDisplay();
    }

    startBtn.addEventListener('click', startTimer);
    pauseBtn.addEventListener('click', pauseTimer);
    resetBtn.addEventListener('click', resetTimer);

    document.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).tagName === 'INPUT' || (e.target as HTMLElement).tagName === 'TEXTAREA') return;
      if (e.code === 'Space') { e.preventDefault(); if (isRunning) pauseTimer(); else startTimer(); }
      else if (e.key === 'r' || e.key === 'R') { resetTimer(); }
      else if (e.key === 'Escape') { window.location.href = '/dashboard'; }
    });
  </script>
</DashboardLayout>

---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Command Centre">
  <div class="db-fade-in db-stagger">
    <!-- Greeting -->
    <header style="margin-bottom: 40px;">
      <h1 class="db-heading" style="font-size: 32px; margin-bottom: 6px; line-height: 1.3;" id="greeting"></h1>
      <p class="db-mono db-label" id="date-display" style="font-size: 11px;"></p>
    </header>

    <!-- Today's Focus -->
    <div class="db-card" style="margin-bottom: 20px; position: relative; overflow: hidden;">
      <div style="position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--db-accent-glow), transparent);"></div>
      <label class="db-label" style="display: block; margin-bottom: 14px;">Today's Focus</label>
      <input
        type="text"
        id="focus-input"
        class="db-heading"
        placeholder="What's the one thing today?"
        style="background: transparent; border: none; outline: none; width: 100%; font-size: 24px; color: var(--db-text); padding: 0; line-height: 1.3;"
      />
    </div>

    <!-- Stats strip -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 20px;" id="stats-strip">
      <div class="db-stat">
        <span class="db-stat-value" id="stat-open">0</span>
        <span class="db-stat-label">Open today</span>
      </div>
      <div class="db-stat">
        <span class="db-stat-value" id="stat-completed">0</span>
        <span class="db-stat-label">Done this week</span>
      </div>
      <div class="db-stat">
        <span class="db-stat-value" id="stat-projects">0</span>
        <span class="db-stat-label">Active projects</span>
      </div>
      <div class="db-stat">
        <span class="db-stat-value" id="stat-goal-days">&mdash;</span>
        <span class="db-stat-label">Days to next goal</span>
      </div>
    </div>

    <!-- Task Runway Alert -->
    <div id="runway-alert" class="db-card" style="margin-bottom: 20px; display: none; position: relative; overflow: hidden; border-color: rgba(196, 107, 31, 0.3);">
      <div style="position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(196, 107, 31, 0.3), transparent);"></div>
      <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 16px;">
        <div>
          <h2 class="db-heading" style="font-size: 18px; color: var(--db-fox);">Running low on tasks</h2>
          <p style="font-size: 13px; color: var(--db-text-muted); margin-top: 4px;">Your last task is due within 3 days. Here's a summary and a prompt to generate your next batch.</p>
        </div>
        <button class="db-btn db-btn-sm" id="runway-dismiss" style="flex-shrink: 0;">Dismiss</button>
      </div>

      <!-- Summary -->
      <div style="background: rgba(0,0,0,0.2); border-radius: var(--db-radius); padding: 16px; margin-bottom: 14px; max-height: 200px; overflow-y: auto;">
        <p class="db-label" style="margin-bottom: 10px;">Completed tasks</p>
        <div id="runway-summary" style="font-size: 12px; color: var(--db-text-secondary); line-height: 1.8;"></div>
      </div>

      <!-- Prompt -->
      <div style="position: relative;">
        <p class="db-label" style="margin-bottom: 10px;">Prompt — click to copy</p>
        <div id="runway-prompt" style="background: rgba(0,0,0,0.2); border-radius: var(--db-radius); padding: 16px; font-size: 12px; font-family: 'JetBrains Mono', monospace; color: var(--db-text-secondary); line-height: 1.7; cursor: pointer; white-space: pre-wrap; max-height: 250px; overflow-y: auto; border: 1px solid var(--db-border); transition: border-color 0.2s;"></div>
        <span id="runway-copied" style="display: none; position: absolute; top: 8px; right: 12px; font-size: 11px; color: var(--db-accent); font-weight: 600;">Copied!</span>
      </div>
    </div>

    <!-- Projects Pipeline -->
    <div class="db-card" style="margin-bottom: 20px;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
        <h2 class="db-heading" style="font-size: 20px;">Projects</h2>
        <button class="db-btn db-btn-primary db-btn-sm" id="add-project-btn">+ New Project</button>
      </div>
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;" id="pipeline" class="pipeline-grid">
        <div>
          <p class="db-label" style="margin-bottom: 10px; padding-left: 2px;">Lead</p>
          <div class="pipeline-col" data-status="Lead" id="col-lead"></div>
        </div>
        <div>
          <p class="db-label" style="margin-bottom: 10px; padding-left: 2px;">In Progress</p>
          <div class="pipeline-col" data-status="In Progress" id="col-progress"></div>
        </div>
        <div>
          <p class="db-label" style="margin-bottom: 10px; padding-left: 2px;">Review</p>
          <div class="pipeline-col" data-status="Review" id="col-review"></div>
        </div>
        <div>
          <p class="db-label" style="margin-bottom: 10px; padding-left: 2px;">Live</p>
          <div class="pipeline-col" data-status="Live" id="col-live"></div>
        </div>
      </div>
    </div>

    <!-- Archived Projects -->
    <div id="archived-section" class="db-card" style="margin-bottom: 20px; display: none;">
      <button id="archived-toggle" style="display: flex; align-items: center; gap: 8px; background: none; border: none; color: var(--db-text-muted); cursor: pointer; font-size: 13px; font-weight: 600; padding: 0; width: 100%;">
        <svg id="archived-chevron" style="width: 14px; height: 14px; transition: transform 0.2s;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        <span id="archived-label">Archived</span>
      </button>
      <div id="archived-list" style="display: none; margin-top: 14px;"></div>
    </div>

    <!-- To-Do List -->
    <div class="db-card">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
        <h2 class="db-heading" style="font-size: 20px;">Tasks</h2>
        <div class="db-tabs" id="task-filters">
          <button class="db-tab active" data-filter="all">All</button>
          <button class="db-tab" data-filter="active">Active</button>
          <button class="db-tab" data-filter="completed">Done</button>
        </div>
      </div>

      <div style="display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap;" id="add-task-form">
        <input type="text" class="db-input" id="task-title" placeholder="What needs doing?" style="flex: 1; min-width: 200px;" />
        <select class="db-select" id="task-category">
          <option value="Client Work">Client Work</option>
          <option value="Marketing">Marketing</option>
          <option value="Development">Development</option>
          <option value="Admin">Admin</option>
          <option value="Personal">Personal</option>
        </select>
        <input type="date" class="db-input" id="task-date" style="width: auto;" />
        <input type="time" class="db-input" id="task-time" style="width: auto;" />
        <button class="db-btn db-btn-primary" id="add-task-btn">Add</button>
      </div>

      <div id="task-list"></div>
    </div>
  </div>

  <!-- Project modal -->
  <div id="project-modal" style="display: none;">
    <div class="db-modal-overlay">
      <div class="db-modal">
        <h3 id="project-modal-title">New Project</h3>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <input type="text" class="db-input" id="project-name" placeholder="Project / client name" />
          <input type="text" class="db-input" id="project-type" placeholder="Type of work (e.g. Branding, Website)" />
          <select class="db-select" id="project-status">
            <option value="Lead">Lead</option>
            <option value="In Progress">In Progress</option>
            <option value="Review">Review</option>
            <option value="Live">Live</option>
          </select>
          <input type="date" class="db-input" id="project-deadline" />
          <textarea class="db-textarea" id="project-notes" placeholder="Notes..." style="min-height: 80px;"></textarea>
          <div id="live-date-field" style="display: none;">
            <label class="db-label" style="display: block; margin-bottom: 6px; margin-top: 12px;">Go Live Date</label>
            <input type="date" class="db-input" id="project-live-date" />
          </div>
          <div id="pinpoint-fields" style="display: none;">
            <div style="display: flex; gap: 12px; margin-top: 12px;">
              <div style="flex: 1;">
                <label class="db-label" style="display: block; margin-bottom: 6px;">Cost (£)</label>
                <input type="number" class="db-input" id="project-cost" placeholder="0.00" step="0.01" min="0" />
              </div>
              <div style="flex: 1;">
                <label class="db-label" style="display: block; margin-bottom: 6px;">Invoice Status</label>
                <select class="db-select" id="project-invoice-status" style="width: 100%;">
                  <option value="Not Submitted">Not Submitted</option>
                  <option value="Submitted">Submitted</option>
                  <option value="Paid">Paid</option>
                </select>
              </div>
            </div>
          </div>
          <div style="display: flex; gap: 8px; justify-content: flex-end; margin-top: 12px;">
            <button class="db-btn" id="project-cancel">Cancel</button>
            <button class="db-btn db-btn-primary" id="project-save">Save</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // ── Helpers ──
    function getAgency(): string { return localStorage.getItem('oakfox_agency') || 'OakFox'; }

    type Task = {
      id: string; title: string; category: string; agency: string;
      dueDate: string; dueTime: string; completed: boolean; createdAt: string;
    };
    type Project = {
      id: string; name: string; type: string; agency: string;
      status: string; deadline: string; notes: string; createdAt: string;
      cost?: number; invoiceStatus?: string; liveDate?: string;
    };

    function getTasks(): Task[] { try { return JSON.parse(localStorage.getItem('oakfox_tasks') || '[]'); } catch { return []; } }
    function saveTasks(t: Task[]) { localStorage.setItem('oakfox_tasks', JSON.stringify(t)); }
    function getProjects(): Project[] { try { return JSON.parse(localStorage.getItem('oakfox_projects') || '[]'); } catch { return []; } }
    function saveProjects(p: Project[]) { localStorage.setItem('oakfox_projects', JSON.stringify(p)); }

    function getCategoryClass(cat: string): string {
      const map: Record<string, string> = {
        'Client Work': 'db-tag-client', 'Marketing': 'db-tag-marketing',
        'Development': 'db-tag-development', 'Admin': 'db-tag-admin', 'Personal': 'db-tag-personal',
        'Social Media': 'db-tag-marketing',
      };
      return map[cat] || 'db-tag-admin';
    }

    function todayStr(): string { return new Date().toISOString().split('T')[0]; }
    function startOfWeek(): Date {
      const d = new Date(); const day = d.getDay();
      const diff = d.getDate() - day + (day === 0 ? -6 : 1);
      const mon = new Date(d); mon.setDate(diff); mon.setHours(0,0,0,0); return mon;
    }

    // ── Greeting ──
    (function() {
      const hour = new Date().getHours();
      let g = 'Good evening';
      if (hour < 12) g = 'Good morning';
      else if (hour < 18) g = 'Good afternoon';
      document.getElementById('greeting')!.textContent = `${g}, Nathan.`;
      document.getElementById('date-display')!.textContent = new Date().toLocaleDateString('en-GB', {
        weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
      });
    })();

    // ── Focus ──
    const focusInput = document.getElementById('focus-input') as HTMLInputElement;
    focusInput.value = localStorage.getItem('oakfox_focus') || '';
    focusInput.addEventListener('input', () => localStorage.setItem('oakfox_focus', focusInput.value));

    // ── Pre-populate OakFox startup tasks (once) ──
    function seedOakFoxTasks() {
      if (localStorage.getItem('oakfox_seeded')) return;
      const seeds = [
        { title: 'Set up LinkedIn company page for OakFox', category: 'Marketing', days: 0 },
        { title: 'Create and optimise Google Business Profile', category: 'Marketing', days: 1 },
        { title: 'Design social media templates (Instagram, LinkedIn, X)', category: 'Marketing', days: 3 },
        { title: 'Write and schedule first 2 weeks of social media content', category: 'Marketing', days: 5 },
        { title: 'Plan monthly content calendar framework', category: 'Marketing', days: 7 },
        { title: 'Set up email signature with branding and links', category: 'Admin', days: 0 },
        { title: 'Create client proposal/quote template', category: 'Admin', days: 2 },
        { title: 'Set up invoicing system (Xero, Stripe, or similar)', category: 'Admin', days: 3 },
        { title: 'Write client onboarding process document', category: 'Admin', days: 5 },
        { title: 'Create brand guidelines PDF for OakFox', category: 'Development', days: 7 },
        { title: 'Set up Google Analytics on oakfox.co.uk', category: 'Development', days: 1 },
        { title: 'Submit site to Google Search Console', category: 'Development', days: 1 },
        { title: 'Register on local business directories (Yell, Thomson, etc.)', category: 'Marketing', days: 4 },
        { title: 'Connect with 20 local businesses on LinkedIn', category: 'Marketing', days: 7 },
        { title: 'Write launch announcement blog post', category: 'Marketing', days: 3 },
        { title: 'Set up Mailchimp or newsletter tool', category: 'Marketing', days: 5 },
        { title: 'Create a portfolio case study PDF for outreach', category: 'Marketing', days: 10 },
        { title: 'Research and join relevant Slack/Discord communities', category: 'Marketing', days: 7 },
        { title: 'Set up project management workflow (Notion, Linear, or similar)', category: 'Admin', days: 2 },
        { title: 'Draft terms of service and privacy policy', category: 'Admin', days: 10 },
      ];

      const now = new Date();
      const tasks = getTasks();
      seeds.forEach(s => {
        const due = new Date(now);
        due.setDate(due.getDate() + s.days);
        tasks.push({
          id: crypto.randomUUID(),
          title: s.title,
          category: s.category,
          agency: 'OakFox',
          dueDate: due.toISOString().split('T')[0],
          dueTime: '',
          completed: false,
          createdAt: now.toISOString(),
        });
      });
      saveTasks(tasks);

      // Seed projects
      const projects = getProjects();
      const existingProjects = [
        { name: 'CubTrack', type: 'Product / Development', status: 'Live', deadline: '2025-09-01' },
        { name: 'Aigéan Restaurant', type: 'Branding / Consultancy', status: 'Live', deadline: '2024-06-15' },
        { name: 'Roll Bakery', type: 'Branding / Consultancy', status: 'Live', deadline: '2024-03-10' },
        { name: 'Jennifer Lane', type: 'Website Redesign', status: 'Live', deadline: '2026-03-11' },
      ];
      existingProjects.forEach(p => {
        projects.push({
          id: crypto.randomUUID(),
          name: p.name,
          type: p.type,
          agency: 'OakFox',
          status: p.status,
          deadline: p.deadline,
          notes: '',
          createdAt: now.toISOString(),
          liveDate: p.status === 'Live' ? p.deadline : undefined,
        });
      });
      saveProjects(projects);

      localStorage.setItem('oakfox_seeded', 'true');
    }
    seedOakFoxTasks();

    // ── Social media plan generator ──
    function generateSocialPlan(project: Project) {
      const tasks = getTasks();
      const liveDate = todayStr();
      const prefix = `[${project.name}]`;

      // Check if already generated
      if (tasks.some(t => t.title.startsWith(prefix) && t.category === 'Social Media')) return;

      const plan = [
        { title: `${prefix} Write launch announcement post (LinkedIn)`, days: 0 },
        { title: `${prefix} Design launch graphic for Instagram`, days: 0 },
        { title: `${prefix} Publish launch post across all platforms`, days: 1 },
        { title: `${prefix} Share behind-the-scenes / process shots`, days: 3 },
        { title: `${prefix} Write case study blog post`, days: 5 },
        { title: `${prefix} Share case study on LinkedIn with key takeaways`, days: 6 },
        { title: `${prefix} Create short-form video walkthrough (Reels/TikTok)`, days: 7 },
        { title: `${prefix} Client testimonial post`, days: 10 },
        { title: `${prefix} Add to portfolio and share updated portfolio link`, days: 2 },
        { title: `${prefix} One-month follow-up post with results/impact`, days: 30 },
      ];

      const now = new Date();
      plan.forEach(p => {
        const due = new Date(now);
        due.setDate(due.getDate() + p.days);
        tasks.push({
          id: crypto.randomUUID(),
          title: p.title,
          category: 'Social Media',
          agency: project.agency,
          dueDate: due.toISOString().split('T')[0],
          dueTime: '',
          completed: false,
          createdAt: now.toISOString(),
        });
      });
      saveTasks(tasks);
    }

    // ── Projects Pipeline ──
    let editingProjectId: string | null = null;

    function isArchived(p: Project): boolean {
      if (p.status !== 'Live' || !p.liveDate) return false;
      const daysSinceLive = Math.floor((Date.now() - new Date(p.liveDate).getTime()) / 86400000);
      return daysSinceLive >= 7;
    }

    function renderProjects() {
      const agency = getAgency();
      const allAgencyProjects = getProjects().filter(p => p.agency === agency);
      const projects = allAgencyProjects.filter(p => !isArchived(p));
      const archived = allAgencyProjects.filter(p => isArchived(p));
      const statuses = ['Lead', 'In Progress', 'Review', 'Live'];
      const colIds = ['col-lead', 'col-progress', 'col-review', 'col-live'];

      statuses.forEach((status, i) => {
        const col = document.getElementById(colIds[i])!;
        const items = projects.filter(p => p.status === status);
        if (items.length === 0) {
          col.innerHTML = `<div style="padding: 16px 8px; text-align: center; color: var(--db-text-muted); font-size: 11px; opacity: 0.5;">No projects</div>`;
        } else {
          col.innerHTML = items.map(p => {
            const daysLeft = p.deadline ? Math.ceil((new Date(p.deadline).getTime() - Date.now()) / 86400000) : null;
            const daysLabel = daysLeft !== null
              ? (daysLeft < 0 ? `<span style="color: var(--db-danger);">${Math.abs(daysLeft)}d ago</span>` : `${daysLeft}d`)
              : '';
            const isPinpoint = agency === 'Pinpoint';
            const costLine = isPinpoint && p.cost
              ? `<span class="db-mono" style="font-size: 11px; color: var(--db-text-secondary);">£${Number(p.cost).toFixed(2)}</span>`
              : '';
            const invoiceBadge = isPinpoint && p.invoiceStatus
              ? `<span class="db-tag ${p.invoiceStatus === 'Paid' ? 'db-tag-client' : p.invoiceStatus === 'Submitted' ? 'db-tag-marketing' : 'db-tag-admin'}" style="font-size: 9px;">${p.invoiceStatus}</span>`
              : '';
            return `
              <div class="db-project-card" data-id="${p.id}">
                <div style="font-size: 13px; font-weight: 600; margin-bottom: 4px;">${p.name}</div>
                <div style="font-size: 11px; color: var(--db-text-muted); margin-bottom: 6px;">${p.type}</div>
                ${isPinpoint ? `<div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">${costLine}${invoiceBadge}</div>` : ''}
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  ${daysLabel ? `<span class="db-mono" style="font-size: 10px; color: var(--db-text-muted);">${daysLabel}</span>` : '<span></span>'}
                  <div style="display: flex; gap: 2px;">
                    ${status !== 'Lead' ? `<button class="db-btn db-btn-ghost db-btn-sm project-move-left" data-id="${p.id}" style="padding: 3px 6px; font-size: 10px;">&larr;</button>` : ''}
                    ${status !== 'Live' ? `<button class="db-btn db-btn-ghost db-btn-sm project-move-right" data-id="${p.id}" style="padding: 3px 6px; font-size: 10px;">&rarr;</button>` : ''}
                  </div>
                </div>
              </div>
            `;
          }).join('');
        }
      });

      // Bind click events
      document.querySelectorAll('.db-project-card').forEach(card => {
        card.addEventListener('dblclick', () => {
          const id = card.getAttribute('data-id')!;
          openProjectModal(id);
        });
      });

      document.querySelectorAll('.project-move-left, .project-move-right').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = btn.getAttribute('data-id')!;
          const direction = btn.classList.contains('project-move-right') ? 1 : -1;
          const projects = getProjects();
          const project = projects.find(p => p.id === id);
          if (!project) return;
          const order = ['Lead', 'In Progress', 'Review', 'Live'];
          const idx = order.indexOf(project.status);
          const newIdx = idx + direction;
          if (newIdx < 0 || newIdx >= order.length) return;
          const oldStatus = project.status;
          project.status = order[newIdx];
          if (project.status === 'Live' && oldStatus !== 'Live') {
            project.liveDate = todayStr();
          }
          if (project.status !== 'Live') {
            project.liveDate = undefined;
          }
          saveProjects(projects);

          // Auto-generate social plan when moved to Live
          if (project.status === 'Live' && oldStatus !== 'Live') {
            generateSocialPlan(project);
            renderTasks();
          }
          renderProjects();
          updateStats();
        });
      });

      // Render archived section
      const archivedSection = document.getElementById('archived-section')!;
      archived.sort((a, b) => (b.liveDate || '').localeCompare(a.liveDate || ''));
      if (archived.length > 0) {
        archivedSection.style.display = '';
        document.getElementById('archived-label')!.textContent = `Archived (${archived.length})`;
        const archivedList = document.getElementById('archived-list')!;
        archivedList.innerHTML = archived.map(p => `
          <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--db-border-subtle);" class="archived-row">
            <div style="flex: 1; min-width: 0;">
              <span style="font-size: 13px; font-weight: 500;">${p.name}</span>
              <span style="font-size: 11px; color: var(--db-text-muted); margin-left: 8px;">${p.type}</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="db-mono" style="font-size: 10px; color: var(--db-text-muted);">Live ${p.liveDate || ''}</span>
              <button class="db-btn db-btn-ghost db-btn-sm archived-edit" data-id="${p.id}" style="padding: 3px 8px; font-size: 11px;">Edit</button>
              <button class="db-btn db-btn-ghost db-btn-sm archived-delete" data-id="${p.id}" style="padding: 3px 8px; font-size: 11px; color: var(--db-danger);">&times;</button>
            </div>
          </div>
        `).join('');

        // Bind archived edit/delete
        archivedList.querySelectorAll('.archived-edit').forEach(btn => {
          btn.addEventListener('click', () => {
            openProjectModal(btn.getAttribute('data-id')!);
          });
        });
        archivedList.querySelectorAll('.archived-delete').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id')!;
            if (!confirm('Delete this archived project?')) return;
            saveProjects(getProjects().filter(p => p.id !== id));
            renderProjects();
          });
        });
      } else {
        archivedSection.style.display = 'none';
      }

      updateStats();
    }

    // Archived toggle
    let archivedOpen = false;
    document.getElementById('archived-toggle')!.addEventListener('click', () => {
      archivedOpen = !archivedOpen;
      document.getElementById('archived-list')!.style.display = archivedOpen ? '' : 'none';
      (document.getElementById('archived-chevron') as HTMLElement).style.transform = archivedOpen ? 'rotate(90deg)' : '';
    });

    function openProjectModal(id?: string) {
      const isPinpoint = getAgency() === 'Pinpoint';
      document.getElementById('pinpoint-fields')!.style.display = isPinpoint ? '' : 'none';

      if (id) {
        editingProjectId = id;
        const p = getProjects().find(x => x.id === id);
        if (!p) return;
        (document.getElementById('project-name') as HTMLInputElement).value = p.name;
        (document.getElementById('project-type') as HTMLInputElement).value = p.type;
        (document.getElementById('project-status') as HTMLSelectElement).value = p.status;
        (document.getElementById('project-deadline') as HTMLInputElement).value = p.deadline;
        (document.getElementById('project-notes') as HTMLTextAreaElement).value = p.notes;
        (document.getElementById('project-cost') as HTMLInputElement).value = p.cost ? String(p.cost) : '';
        (document.getElementById('project-invoice-status') as HTMLSelectElement).value = p.invoiceStatus || 'Not Submitted';
        (document.getElementById('project-live-date') as HTMLInputElement).value = p.liveDate || '';
        document.getElementById('live-date-field')!.style.display = p.status === 'Live' ? '' : 'none';
        document.getElementById('project-modal-title')!.textContent = 'Edit Project';
      } else {
        editingProjectId = null;
        (document.getElementById('project-name') as HTMLInputElement).value = '';
        (document.getElementById('project-type') as HTMLInputElement).value = '';
        (document.getElementById('project-status') as HTMLSelectElement).value = 'Lead';
        (document.getElementById('project-deadline') as HTMLInputElement).value = '';
        (document.getElementById('project-notes') as HTMLTextAreaElement).value = '';
        (document.getElementById('project-cost') as HTMLInputElement).value = '';
        (document.getElementById('project-invoice-status') as HTMLSelectElement).value = 'Not Submitted';
        (document.getElementById('project-live-date') as HTMLInputElement).value = '';
        document.getElementById('live-date-field')!.style.display = 'none';
        document.getElementById('project-modal-title')!.textContent = 'New Project';
      }

      // Show/hide live date field when status changes
      const statusSelect = document.getElementById('project-status') as HTMLSelectElement;
      statusSelect.onchange = () => {
        document.getElementById('live-date-field')!.style.display = statusSelect.value === 'Live' ? '' : 'none';
      };

      document.getElementById('project-modal')!.style.display = 'block';
      (document.getElementById('project-name') as HTMLInputElement).focus();
    }

    document.getElementById('add-project-btn')!.addEventListener('click', () => openProjectModal());
    document.getElementById('project-cancel')!.addEventListener('click', () => {
      document.getElementById('project-modal')!.style.display = 'none';
    });

    document.getElementById('project-save')!.addEventListener('click', () => {
      const name = (document.getElementById('project-name') as HTMLInputElement).value.trim();
      if (!name) return;
      const projects = getProjects();
      const costVal = (document.getElementById('project-cost') as HTMLInputElement).value;
      const status = (document.getElementById('project-status') as HTMLSelectElement).value;
      const liveDateVal = (document.getElementById('project-live-date') as HTMLInputElement).value;

      // When editing, preserve existing liveDate if the field is empty
      const existingProject = editingProjectId ? projects.find(x => x.id === editingProjectId) : null;
      let liveDate: string | undefined;
      if (status === 'Live') {
        liveDate = liveDateVal || (existingProject?.liveDate) || todayStr();
      } else {
        liveDate = undefined;
      }

      const data: Partial<Project> = {
        name,
        type: (document.getElementById('project-type') as HTMLInputElement).value.trim(),
        status,
        deadline: (document.getElementById('project-deadline') as HTMLInputElement).value,
        notes: (document.getElementById('project-notes') as HTMLTextAreaElement).value,
        cost: costVal ? parseFloat(costVal) : undefined,
        invoiceStatus: (document.getElementById('project-invoice-status') as HTMLSelectElement).value,
        liveDate,
      };

      if (editingProjectId) {
        const p = projects.find(x => x.id === editingProjectId);
        if (p) {
          const oldStatus = p.status;
          Object.assign(p, data);
          if (p.status === 'Live' && oldStatus !== 'Live') {
            generateSocialPlan(p);
            renderTasks();
          }
        }
      } else {
        const newProject: Project = {
          id: crypto.randomUUID(),
          ...data,
          agency: getAgency(),
          createdAt: new Date().toISOString(),
        };
        projects.push(newProject);
        if (newProject.status === 'Live') {
          generateSocialPlan(newProject);
          renderTasks();
        }
      }

      saveProjects(projects);
      document.getElementById('project-modal')!.style.display = 'none';
      renderProjects();
    });

    document.getElementById('project-name')!.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') document.getElementById('project-save')!.click();
    });

    // ── Tasks ──
    let currentFilter = 'all';

    function renderTasks() {
      const agency = getAgency();
      const allTasks = getTasks().filter(t => (t.agency || 'OakFox') === agency);
      const list = document.getElementById('task-list')!;
      const active = allTasks.filter(t => !t.completed);
      const completed = allTasks.filter(t => t.completed);

      const sortByDate = (a: Task, b: Task) => {
        const da = a.dueDate || '9999-12-31';
        const db = b.dueDate || '9999-12-31';
        return da.localeCompare(db);
      };

      let filtered: Task[];
      if (currentFilter === 'active') filtered = active.sort(sortByDate);
      else if (currentFilter === 'completed') filtered = completed.sort(sortByDate);
      else filtered = [...active.sort(sortByDate), ...completed.sort(sortByDate)];

      if (filtered.length === 0) {
        list.innerHTML = `<div style="text-align: center; padding: 48px 0;">
          <p style="color: var(--db-text-muted); font-size: 13px;">No tasks for ${agency}.</p>
        </div>`;
      } else {
        const today = todayStr();
        list.innerHTML = filtered.map(task => {
          const checked = task.completed ? 'checked' : '';
          const strikeClass = task.completed ? 'db-line-through' : '';
          const isOverdue = !task.completed && task.dueDate && task.dueDate < today;
          const dateColor = isOverdue ? 'var(--db-danger)' : 'var(--db-text-muted)';
          const dateDisplay = task.dueDate
            ? `<span class="db-mono" style="font-size: 10px; color: ${dateColor};">${isOverdue ? 'Overdue · ' : ''}${task.dueDate}${task.dueTime ? ' · ' + task.dueTime : ''}</span>`
            : '';
          const rowBorder = isOverdue ? 'border-left: 2px solid var(--db-danger); padding-left: 12px; margin-left: -14px;' : '';
          return `
            <div class="task-row" data-id="${task.id}" style="${rowBorder}">
              <input type="checkbox" class="db-checkbox task-check" data-id="${task.id}" ${checked} />
              <div style="flex: 1; min-width: 0;">
                <span class="${strikeClass}" style="font-size: 14px; font-weight: 500; ${isOverdue ? 'color: var(--db-danger);' : ''}">${task.title}</span>
                <div style="display: flex; gap: 8px; align-items: center; margin-top: 5px;">
                  <span class="db-tag ${getCategoryClass(task.category)}">${task.category}</span>
                  ${dateDisplay}
                </div>
              </div>
              <button class="task-delete" data-id="${task.id}" style="background: none; border: none; color: var(--db-text-muted); cursor: pointer; padding: 6px; font-size: 18px; opacity: 0; transition: all 0.2s; border-radius: 6px; line-height: 1;">&times;</button>
            </div>
          `;
        }).join('');

        list.querySelectorAll('.task-row').forEach(row => {
          const btn = row.querySelector('.task-delete') as HTMLElement;
          row.addEventListener('mouseenter', () => { btn.style.opacity = '1'; });
          row.addEventListener('mouseleave', () => { btn.style.opacity = '0'; });
        });
      }
      updateStats();
      if (typeof checkRunway === 'function') checkRunway();
    }

    function updateStats() {
      const agency = getAgency();
      const tasks = getTasks().filter(t => (t.agency || 'OakFox') === agency);
      const projects = getProjects().filter(p => p.agency === agency);
      const today = todayStr();
      const weekStart = startOfWeek();

      document.getElementById('stat-open')!.textContent = String(tasks.filter(t => !t.completed && (!t.dueDate || t.dueDate <= today)).length);
      document.getElementById('stat-completed')!.textContent = String(tasks.filter(t => t.completed && new Date(t.createdAt) >= weekStart).length);
      document.getElementById('stat-projects')!.textContent = String(projects.filter(p => p.status === 'In Progress' || p.status === 'Review').length);

      try {
        const goals = JSON.parse(localStorage.getItem('oakfox_goals') || '[]');
        const upcoming = goals
          .filter((g: any) => g.status !== 'Done' && g.targetDate)
          .map((g: any) => ({ ...g, _days: Math.ceil((new Date(g.targetDate).getTime() - Date.now()) / 86400000) }))
          .filter((g: any) => g._days >= 0)
          .sort((a: any, b: any) => a._days - b._days);
        document.getElementById('stat-goal-days')!.textContent = upcoming.length > 0 ? String(upcoming[0]._days) : '\u2014';
      } catch { document.getElementById('stat-goal-days')!.textContent = '\u2014'; }
    }

    // Add task
    document.getElementById('add-task-btn')!.addEventListener('click', () => {
      const titleInput = document.getElementById('task-title') as HTMLInputElement;
      const title = titleInput.value.trim();
      if (!title) return;
      const tasks = getTasks();
      tasks.push({
        id: crypto.randomUUID(), title,
        category: (document.getElementById('task-category') as HTMLSelectElement).value,
        agency: getAgency(),
        dueDate: (document.getElementById('task-date') as HTMLInputElement).value,
        dueTime: (document.getElementById('task-time') as HTMLInputElement).value,
        completed: false, createdAt: new Date().toISOString(),
      });
      saveTasks(tasks);
      titleInput.value = '';
      (document.getElementById('task-date') as HTMLInputElement).value = '';
      (document.getElementById('task-time') as HTMLInputElement).value = '';
      renderTasks();
    });

    document.getElementById('task-title')!.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') document.getElementById('add-task-btn')!.click();
    });

    document.getElementById('task-list')!.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains('task-check')) {
        const id = target.getAttribute('data-id');
        const tasks = getTasks();
        const task = tasks.find(t => t.id === id);
        if (task) task.completed = !task.completed;
        saveTasks(tasks);
        renderTasks();
      }
      if (target.classList.contains('task-delete')) {
        const id = target.getAttribute('data-id');
        saveTasks(getTasks().filter(t => t.id !== id));
        renderTasks();
      }
    });

    document.getElementById('task-filters')!.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.db-tab') as HTMLElement | null;
      if (!btn) return;
      document.querySelectorAll('#task-filters .db-tab').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.getAttribute('data-filter') || 'all';
      renderTasks();
    });

    // ── Task Runway Check ──
    let runwayDismissed = false;

    function checkRunway() {
      if (runwayDismissed) return;
      const agency = getAgency();
      const allTasks = getTasks().filter(t => (t.agency || 'OakFox') === agency);
      const active = allTasks.filter(t => !t.completed && t.dueDate);
      const completed = allTasks.filter(t => t.completed);
      const projects = getProjects().filter(p => p.agency === agency);
      const alert = document.getElementById('runway-alert')!;

      if (active.length === 0 && completed.length === 0) {
        alert.style.display = 'none';
        return;
      }

      // Find the last active task's due date
      const lastDate = active
        .map(t => t.dueDate)
        .sort((a, b) => b.localeCompare(a))[0];

      if (!lastDate) { alert.style.display = 'none'; return; }

      const daysToLast = Math.ceil((new Date(lastDate).getTime() - Date.now()) / 86400000);

      if (daysToLast > 3 || active.length === 0) {
        alert.style.display = 'none';
        return;
      }

      alert.style.display = '';

      // Build summary
      const summaryEl = document.getElementById('runway-summary')!;
      const completedByCategory: Record<string, string[]> = {};
      completed.forEach(t => {
        if (!completedByCategory[t.category]) completedByCategory[t.category] = [];
        completedByCategory[t.category].push(t.title);
      });

      let summaryHtml = '';
      for (const [cat, tasks] of Object.entries(completedByCategory)) {
        summaryHtml += `<div style="margin-bottom: 8px;"><span class="db-tag ${getCategoryClass(cat)}" style="margin-bottom: 4px;">${cat}</span><br/>`;
        summaryHtml += tasks.map(t => `<span style="color: var(--db-text-muted);">✓</span> ${t}`).join('<br/>');
        summaryHtml += '</div>';
      }
      summaryEl.innerHTML = summaryHtml || '<p style="color: var(--db-text-muted);">No completed tasks yet.</p>';

      // Build remaining
      const remaining = active.map(t => `• ${t.title} (due ${t.dueDate})`).join('\n');

      // Build project context
      const activeProjects = projects.filter(p => p.status !== 'Live' || !isArchived(p));
      const projectContext = activeProjects.length > 0
        ? activeProjects.map(p => `• ${p.name} — ${p.type} (${p.status})`).join('\n')
        : 'No active projects.';

      // Build prompt
      const prompt = `I'm Nathan, founder of OakFox — a sustainable design, development, and marketing agency in West Lancashire, UK. I'm using a private dashboard to manage my agency tasks.

Here's what I've completed so far for ${agency}:

${Object.entries(completedByCategory).map(([cat, tasks]) => `${cat}:\n${tasks.map(t => `  ✓ ${t}`).join('\n')}`).join('\n\n')}

Still remaining:
${remaining || 'None — all tasks are done.'}

Current active projects:
${projectContext}

Based on what I've done and where I am, generate my next batch of 15–20 tasks to keep building momentum for ${agency}. Each task should have:
- A clear, actionable title
- A category (Client Work, Marketing, Development, Admin, or Personal)
- A suggested due date relative to today (${todayStr()})

Focus on the logical next steps — things I should be doing now that the foundational work is largely done. Think about growth, outreach, content, client acquisition, and operational maturity.

Format each task as:
Title | Category | YYYY-MM-DD`;

      const promptEl = document.getElementById('runway-prompt')!;
      promptEl.textContent = prompt;
    }

    // Copy prompt
    document.getElementById('runway-prompt')!.addEventListener('click', async () => {
      const text = document.getElementById('runway-prompt')!.textContent || '';
      await navigator.clipboard.writeText(text);
      const copied = document.getElementById('runway-copied')!;
      copied.style.display = '';
      setTimeout(() => { copied.style.display = 'none'; }, 2000);
    });

    // Dismiss
    document.getElementById('runway-dismiss')!.addEventListener('click', () => {
      runwayDismissed = true;
      document.getElementById('runway-alert')!.style.display = 'none';
    });

    // ── Agency change listener ──
    window.addEventListener('agencychange', () => {
      runwayDismissed = false;
      renderTasks();
      renderProjects();
      checkRunway();
    });

    // ── Initial render ──
    renderTasks();
    renderProjects();
  </script>

  <style>
    .db-project-card {
      background: rgba(0, 0, 0, 0.2);
      border: 1px solid var(--db-border);
      border-radius: var(--db-radius);
      padding: 12px;
      margin-bottom: 6px;
      cursor: default;
      transition: border-color 0.2s;
    }
    .db-project-card:hover {
      border-color: rgba(255, 255, 255, 0.1);
    }
    .pipeline-col {
      min-height: 80px;
      border-radius: var(--db-radius);
      background: rgba(0, 0, 0, 0.1);
      padding: 6px;
    }
    @media (max-width: 640px) {
      #stats-strip { grid-template-columns: repeat(2, 1fr) !important; }
      .pipeline-grid { grid-template-columns: 1fr !important; }
      #add-task-form { flex-direction: column; }
      #add-task-form .db-input,
      #add-task-form .db-select { width: 100% !important; min-width: 0 !important; }
    }
  </style>
</DashboardLayout>

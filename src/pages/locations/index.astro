---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageUrl = 'https://oakfox.co.uk/locations';

const webPage = {
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: 'Locations — Where OakFox Works in the UK',
  description:
    'OakFox works with businesses across the UK — locally in West Lancashire (Ormskirk, Burscough, Southport), regionally across Manchester, Preston, and Liverpool, and remotely across the UK, Ireland, and Europe.',
  inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://oakfox.co.uk/#website' },
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: pageUrl },
  ],
};

const locations = [
  {
    name: 'Ormskirk',
    slug: 'ormskirk',
    blurb:
      'Our closest town — ten minutes from the studio. Independent retailers, hospitality, and professional services along Burscough Street.',
  },
  {
    name: 'Burscough',
    slug: 'burscough',
    blurb:
      'Home to the studio at Martland Mill. Independent food producers, maker studios, and village hospitality.',
  },
  {
    name: 'Southport',
    slug: 'southport',
    blurb:
      'Coastal town twenty minutes west. Hospitality, retail, cultural institutions, and a growing independent scene.',
  },
  {
    name: 'Preston',
    slug: 'preston',
    blurb:
      'Lancashire\'s city — thirty minutes north. Professional services, universities, creative businesses.',
  },
  {
    name: 'Manchester',
    slug: 'manchester',
    blurb:
      'Forty-five minutes east. Creative industries, independent hospitality, B2B software, cultural organisations.',
  },
  {
    name: 'Lancashire',
    slug: 'lancashire',
    blurb:
      'The county we call home. From the Ribble Valley to the West Coast, we work with businesses across Lancashire.',
  },
];
---

<BaseLayout
  title="Locations — Where We Work in the UK"
  description="OakFox works with businesses across the UK — locally in West Lancashire (Ormskirk, Burscough, Southport), regionally across Manchester, Preston, and Lancashire, and remotely across the UK, Ireland, and Europe."
  schema={[webPage, breadcrumbs]}
>
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="hero-glow" style="top: 45%;"></div>
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <h1 class="headline text-ink max-w-4xl" style="font-size: clamp(2rem, 5.5vw, 4.5rem);">
        Working <em class="text-forest">across Lancashire</em>.
        Delivering <em class="text-forest">across the UK</em>.
      </h1>
      <div class="mt-10 md:mt-14 grid md:grid-cols-12 gap-8">
        <p class="md:col-span-7 text-[15px] md:text-base text-ink/65 leading-relaxed">
          OakFox is based at Martland Mill, Burscough, in rural West Lancashire
          — between Ormskirk and Southport, forty-five minutes from central
          Manchester, and thirty minutes from Preston or Liverpool. Most of
          our work is delivered remotely, with in-person visits for brand
          discovery, photography, installations, and launches. The locations
          below are where we know the ground best.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <p class="label text-gray mb-10 md:mb-14">Where we work</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
        {locations.map((l) => (
          <a href={`/locations/${l.slug}`} class="reveal group block border-t border-stone pt-6 hover:border-forest transition-colors duration-500">
            <h2 class="headline text-xl md:text-2xl mb-3 group-hover:text-forest transition-colors duration-500">
              {l.name}
            </h2>
            <p class="text-[14px] text-ink/65 leading-relaxed mb-4">{l.blurb}</p>
            <span class="inline-flex items-center gap-2 text-[13px] font-medium text-forest/80 group-hover:text-forest transition-colors duration-300">
              See local services
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 md:py-40 border-t border-stone relative overflow-hidden">
    <div class="hero-glow" style="top: 50%;"></div>
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <div class="reveal max-w-2xl">
        <h2 class="headline text-3xl md:text-4xl lg:text-5xl">
          We work <em class="text-forest">UK-wide</em>. And beyond.
        </h2>
        <p class="mt-6 text-[15px] text-ink/65 leading-relaxed max-w-lg">
          Clients in the Lake District, Dublin, Edinburgh, London and Cornwall
          have all collaborated with us remotely. Send a few lines about your
          project — location is rarely the constraint.
        </p>
        <a href="/contact" class="inline-flex items-center gap-3 mt-10 text-[13px] font-medium text-forest group">
          Start a conversation
          <span class="w-10 h-10 rounded-full border border-forest/30 flex items-center justify-center transition-all duration-500 group-hover:bg-forest group-hover:text-cream">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

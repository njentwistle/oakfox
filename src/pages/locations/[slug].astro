---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locations, type Location } from '../../data/locations';

export async function getStaticPaths() {
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const pageUrl = `https://oakfox.co.uk/locations/${location.slug}`;

const services = [
  { label: 'Branding', href: '/services/branding', keyword: `branding agency ${location.name}` },
  { label: 'Web Design', href: '/services/web-design', keyword: `web design ${location.name}` },
  { label: 'Development', href: '/services/development', keyword: `web developer ${location.name}` },
  { label: 'Marketing', href: '/services/marketing', keyword: `marketing agency ${location.name}` },
  { label: 'Copywriting', href: '/services/copywriting', keyword: `copywriter ${location.name}` },
  { label: 'Green Web Hosting', href: '/services/green-web-hosting', keyword: `green web hosting ${location.name}` },
];

const webPage = {
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: `Design Studio Serving ${location.name} — OakFox`,
  description: `Branding, web design, development, marketing, copywriting, and green web hosting for businesses in ${location.name}, ${location.region}.`,
  inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://oakfox.co.uk/#website' },
  about: { '@id': 'https://oakfox.co.uk/#organization' },
};

const place = {
  '@type': 'Place',
  '@id': `${pageUrl}#place`,
  name: location.name,
  address: {
    '@type': 'PostalAddress',
    addressLocality: location.name,
    addressRegion: location.region,
    postalCode: location.postcode,
    addressCountry: 'GB',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: location.geo.lat,
    longitude: location.geo.lng,
  },
};

const serviceArea = {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: `OakFox — Design, Development & Marketing Services in ${location.name}`,
  provider: { '@id': 'https://oakfox.co.uk/#organization' },
  serviceType: 'Branding, web design, web development, marketing, copywriting, and green web hosting',
  areaServed: { '@id': `${pageUrl}#place` },
  description: `OakFox provides sustainable branding, web design, development, marketing, copywriting, and green web hosting for businesses in ${location.name} and the surrounding ${location.region} area.`,
  url: pageUrl,
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: 'https://oakfox.co.uk/locations' },
    { '@type': 'ListItem', position: 3, name: location.name, item: pageUrl },
  ],
};

const faqs = [
  {
    q: `Do you work with businesses in ${location.name}?`,
    a: `Yes. ${location.name} is ${location.distance} — we work with local clients on brand identity, website design, development, marketing, copywriting, and green web hosting. ${location.description.split('.').slice(0, 2).join('.')}.`,
  },
  {
    q: `How does working with a ${location.name} design studio compare to a London or Manchester agency?`,
    a: `You get the principal on the work, not an account manager routing briefs to a pool of juniors. Costs are typically 30–50% lower than equivalent London agencies for equivalent quality, turnaround is faster because decisions are not staged through multiple layers, and the person who quoted you is the person you work with from start to finish.`,
  },
  {
    q: `Can we meet in person in ${location.name}?`,
    a: `Yes. ${location.distance === '0 minutes — our base' ? 'We are based in Burscough itself — studio visits take minutes.' : `${location.name} is ${location.distance}. We visit in person for brand discovery workshops, photography and shoots, milestone reviews, and launches.`} Day-to-day delivery happens remotely so timelines are not held up by travel.`,
  },
  {
    q: `Which sectors do you know best in ${location.name}?`,
    a: `We have worked most with ${location.sectors.slice(0, 3).join(', ').toLowerCase()} in and around ${location.name}. That said, the principles — considered branding, accessible web design, honest marketing — travel well across sectors.`,
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={`Web Design & Branding Agency in ${location.name}`}
  description={`Web design, branding, development, and marketing for businesses in ${location.name}, ${location.region}. OakFox is a sustainable design studio ${location.distance} from our Burscough base — independent, considered, no juniors.`}
  schema={[webPage, place, serviceArea, breadcrumbs, faqSchema]}
>
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="hero-glow" style="top: 45%;"></div>
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <p class="label text-forest mb-8">
        <a href="/locations" class="hover:text-ink transition-colors duration-300">Locations</a>
        <span class="text-ink/40 mx-2">·</span>
        {location.name}
      </p>
      <h1 class="headline text-ink max-w-4xl" style="font-size: clamp(2rem, 5.5vw, 4.5rem);">
        Web design &amp; branding for <em class="text-forest">{location.name}</em> businesses.
      </h1>
      <div class="mt-10 md:mt-14 grid md:grid-cols-12 gap-8">
        <p class="md:col-span-7 text-[15px] md:text-base text-ink/65 leading-relaxed">
          {location.description}
        </p>
      </div>
      <dl class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-10 border-t border-stone pt-8">
        <div>
          <dt class="label text-gray mb-2">Region</dt>
          <dd class="text-[15px] text-ink/85">{location.region}</dd>
        </div>
        <div>
          <dt class="label text-gray mb-2">Postcode area</dt>
          <dd class="text-[15px] text-ink/85">{location.postcode}</dd>
        </div>
        <div>
          <dt class="label text-gray mb-2">From studio</dt>
          <dd class="text-[15px] text-ink/85">{location.distance}</dd>
        </div>
        <div>
          <dt class="label text-gray mb-2">Nearby</dt>
          <dd class="text-[14px] text-ink/75">{location.nearby.slice(0, 3).join(', ')}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-4">
          <p class="label text-gray mb-6">What we offer</p>
          <h2 class="headline text-2xl md:text-3xl">
            Services in <em class="text-forest">{location.name}</em>.
          </h2>
          <p class="mt-6 text-[14px] md:text-[15px] text-ink/65 leading-relaxed">
            The full OakFox offer is available to {location.name} clients — often
            combined within a single engagement for a more coherent result.
          </p>
        </div>
        <ul class="md:col-span-7 md:col-start-6 border-t border-stone">
          {services.map((s) => (
            <li class="border-b border-stone">
              <a href={s.href} class="group flex items-baseline justify-between py-4 md:py-5 gap-4">
                <span class="text-[15px] md:text-base font-medium text-ink group-hover:text-forest transition-colors duration-300">
                  {s.label}
                </span>
                <span class="text-[13px] text-ink/40 hidden sm:block">
                  {s.keyword}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-4">
          <p class="label text-gray mb-6">Why here</p>
          <h2 class="headline text-2xl md:text-3xl">
            What we <em class="text-forest">know</em> about {location.name}.
          </h2>
        </div>
        <ul class="md:col-span-7 md:col-start-6 border-t border-stone">
          {location.strengths.map((s) => (
            <li class="reveal border-b border-stone py-5 text-[15px] md:text-base text-ink/75 leading-relaxed">
              {s}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-4">
          <p class="label text-gray mb-6">Sectors</p>
          <h2 class="headline text-2xl md:text-3xl">
            Who we tend to work with in <em class="text-forest">{location.name}</em>.
          </h2>
        </div>
        <ul class="md:col-span-7 md:col-start-6 border-t border-stone">
          {location.sectors.map((s) => (
            <li class="reveal border-b border-stone py-5 text-[15px] md:text-base text-ink/75 leading-relaxed">
              {s}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-4">
          <p class="label text-gray mb-6">Frequently asked</p>
          <h2 class="headline text-2xl md:text-3xl">
            About working with us in <em class="text-forest">{location.name}</em>.
          </h2>
        </div>
        <dl class="md:col-span-7 md:col-start-6 border-t border-stone">
          {faqs.map((f) => (
            <div class="reveal border-b border-stone py-6">
              <dt class="text-base md:text-lg font-medium text-ink mb-3">{f.q}</dt>
              <dd class="text-[14px] md:text-[15px] text-ink/65 leading-relaxed">{f.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-40 border-t border-stone relative overflow-hidden">
    <div class="hero-glow" style="top: 50%;"></div>
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 relative z-10">
      <div class="reveal max-w-2xl">
        <p class="label text-gray mb-6">Next step</p>
        <h2 class="headline text-3xl md:text-4xl lg:text-5xl">
          Start a project in <em class="text-forest">{location.name}</em>.
        </h2>
        <p class="mt-6 text-[15px] text-ink/60 leading-relaxed max-w-lg">
          Send a few lines about your business and what you are trying to do.
          We reply within 24 hours — no pitch deck, no obligation.
        </p>
        <a href="/contact" class="inline-flex items-center gap-3 mt-10 text-[13px] font-medium text-forest group">
          Start a conversation
          <span class="w-10 h-10 rounded-full border border-forest/30 flex items-center justify-center transition-all duration-500 group-hover:bg-forest group-hover:text-cream">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

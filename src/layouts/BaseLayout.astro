---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noIndex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Sustainable design, development, marketing and consultancy — West Lancashire, UK.',
  image,
  type = 'website',
  noIndex = false,
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Resolve a dynamic OG image based on the current path. Falls back to the
// static default if the page is not one we generate an OG image for.
const normalisedPath = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const ogSlug = normalisedPath === '' ? 'home' : normalisedPath;
const ogImagePath = image ?? `/og/${ogSlug}.png`;
const imageURL = new URL(ogImagePath, Astro.site).toString();

const fullTitle = `${title} | OakFox`;

const postalAddress = {
  '@type': 'PostalAddress',
  streetAddress: 'Martland Mill, Mart Ln',
  addressLocality: 'Burscough',
  addressRegion: 'Lancashire',
  postalCode: 'L40 0SD',
  addressCountry: 'GB',
};

const organization = {
  '@type': 'Organization',
  '@id': 'https://oakfox.co.uk/#organization',
  name: 'OakFox',
  legalName: 'OakFox Limited',
  url: 'https://oakfox.co.uk',
  logo: 'https://oakfox.co.uk/images/site/logo.png',
  image: 'https://oakfox.co.uk/images/site/logo.png',
  description: 'Sustainable design, development, marketing and consultancy studio based in West Lancashire, UK.',
  foundingDate: '2025',
  telephone: '+44 7730 396404',
  founder: {
    '@type': 'Person',
    '@id': 'https://oakfox.co.uk/about#nathan',
    name: 'Nathan James Entwistle',
    jobTitle: 'Founder & Designer',
    worksFor: { '@id': 'https://oakfox.co.uk/#organization' },
  },
  address: postalAddress,
  areaServed: ['United Kingdom', 'Ireland', 'Europe'],
  knowsAbout: [
    'Sustainable brand identity',
    'Web design and development',
    'Marketing strategy',
    'Environmental consultancy',
    'Supply chain sustainability',
  ],
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'UK Companies House',
    value: '17118912',
  },
  sameAs: [
    'https://find-and-update.company-information.service.gov.uk/company/17118912',
    'https://www.instagram.com/oak.fox/',
    'https://share.google/3ktdz3XLvsqlNCqeE',
  ],
};

const localBusiness = {
  '@type': 'LocalBusiness',
  '@id': 'https://oakfox.co.uk/#localbusiness',
  name: 'OakFox',
  url: 'https://oakfox.co.uk',
  image: 'https://oakfox.co.uk/images/site/logo.png',
  telephone: '+44 7730 396404',
  priceRange: '££',
  address: postalAddress,
  areaServed: 'United Kingdom',
  sameAs: [
    'https://share.google/3ktdz3XLvsqlNCqeE',
    'https://www.instagram.com/oak.fox/',
  ],
};

const website = {
  '@type': 'WebSite',
  '@id': 'https://oakfox.co.uk/#website',
  url: 'https://oakfox.co.uk',
  name: 'OakFox',
  description: 'Sustainable design, development, marketing and consultancy.',
  publisher: { '@id': 'https://oakfox.co.uk/#organization' },
  inLanguage: 'en-GB',
};

const extraSchema = schema
  ? (Array.isArray(schema) ? schema : [schema])
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization, localBusiness, website, ...extraSchema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="OakFox Journal" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=JetBrains+Mono:wght@400;500&family=Work+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="OakFox" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-cream min-h-screen flex flex-col">
    <div class="noise"></div>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    {import.meta.env.PROD && <ConsentBanner />}
    <script>
      // Scroll-aware header
      const header = document.getElementById('site-header');
      if (header) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 50) {
            header.classList.add('scrolled');
          } else {
            header.classList.remove('scrolled');
          }
        });
      }

      // Mobile nav toggle
      const toggle = document.getElementById('mobile-toggle');
      const mobileNav = document.getElementById('mobile-nav');
      const overlay = document.getElementById('mobile-overlay');

      function closeMobileNav() {
        mobileNav?.classList.add('translate-x-full');
        overlay?.classList.add('hidden');
        document.body.style.overflow = '';
      }

      toggle?.addEventListener('click', () => {
        mobileNav?.classList.toggle('translate-x-full');
        overlay?.classList.toggle('hidden');
        document.body.style.overflow = mobileNav?.classList.contains('translate-x-full') ? '' : 'hidden';
      });

      overlay?.addEventListener('click', closeMobileNav);

      // Scroll-triggered reveals
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style>
  :global(#site-header) {
    transition: background-color 300ms ease, border-color 300ms ease;
  }
  :global(#site-header.scrolled) {
    background-color: rgba(245, 240, 232, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  :global(#site-header.scrolled .logo-img) {
    height: 2rem;
  }
</style>

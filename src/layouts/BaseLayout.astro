---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noIndex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Sustainable design, development, marketing and consultancy — West Lancashire, UK.',
  image,
  type = 'website',
  noIndex = false,
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Resolve a dynamic OG image based on the current path. Falls back to the
// static default if the page is not one we generate an OG image for.
const normalisedPath = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const ogSlug = normalisedPath === '' ? 'home' : normalisedPath;
const ogImagePath = image ?? `/og/${ogSlug}.png`;
const imageURL = new URL(ogImagePath, Astro.site).toString();

const fullTitle = `${title} | OakFox`;

const postalAddress = {
  '@type': 'PostalAddress',
  streetAddress: 'Martland Mill, Mart Ln',
  addressLocality: 'Burscough',
  addressRegion: 'Lancashire',
  postalCode: 'L40 0SD',
  addressCountry: 'GB',
};

const organization = {
  '@type': 'Organization',
  '@id': 'https://oakfox.co.uk/#organization',
  name: 'OakFox',
  alternateName: ['Oak Fox', 'Oak and Fox', 'Oak & Fox'],
  legalName: 'OakFox Limited',
  url: 'https://oakfox.co.uk',
  logo: 'https://oakfox.co.uk/images/site/logo.png',
  image: 'https://oakfox.co.uk/images/site/logo.png',
  description: 'Sustainable design, development, marketing and consultancy studio based in West Lancashire, UK.',
  foundingDate: '2025',
  telephone: '+44 7730 396404',
  founder: {
    '@type': 'Person',
    '@id': 'https://oakfox.co.uk/about#nathan',
    name: 'Nathan James Entwistle',
    jobTitle: 'Founder & Designer',
    worksFor: { '@id': 'https://oakfox.co.uk/#organization' },
  },
  address: postalAddress,
  areaServed: ['United Kingdom', 'Ireland', 'Europe'],
  knowsAbout: [
    'Sustainable brand identity',
    'Web design and development',
    'Marketing strategy',
    'Environmental consultancy',
    'Supply chain sustainability',
  ],
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'UK Companies House',
    value: '17118912',
  },
  sameAs: [
    'https://find-and-update.company-information.service.gov.uk/company/17118912',
    'https://www.instagram.com/oak.fox/',
    'https://share.google/3ktdz3XLvsqlNCqeE',
  ],
};

const localBusiness = {
  '@type': 'LocalBusiness',
  '@id': 'https://oakfox.co.uk/#localbusiness',
  name: 'OakFox',
  url: 'https://oakfox.co.uk',
  image: 'https://oakfox.co.uk/images/site/logo.png',
  telephone: '+44 7730 396404',
  priceRange: '££',
  address: postalAddress,
  areaServed: 'United Kingdom',
  sameAs: [
    'https://share.google/3ktdz3XLvsqlNCqeE',
    'https://www.instagram.com/oak.fox/',
  ],
};

const website = {
  '@type': 'WebSite',
  '@id': 'https://oakfox.co.uk/#website',
  url: 'https://oakfox.co.uk',
  name: 'OakFox',
  description: 'Sustainable design, development, marketing and consultancy.',
  publisher: { '@id': 'https://oakfox.co.uk/#organization' },
  inLanguage: 'en-GB',
};

const extraSchema = schema
  ? (Array.isArray(schema) ? schema : [schema])
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization, localBusiness, website, ...extraSchema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light only" />
    <meta name="description" content={description} />
    <ClientRouter />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="OakFox Journal" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=JetBrains+Mono:wght@400;500&family=Work+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="OakFox" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-cream min-h-screen flex flex-col">
    <div class="noise"></div>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    {import.meta.env.PROD && <ConsentBanner />}
    <script>
      import { bootMotion } from '../scripts/motion.ts';
      import { bootTransitions } from '../scripts/transitions.ts';

      // ----- Google Ads: capture gclid + UTM params on landing ------
      (function captureAdParams() {
        const params = new URLSearchParams(window.location.search);
        const keys = ['gclid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
        for (const key of keys) {
          const val = params.get(key);
          if (val) sessionStorage.setItem('oakfox_' + key, val);
        }
      })();

      // ----- Scroll-aware header (window listener stays bound across
      //       soft-nav since the window itself doesn't change) ----------
      const onScroll = () => {
        const header = document.getElementById('site-header');
        if (!header) return;
        if (window.scrollY > 50) header.classList.add('scrolled');
        else header.classList.remove('scrolled');
      };
      window.addEventListener('scroll', onScroll, { passive: true });

      // ----- Per-page bindings: mobile nav + reveal observer.
      //       Re-runs after each soft navigation because the inline
      //       <script> only executes once. ----------------------------
      function bindMobileNav(): void {
        const toggleEl = document.getElementById('mobile-toggle');
        const mobileNav = document.getElementById('mobile-nav');
        const overlayEl = document.getElementById('mobile-overlay');
        if (!toggleEl || !mobileNav) return;
        if (toggleEl.dataset.bound === '1') return;
        toggleEl.dataset.bound = '1';
        if (overlayEl) overlayEl.dataset.bound = '1';

        const closeMobileNav = () => {
          mobileNav.classList.add('translate-x-full');
          overlayEl?.classList.add('hidden');
          document.body.style.overflow = '';
        };
        toggleEl.addEventListener('click', () => {
          mobileNav.classList.toggle('translate-x-full');
          overlayEl?.classList.toggle('hidden');
          document.body.style.overflow = mobileNav.classList.contains('translate-x-full') ? '' : 'hidden';
        });
        overlayEl?.addEventListener('click', closeMobileNav);
      }

      // ----- Fallback reveal observer for non-homepage `.reveal`s ------
      // GSAP scenes drive `.reveal` on the homepage; this is a no-JS-
      // friendly fallback for other pages. Harmless when GSAP runs.
      function bindRevealFallback(): void {
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
        );
        document.querySelectorAll('.reveal:not(.visible)').forEach((el) => obs.observe(el));
      }

      function onPageReady(): void {
        onScroll();
        bindMobileNav();
        bindRevealFallback();
      }

      // Astro fires `astro:page-load` on initial load AND after each
      // soft navigation. Subscribe once — listeners on `document` survive
      // body swaps.
      document.addEventListener('astro:page-load', onPageReady);

      // Also run immediately for the first paint in case the script
      // executes after `astro:page-load` has already fired.
      if (document.readyState !== 'loading') onPageReady();
      else document.addEventListener('DOMContentLoaded', onPageReady, { once: true });

      // ----- GSAP / Lenis / page transitions -----
      bootMotion();
      bootTransitions();
    </script>
  </body>
</html>

<style>
  :global(#site-header) {
    transition: background-color 300ms ease, border-color 300ms ease;
  }
  :global(#site-header.scrolled) {
    background-color: rgba(245, 240, 232, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  :global(#site-header.scrolled .logo-img) {
    height: 2rem;
  }
</style>

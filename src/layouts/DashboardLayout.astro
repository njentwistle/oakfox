---
interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  {
    label: 'Command',
    href: '/dashboard',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>`,
  },
  {
    label: 'Planner',
    href: '/dashboard/planner',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
  },
  {
    label: 'Goals',
    href: '/dashboard/goals',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`,
  },
  {
    label: 'Brand',
    href: '/dashboard/brand',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
  },
  {
    label: 'Focus',
    href: '/dashboard/focus',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>`,
  },
];

function isActive(href: string, current: string): boolean {
  if (href === '/dashboard') return current === '/dashboard' || current === '/dashboard/';
  return current.startsWith(href);
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — OakFox Dashboard</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet" />
  </head>
  <body class="db-root">
    <!-- Sidebar (desktop) -->
    <aside class="db-sidebar">
      <img src="/images/site/logolight.png" alt="OakFox" class="db-sidebar-logo" />

      <!-- Agency switcher -->
      <div class="db-agency-switcher" id="agency-switcher">
        <button class="db-agency-btn active" data-agency="OakFox">OakFox</button>
        <button class="db-agency-btn" data-agency="Pinpoint">Pinpoint</button>
        <button class="db-agency-btn" data-agency="Adtrak">Adtrak</button>
      </div>

      <nav class="db-sidebar-nav">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={['db-sidebar-link', { active: isActive(link.href, currentPath) }]}
          >
            <Fragment set:html={link.icon} />
            {link.label}
          </a>
        ))}
      </nav>
      <div style="border-top: 1px solid var(--db-border); padding-top: 16px; margin-top: 8px;">
        <a href="#" id="logout-btn" class="db-sidebar-link" style="color: var(--db-text-muted); font-size: 12px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Sign out
        </a>
        <p class="db-sidebar-footer" style="margin-top: 12px;">You're building something real.</p>
      </div>
    </aside>

    <!-- Mobile tab bar -->
    <nav class="db-tab-bar">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={['db-tab-link', { active: isActive(link.href, currentPath) }]}
        >
          <Fragment set:html={link.icon} />
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Mobile agency switcher -->
    <div class="db-mobile-agency" id="agency-switcher-mobile">
      <button class="db-agency-btn active" data-agency="OakFox">OakFox</button>
      <button class="db-agency-btn" data-agency="Pinpoint">Pinpoint</button>
      <button class="db-agency-btn" data-agency="Adtrak">Adtrak</button>
    </div>

    <!-- Main content -->
    <main class="db-main">
      <slot />
    </main>

    <!-- Auth gate -->
    <script is:inline>
      (function() {
        var s = sessionStorage.getItem('oakfox_auth');
        if (!s) { window.location.replace('/dashboard/login'); return; }
        try {
          var p = JSON.parse(s);
          if (!p.authed || p.expires < Date.now()) {
            sessionStorage.removeItem('oakfox_auth');
            window.location.replace('/dashboard/login');
          }
        } catch(e) {
          sessionStorage.removeItem('oakfox_auth');
          window.location.replace('/dashboard/login');
        }

        document.addEventListener('DOMContentLoaded', function() {
          // Logout handler
          var btn = document.getElementById('logout-btn');
          if (btn) {
            btn.addEventListener('click', function(e) {
              e.preventDefault();
              sessionStorage.removeItem('oakfox_auth');
              window.location.replace('/dashboard/login');
            });
          }

          // Agency switcher — sync both desktop and mobile
          var activeAgency = localStorage.getItem('oakfox_agency') || 'OakFox';
          var allAgencyBtns = document.querySelectorAll('.db-agency-btn');
          allAgencyBtns.forEach(function(b) {
            if (b.getAttribute('data-agency') === activeAgency) {
              b.classList.add('active');
            } else {
              b.classList.remove('active');
            }
            b.addEventListener('click', function() {
              allAgencyBtns.forEach(function(x) { x.classList.remove('active'); });
              var agency = b.getAttribute('data-agency');
              // Highlight all buttons with this agency (desktop + mobile)
              allAgencyBtns.forEach(function(x) {
                if (x.getAttribute('data-agency') === agency) x.classList.add('active');
              });
              localStorage.setItem('oakfox_agency', agency);
              window.dispatchEvent(new CustomEvent('agencychange', { detail: { agency: agency } }));
            });
          });
        });
      })();
    </script>

    <style is:global>
      @import '../styles/dashboard.css';
    </style>
  </body>
</html>

---
// Site-wide promo band for the free website carbon audit. The form is a
// plain GET to /website-carbon-audit — the tool auto-runs a ?url= audit on
// load, so this works with no JavaScript at all.
interface Props {
  intro?: string;
}

const {
  intro = 'Paste your URL and get an instant environmental grade — page weight, CO₂ per visit, and a verified green hosting check. Free, no signup, done in seconds.',
} = Astro.props;
---

<section class="bg-forest-dark text-cream relative overflow-hidden">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 60% 80% at 80% 50%, rgba(245, 240, 232, 0.08), transparent 70%);"
    aria-hidden="true"
  >
  </div>
  <div class="max-w-[1400px] mx-auto px-6 md:px-10 py-16 md:py-24 relative z-10">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16 items-center">
      <div class="md:col-span-6">
        <p class="label text-cream/55 mb-6">Free tool · Website Carbon Audit</p>
        <h2 class="headline text-2xl md:text-4xl text-cream">
          How green is your website?
        </h2>
        <p class="mt-5 text-[14px] md:text-[15px] text-cream/65 leading-relaxed max-w-lg">
          {intro}
        </p>
      </div>
      <div class="md:col-span-5 md:col-start-8">
        <form action="/website-carbon-audit" method="get" class="flex flex-col sm:flex-row gap-3">
          <label for="audit-cta-url" class="sr-only">Your website address</label>
          <input
            id="audit-cta-url"
            name="url"
            type="text"
            inputmode="url"
            autocomplete="url"
            spellcheck="false"
            placeholder="yourwebsite.co.uk"
            required
            class="flex-1 min-w-0 bg-cream/10 border border-cream/25 rounded-full px-6 py-3.5 text-[15px] text-cream placeholder:text-cream/55 focus:outline-none focus:border-cream/60 transition-colors duration-300"
          />
          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 bg-cream text-forest-dark hover:bg-white transition-colors duration-300 px-7 py-3.5 rounded-full text-[14px] font-medium whitespace-nowrap"
          >
            Get my grade
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </form>
        <p class="mt-4 text-[12px] text-cream/55 leading-relaxed">
          A+ to F grade in seconds · no email required ·
          <a href="/website-carbon-audit" class="underline underline-offset-4 hover:text-cream transition-colors duration-300">how it works</a>
        </p>
      </div>
    </div>
  </div>
</section>

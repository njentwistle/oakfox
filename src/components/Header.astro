---
import Img from './Img.astro';

const navLinks = [
  { label: 'Work', href: '/portfolio' },
  { label: 'Services', href: '/services' },
  { label: 'Studio', href: '/about' },
  { label: 'Journal', href: '/blog' },
];

const currentPath = Astro.url.pathname;
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50">
  <div class="max-w-[1400px] mx-auto px-6 md:px-10 py-5 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5">
      <Img src="/images/site/logo.png" alt="OakFox" loading="eager" class="logo-img h-12 w-auto transition-all duration-500 ease-out" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-10">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-[13px] font-medium tracking-wide transition-colors duration-300 hover:text-forest',
            currentPath === link.href ? 'text-forest' : 'text-ink/70',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href="/book"
      class="hidden md:inline-flex items-center gap-2 text-[13px] font-medium text-ink/70 hover:text-forest transition-colors duration-300"
    >
      Book a call
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>

    <!-- Mobile toggle -->
    <button
      id="mobile-toggle"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="Toggle menu"
    >
      <span class="w-5 h-0.5 bg-ink block"></span>
      <span class="w-5 h-0.5 bg-ink block"></span>
    </button>
  </div>

  <!-- Mobile overlay -->
  <div id="mobile-overlay" class="hidden fixed inset-0 bg-ink/40 z-40"></div>

  <!-- Mobile nav panel -->
  <nav
    id="mobile-nav"
    class="fixed top-0 right-0 h-full w-72 bg-cream z-50 transform translate-x-full transition-transform duration-500"
  >
    <div class="p-8 pt-24 flex flex-col gap-6 h-full">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-2xl font-medium tracking-tight transition-colors duration-300 hover:text-forest',
            currentPath === link.href ? 'text-forest' : 'text-ink',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/contact"
        class="text-2xl font-medium tracking-tight text-ink hover:text-forest transition-colors duration-300"
      >
        Contact
      </a>
      <div class="mt-auto text-[11px] font-mono uppercase tracking-widest text-gray">
        West Lancashire, UK
      </div>
    </div>
  </nav>
</header>

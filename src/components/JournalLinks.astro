---
interface Post {
  href: string;
  title: string;
  note: string;
}

interface Props {
  intro: string;
  posts: Post[];
}

const { intro, posts } = Astro.props;
---

<section class="py-20 md:py-28 border-t border-stone">
  <div class="max-w-[1400px] mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-12 gap-10">
      <div class="md:col-span-4">
        <p class="label text-gray mb-6">From the journal</p>
        <h2 class="headline text-2xl md:text-3xl">
          Read before you <em class="text-forest">brief&nbsp;anyone</em>.
        </h2>
        <p class="mt-6 text-[14px] md:text-[15px] text-ink/65 leading-relaxed">{intro}</p>
      </div>
      <ul class="md:col-span-7 md:col-start-6 border-t border-stone">
        {posts.map((p) => (
          <li class="border-b border-stone">
            <a href={p.href} class="group block py-5 md:py-6">
              <span class="text-[15px] md:text-base font-medium text-ink group-hover:text-forest transition-colors duration-300">
                {p.title}
              </span>
              <span class="block mt-2 text-[13px] md:text-[14px] text-ink/55 leading-relaxed">{p.note}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

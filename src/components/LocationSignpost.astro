---
import { locations } from '../data/locations';

interface Props {
  service: string;
  keyword: string;
}

const { service, keyword } = Astro.props;
---

<section class="py-20 md:py-28 border-t border-stone">
  <div class="max-w-[1400px] mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-12 gap-10">
      <div class="md:col-span-4">
        <p class="label text-gray mb-6">Where we work</p>
        <h2 class="headline text-2xl md:text-3xl">
          {service} across <em class="text-forest">the North West</em>.
        </h2>
        <p class="mt-6 text-[14px] md:text-[15px] text-ink/65 leading-relaxed">
          Our studio is in rural West Lancashire. We serve {keyword} clients
          locally, regionally across the North West, and remotely across the UK,
          Ireland, and Europe.
        </p>
      </div>
      <ul class="md:col-span-7 md:col-start-6 border-t border-stone">
        {locations.map((l) => (
          <li class="border-b border-stone">
            <a href={`/locations/${l.slug}`} class="group flex items-baseline justify-between py-4 md:py-5 gap-4">
              <span class="text-[15px] md:text-base font-medium text-ink group-hover:text-forest transition-colors duration-300">
                {service} in {l.name}
              </span>
              <span class="text-[13px] text-ink/40 hidden sm:block">{l.distance}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

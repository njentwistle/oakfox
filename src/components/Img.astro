---
interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'auto' | 'sync';
  sizes?: string;
}

const {
  src,
  alt,
  class: className,
  width,
  height,
  loading = 'lazy',
  decoding = 'async',
  sizes,
} = Astro.props;

// Swap .png/.jpg/.jpeg → .webp for the modern source. Falls back to original.
const webpSrc = src.replace(/\.(png|jpe?g)(\?.*)?$/i, '.webp$2');
const hasWebp = webpSrc !== src;
---

{hasWebp ? (
  <picture>
    <source srcset={webpSrc} type="image/webp" />
    <img
      src={src}
      alt={alt}
      class={className}
      loading={loading}
      decoding={decoding}
      width={width}
      height={height}
      sizes={sizes}
    />
  </picture>
) : (
  <img
    src={src}
    alt={alt}
    class={className}
    loading={loading}
    decoding={decoding}
    width={width}
    height={height}
    sizes={sizes}
  />
)}

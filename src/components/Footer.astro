---
import NewsletterSignup from './NewsletterSignup.astro';
import Img from './Img.astro';

const navLinks = [
  { label: 'Work', href: '/portfolio' },
  { label: 'Studio', href: '/about' },
  { label: 'Journal', href: '/blog' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Contact', href: '/contact' },
];

const serviceLinks = [
  { label: 'Branding', href: '/services/branding' },
  { label: 'Web Design', href: '/services/web-design' },
  { label: 'Development', href: '/services/development' },
  { label: 'Copywriting', href: '/services/copywriting' },
  { label: 'Marketing', href: '/services/marketing' },
  { label: 'Environmental', href: '/services/environmental' },
];

const locationLinks = [
  { label: 'Ormskirk', href: '/locations/ormskirk' },
  { label: 'Burscough', href: '/locations/burscough' },
  { label: 'Southport', href: '/locations/southport' },
  { label: 'Preston', href: '/locations/preston' },
  { label: 'Manchester', href: '/locations/manchester' },
  { label: 'Lancashire', href: '/locations/lancashire' },
];
---

<footer class="bg-ink text-cream/80">
  <div class="max-w-[1400px] mx-auto px-6 md:px-10 py-16 md:py-20">
    <!-- Logo -->
    <a href="/" class="inline-block mb-12 md:mb-16">
      <Img src="/images/site/logolight.png" alt="OakFox" class="h-14 md:h-20 w-auto" />
    </a>

    <div class="grid md:grid-cols-12 gap-10 md:gap-12 items-start">
      <!-- Tagline + address -->
      <div class="md:col-span-4">
        <p class="text-[13px] text-cream/50 leading-relaxed max-w-xs">
          Sustainable design, development, marketing and consultancy.
          West Lancashire, UK.
        </p>
        <p class="mt-4 text-[12px] text-cream/45 leading-relaxed max-w-xs">
          Home to <a href="https://ecoscribe.co.uk" class="text-cream/70 hover:text-cream underline underline-offset-4 transition-colors">EcoScribe</a> — our automation venture for ecologists and environmental consultancies.
        </p>
        <address class="mt-5 not-italic text-[12px] text-cream/45 leading-relaxed">
          <div>Martland Mill, Mart Ln</div>
          <div>Burscough, Ormskirk L40 0SD</div>
          <a href="tel:+447730396404" class="mt-2 inline-block hover:text-cream transition-colors duration-300">
            07730 396404
          </a>
        </address>

        <div class="mt-8 flex items-center gap-4">
          <a
            href="https://www.thegreenwebfoundation.org/green-web-check/?url=oakfox.co.uk"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Verified green hosting by The Green Web Foundation"
            class="opacity-80 hover:opacity-100 transition-opacity duration-300"
          >
            <img
              src="/images/site/greenweb.png"
              alt="Green Web Foundation — verified green hosting"
              width="200"
              height="95"
              loading="lazy"
              decoding="async"
              class="h-10 w-auto"
            />
          </a>
          <img
            src="/images/site/SME-Committed-Badge-2026.svg"
            alt="SME Climate Hub — Committed 2026"
            loading="lazy"
            decoding="async"
            class="h-10 w-auto"
          />
        </div>
      </div>

      <!-- Services column -->
      <div class="md:col-span-2 md:col-start-5">
        <p class="text-[11px] font-mono uppercase tracking-widest text-cream/40 mb-4">Services</p>
        <nav class="flex flex-col gap-2.5">
          {serviceLinks.map((link) => (
            <a
              href={link.href}
              class="text-[13px] text-cream/55 hover:text-cream transition-colors duration-300"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Locations column -->
      <div class="md:col-span-2">
        <p class="text-[11px] font-mono uppercase tracking-widest text-cream/40 mb-4">
          <a href="/locations" class="hover:text-cream/70 transition-colors">Locations</a>
        </p>
        <nav class="flex flex-col gap-2.5">
          {locationLinks.map((link) => (
            <a
              href={link.href}
              class="text-[13px] text-cream/55 hover:text-cream transition-colors duration-300"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Studio + newsletter -->
      <div class="md:col-span-4 md:col-start-9">
        <p class="text-[11px] font-mono uppercase tracking-widest text-cream/40 mb-4">Studio</p>
        <nav class="flex flex-col gap-2.5 mb-8">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="text-[13px] text-cream/55 hover:text-cream transition-colors duration-300"
            >
              {link.label}
            </a>
          ))}
        </nav>

        <NewsletterSignup variant="footer" />
      </div>
    </div>

    <div class="border-t border-cream/10 mt-14 pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
      <p class="text-[11px] text-cream/30">
        &copy; OakFox {new Date().getFullYear()}
      </p>
      <div class="flex items-center gap-5">
        <button
          type="button"
          id="footer-cookies"
          class="text-[11px] text-cream/30 hover:text-cream/70 transition-colors duration-300"
        >
          Cookies
        </button>
        <p class="text-[11px] text-cream/30">
          A registered company in England
        </p>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById('footer-cookies')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('oakfox:show-consent'));
  });
</script>

---
const navLinks = [
  { label: 'Work', href: '/portfolio' },
  { label: 'Studio', href: '/about' },
  { label: 'Journal', href: '/blog' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="bg-ink text-cream/80">
  <div class="max-w-[1400px] mx-auto px-6 md:px-10 py-16 md:py-20">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16">
      <!-- Brand -->
      <div class="md:col-span-4">
        <a href="/" class="inline-block">
          <img src="/images/site/logolight.png" alt="OakFox" class="h-7 w-auto" />
        </a>
        <p class="mt-5 text-[13px] text-cream/50 leading-relaxed max-w-xs">
          Sustainable design, development, marketing and consultancy.
          West Lancashire, UK.
        </p>
      </div>

      <!-- Nav -->
      <nav class="md:col-span-4 md:col-start-6 flex flex-col gap-3">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-[13px] text-cream/50 hover:text-cream transition-colors duration-300"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Contact -->
      <div class="md:col-span-3 md:col-start-10">
        <p class="label text-cream/40 mb-4">Get in touch</p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 text-[13px] text-cream/60 hover:text-cream transition-colors duration-300"
        >
          Start a project
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="border-t border-cream/10 mt-14 pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
      <p class="text-[11px] text-cream/30">
        &copy; OakFox {new Date().getFullYear()}
      </p>
      <div class="flex items-center gap-5">
        <button
          type="button"
          id="footer-cookies"
          class="text-[11px] text-cream/30 hover:text-cream/70 transition-colors duration-300"
        >
          Cookies
        </button>
        <p class="text-[11px] text-cream/30">
          A registered company in England
        </p>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById('footer-cookies')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('oakfox:show-consent'));
  });
</script>
